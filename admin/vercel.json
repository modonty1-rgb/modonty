{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @modonty/admin build",
  "installCommand": "pnpm install --filter @modonty/admin...",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 1 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./ ../shared ../pnpm-lock.yaml ../package.json"
}
