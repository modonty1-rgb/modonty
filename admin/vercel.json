{
  "buildCommand": "pnpm --filter @modonty/admin build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./ ../shared/ ../.env.shared ../package.json ../pnpm-lock.yaml",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 1 * * *"
    }
  ]
}
