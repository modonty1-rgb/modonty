{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @modonty/admin build",
  "installCommand": "pnpm install --filter @modonty/admin...",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/tasks-reminder",
      "schedule": "0 5 * * 0-4"
    },
    {
      "path": "/api/cron/tasks-report",
      "schedule": "30 5 * * 0-4"
    }
  ],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ./ ../shared ../pnpm-lock.yaml ../package.json",
  "git": {
    "deploymentEnabled": {
      "cloud/**": false,
      "claude/**": false
    }
  }
}
