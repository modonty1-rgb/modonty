// ============================================
// SETTINGS MODEL (Singleton Pattern)
// ============================================

model Settings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Singleton lock — guarantees only ONE Settings doc ever exists.
  // All callers MUST use upsert({where: {singletonKey: "global"}}) — never findFirst+create.
  singletonKey String @unique @default("global")

  // Cascade progress tracking (T1.8 — UI feedback for Save & Publish)
  cascadeStatus      String?   // "running" | "done" | "error" | null = idle
  cascadeProgress    Json?     // { total, completed, phase: "articles"|"clients"|"categories"|"tags"|"industries"|"listings" }
  cascadeStartedAt   DateTime?
  cascadeCompletedAt DateTime?
  cascadeError       String?

  // SEO Title Settings
  seoTitleMin      Int     @default(30)
  seoTitleMax      Int     @default(60)
  seoTitleRestrict Boolean @default(false) // false = allow max (warn), true = restrict (block)

  // SEO Description Settings
  seoDescriptionMin      Int     @default(120)
  seoDescriptionMax      Int     @default(160)
  seoDescriptionRestrict Boolean @default(false) // false = allow max (warn), true = restrict (block)

  // Twitter Title Settings
  twitterTitleMax      Int     @default(70)
  twitterTitleRestrict Boolean @default(true) // true = hard limit (Twitter display limit)

  // Twitter Description Settings
  twitterDescriptionMax      Int     @default(200)
  twitterDescriptionRestrict Boolean @default(true) // true = hard limit (Twitter display limit)

  // OG Title Settings
  ogTitleMax      Int     @default(60)
  ogTitleRestrict Boolean @default(false)

  // OG Description Settings
  ogDescriptionMax      Int     @default(200)
  ogDescriptionRestrict Boolean @default(false)

  // Social Media Links (Platform-wide)
  facebookUrl  String?
  twitterUrl   String?
  linkedInUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  tiktokUrl    String?
  pinterestUrl String?
  snapchatUrl  String?
  whatsappChannelUrl String? // Modonty WhatsApp Channel link
  telegramChannelUrl String? // Modonty Telegram Channel link
  googleBusinessProfileUrl String? // Modonty/JBR Google Business Profile (Maps) URL — feeds Organization sameAs; team pastes it after creating + verifying the profile

  // Content-responsibility disclaimer (admin-edited central text; clients accept it in console)
  disclaimerText    String? @db.String // full acknowledgement text shown to clients
  disclaimerVersion Int     @default(1) // bump when text changes → clients re-prompted

  // Telegram — admin activity feed. When true, ALL client Telegram events are
  // mirrored to TELEGRAM_ADMIN_CHAT_ID (full site-activity firehose for the admin).
  telegramAdminMirrorAll Boolean @default(true)

  // Advertising platforms — one server-only JSON document: { accounts, credentials }.
  // Meta accounts are per brand; TikTok, Snapchat, Google and other providers are shared.
  // Platform credentials are server-only and never selected into the browser.
  adPlatformAccounts Json?

  // Site & Organization (from .env defaults, editable in Settings UI)
  siteUrl             String?
  siteName            String?
  // الاسم الثاني للماركة على الكيان نفسه — schema.org `alternateName`، وجوجل تسمّيه
  // "another common name that your organization goes by" وتوصي باستعماله على `Organization`
  // و`WebSite` معاً. سببه المقيس (٢٨ أغسطس ٢٠٢٦): الاسم العربي هو ما يراه الزائر ٢٣ مرّة
  // على الرئيسية، واللاتيني هو ما يكتبه من يبحث بالإنجليزية — وبعمود واحد كان لا بدّ من
  // خسارة أحدهما. الاسم الأساسي يبقى `siteName`، وهذا يجاوره ولا ينافسه.
  alternateName       String?
  brandDescription    String?
  siteAuthor          String?
  inLanguage            String?  // Default language code (e.g., "ar", "en") for hreflang
  defaultMetaRobots     String?  // Default meta robots (e.g. "index, follow")
  defaultGooglebot      String?  // Default meta googlebot (e.g. "index, follow")
  defaultOgType         String?  // Default og:type (e.g. "website")
  defaultOgLocale       String?  // Default og:locale (e.g. "ar_SA")
  defaultOgDeterminer   String?  // Default og:determiner (e.g. "auto")
  defaultTwitterCard    String?  // Default twitter:card (e.g. "summary_large_image")
  defaultSitemapPriority Float?  // Default sitemap priority (0.5)
  defaultSitemapChangeFreq String? // Default sitemap changefreq (e.g. "monthly")
  articleDefaultSitemapChangeFreq String? // Default sitemap changefreq for articles (e.g. "weekly")
  articleDefaultSitemapPriority  Float?  // Default sitemap priority for articles (e.g. 0.5)
  defaultLicense                 String? // Default license URL for articles (e.g. CC-BY)
  // Image licensing defaults (schema.org ImageObject → Google Licensable badge).
  // Used for Modonty-PRODUCED images (HERO/POST/OGIMAGE/TWITTER_IMAGE/CLIENT_MINI/GENERAL);
  // LOGO/GALLERY are attributed to the owning client at generation time instead.
  imageOwnerName             String? // creator/creditText/copyrightHolder name (e.g. "مدوّنتي")
  imageLicenseUrl            String? // URL to a page describing the licence (e.g. "/legal/copyright-policy")
  imageAcquireLicensePageUrl String? // URL where users can acquire a licence / contact
  defaultIsAccessibleForFree     Boolean  @default(true) // Default for articles: free to access (structured data)
  defaultAlternateLanguages     Json?    // Default for articles: array of {hreflang, url} for hreflang
  defaultContentFormat         String?  // Default for articles: "markdown" | "html" | "rich_text"
  defaultCharset         String?  // Meta charset (e.g. "UTF-8")
  defaultOgImageType     String?  // og:image type (e.g. "image/jpeg")
  defaultOgImageWidth    Int?     // og:image width (e.g. 1200)
  defaultOgImageHeight   Int?     // og:image height (e.g. 630)
  defaultHreflang        String?  // hreflang default (e.g. "x-default")
  defaultPathname        String?  // URL pathname fallback (e.g. "/")
  defaultTruncationSuffix String? // Suffix when truncating title/description (e.g. "...")
  defaultReferrerPolicy  String?  // Referrer policy (e.g. "strict-origin-when-cross-origin")
  defaultNotranslate     Boolean? // Prevent Chrome translate prompt for Arabic
  twitterSite            String?
  twitterCreator      String?
  twitterSiteId       String?
  twitterCreatorId    String?
  orgContactType             String?
  orgContactEmail            String?
  orgContactTelephone        String?
  orgContactAvailableLanguage String?  // ContactPoint.availableLanguage (e.g. "ar"); falls back to inLanguage
  orgContactOption           String?   // ContactPoint.contactOption (e.g. toll-free)
  orgContactHoursAvailable   String?   // ContactPoint.hoursAvailable (e.g. "Mo-Fr 09:00-17:00")
  orgAreaServed              String?
  orgStreetAddress    String?
  orgAddressLocality  String?
  orgAddressRegion    String?
  orgAddressCountry   String?
  orgAddressNeighborhood String? // الحيّ — جزء من العنوان الوطني، يظهر في /trust مع الشارع
  orgPostalCode       String?
  orgGeoLatitude      Float?
  orgGeoLongitude     Float?
  orgSearchUrlTemplate String?

  // السجل التجاري لمدونتي نفسها — تُدخَل من الأدمن وتُعرض في /trust و/story و JSON-LD.
  // مكانها هنا لأن Settings تخصّ المشروع؛ جدول Client للعملاء.
  orgLegalName                    String? // الاسم القانوني كما في الشهادة
  orgCommercialRegistrationNumber String? // رقم السجل التجاري
  orgCommercialRegistrationStatus String? // حالة السجل كما تقولها وزارة التجارة («نشط»…)
  orgUnifiedNationalNumber        String? // الرقم الوطني الموحّد للمنشأة (سلسلة 700)
  /// الرقم الضريبي (١٥ خانة) من شهادة هيئة الزكاة والضريبة والجمارك. تُطبع على الفاتورة
  /// الضريبية وتُعرض في /trust. رقمٌ نظاميّ لا يُكتب في كود: خانةٌ خاطئة تُبطل كل فاتورة صادرة.
  orgVatNumber                    String?
  orgLegalForm                    String? // نوع الكيان (ذات مسؤولية محدودة، مساهمة…)
  orgCapitalAmount                String? // رأس المال كما هو مقيّد. نصّ لا رقم: يُعرض كما هو ولا يدخل في حساب
  orgFoundingDate                 DateTime? // تاريخ القيد في السجل

  // Media Settings (Cloudinary URLs)
  logoUrl     String? // Wide wordmark logo — desktop navbar
  logoIconUrl String? // Small icon/mark logo — mobile navbar (falls back to logoUrl if empty)
  ogImageUrl  String?
  altImage    String?  // Default alt text for logo/OG image when none set
  certificateImageUrl String? // CR certificate shown on /trust — picked from the Modonty library; static /public file stays as fallback

  // Modonty app defaults (fallback when page has no SEO title/description)
  modontySeoTitle       String?
  modontySeoDescription  String?

  // List pages defaults (fallback when generating meta/JSON-LD)
  clientsSeoTitle       String?
  clientsSeoDescription String?
  categoriesSeoTitle    String?
  categoriesSeoDescription String?
  trendingSeoTitle      String?
  trendingSeoDescription  String?
  tagsSeoTitle          String?
  tagsSeoDescription    String?
  industriesSeoTitle    String?
  industriesSeoDescription String?
  // Article archive (/articles) — a master page like its sisters: its own editable SEO copy.
  articlesSeoTitle      String?
  articlesSeoDescription String?

  // Cached site-level JSON-LD (optional; same pattern as Client/Modonty)
  jsonLdStructuredData   String?   @db.String // Cached @graph JSON string
  jsonLdLastGenerated   DateTime?
  jsonLdValidationReport Json?     // { adobe, custom, richResults }

