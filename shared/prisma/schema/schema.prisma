model SystemError {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  digest     String?
  path       String
  method     String
  routePath  String
  routeType  String
  source     String
  // Tracing enrichment (Khalid 2026-07-22) — turns the log from noise into triage.
  category   String?  // "framework" (Next/React internals, not our bug) | "app" (ours)
  renderType String?  // Next context.renderType: "dynamic" | "dynamic-resume" (PPR resume)
  device     String?  // "mobile" | "tablet" | "desktop" | "bot"
  botName    String?  // e.g. "Googlebot" when the UA is a known crawler
  country    String?  // Vercel geo (x-vercel-ip-country)
  city       String?  // Vercel geo (x-vercel-ip-city)
  userAgent  String?  // raw UA — the ground truth for tracing
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@map("system_errors")
}

/// Who did what, and when — the answer to "مين عمل ده؟" (Khalid 2026-07-14: more than
/// one person now works in the admin, and until today every action was anonymous).
///
/// Written by `logAction()` after an action SUCCEEDS. Append-only: rows are never edited.
///
/// Identity is stored twice on purpose:
///   · userId    — the real key. Never changes, survives a rename, and is what you filter by.
///   · userEmail — a SNAPSHOT of who they were at that moment. It answers "who?" without a
///                 second query, and it still answers it after the person leaves and their
///                 account is deleted. A log that outlives its subject is the whole point.
///
/// A password is NEVER stored here. It is bcrypt-hashed (we cannot read it), logging it
/// would hand every account to anyone who opens this table, and it says nothing about who
/// acted — userId already does. That is not a preference; it is the rule.
model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Who — both, for the reasons above.
  userId    String  @db.ObjectId
  userEmail String
  userName  String? // Snapshot too — nice to read, but email is the one that must be there.
  userRole  String? // ADMIN · EDITOR — their role AT THE TIME, not today's.

  // What — a stable dotted key: "article.publish" · "client.delete" · "settings.update".
  action String

  // On what — entity is always set; entityId is null for global actions (settings, cascade).
  entity   String // Article · Client · Category · Tag · Settings · Database …
  entityId String? @db.ObjectId

  /// Human-readable line for the log screen: "نشر: أفضل واكس شعر للرجال".
  /// A snapshot as well — the title at the time, so a later rename cannot rewrite history.
  summary String?

  /// Anything worth keeping that has no column: { from: "DRAFT", to: "PUBLISHED" }.
  /// Never put personal data or secrets in here.
  metadata Json?

  createdAt DateTime @default(now())

  // The three ways this table gets read: newest-first, per person, per entity.
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
  @@map("audit_logs")
}

// Cache table for Google Search Console URL Inspection results.
// Avoids hitting the 2,000/day API quota — refresh on demand or every 7 days.
model GscUrlInspection {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  url             String   @unique
  verdict         String? // PASS · FAIL · NEUTRAL · PARTIAL
  coverageState   String? // e.g. "Submitted and indexed"
  robotsTxtState  String? // ALLOWED · DISALLOWED
  indexingState   String? // INDEXING_ALLOWED · BLOCKED_BY_META_TAG · etc.
  pageFetchState  String? // SUCCESSFUL · SOFT_404 · BLOCKED_ROBOTS_TXT · etc.
  userCanonical   String? // canonical declared by us
  googleCanonical String? // canonical chosen by Google
  mobileVerdict   String? // PASS · FAIL · NEUTRAL
  mobileIssues    String[] // list of issue types
  lastCrawlTime   DateTime?
  crawledAs       String? // DESKTOP · MOBILE
  sitemap         String[] // sitemap URLs that include this URL
  rawJson         Json?
  inspectedAt     DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
  @@index([verdict])
  @@map("gsc_url_inspections")
}

/// Tracks manual GSC requests (Removal tool + URL Inspection "Request Indexing").
/// Two-step state:
/// `openedAt` = user clicked the deep-link button (intent only — Google may not have received it).
/// `doneAt`   = user explicitly clicked "Mark done" after submitting in GSC (confirmed action).
/// One row per (url, type) — same URL can have both REMOVAL and INDEXING requests at different times.
model GscManualRequest {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  url            String
  type           String    @default("REMOVAL") // "REMOVAL" | "INDEXING"
  openedAt       DateTime  @default(now())
  openedByUserId String?
  doneAt         DateTime?
  doneByUserId   String?

  @@unique([url, type])
  @@index([type, doneAt])
  @@map("gsc_removal_requests")
}

// ============================================
// BILLING — Invoices issued from the Accounts page
// ============================================
model Invoice {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  number            String           @unique // human invoice number e.g. MOD-2026-00042
  clientId          String           @db.ObjectId
  // Restrict, never Cascade (2026-09-16): this used to delete a client's invoices along with
  // the client — the accounting ledger vanishing on one button press. The client is ARCHIVED
  // now, never deleted (Client.archivedAt), so nothing should cascade here at all; the
  // constraint stays as a floor under that decision. Same rule the invoice already applies to
  // itself: «Voiding an invoice, never deleting it — the ledger has to stay whole».
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// لقطة هويّة المشتري وقت الإصدار — كما يفعل `CheckoutOrder` بالضبط، ولنفس السبب.
  ///
  /// الفاتورة اليوم تحمل **رقم العميل فقط**، فلو انفصلت عن كرته صارت ورقةً فيها مبلغ بلا
  /// صاحب، والمراجع يسأل «من هذا العميل؟» فلا جواب. وهو **شرط قرار الأرشفة** نصّاً
  /// (MONEY-FLOW القسم ٨): «شرطه الوحيد: الفاتورة تحفظ هويّة صاحبها كما يفعل الطلب».
  ///
  /// لقطةٌ لا قراءة: اسم العميل يُصحَّح وعنوانه يتغيّر ورقمه الضريبيّ يُستكمل — والفاتورة
  /// مستندٌ يجب أن يقول من صدرت له **يومها**، لا من صار اليوم. نفس سبب تجميد السعر.
  ///
  /// اختياريّة: كل فاتورةٍ صدرت قبل هذا الحقل تبقى صحيحة، وتُقرأ هويّتها من الكرت كما كانت.
  buyerName         String?
  buyerEmail        String?
  buyerLegalName    String?
  buyerVatID        String?
  /// سقط `tier` (١٧ سبتمبر ٢٠٢٦): كان يُكتب في ثلاثة مواضع ويُقرأ في **صفر**.
  /// كفّت المواضعُ الثلاثة عن كتابته أوّلاً، ثمّ سقط. و`tierName` تحته هي المصدر —
  /// لقطةُ اسمٍ مجمَّدةٌ لحظةَ الإصدار، لا تتغيّر لو تغيّر الكتالوج بعدها.
  tierName          String // display-name snapshot at issue time (e.g. "الزخم") — هذه هي المصدر
  period            String // "monthly" | "annual"
  currency          String // "SAR" | "EGP"
  amount            Float
  paymentMethod     String? // deprecated — kept for old rows; not captured on new invoices
  paymentStatus     String // "PAID" | "DUE"
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  issuedAt          DateTime         @default(now())
  issuedByUserId    String?          @db.ObjectId
  emailSentAt       DateTime?
  paidAt            DateTime? // settlement date entered by admin at «تحديد مدفوعة»
  paidByUserId      String?          @db.ObjectId
  // Voiding an invoice, never deleting it — the ledger has to stay whole for accounting.
  // Only an UNPAID invoice can be archived; it then leaves every unpaid total, stops
  // blocking the next issuance, and its period stops counting toward the client's end date.
  archivedAt        DateTime?
  archivedReason    String?
  archivedByUserId  String?          @db.ObjectId
  // Marks the invoice that embodies the client's opening balance (see Client.openingBalance).
  // The founding payment is already counted in the sales report as the opening balance, so
  // an invoice generated from it MUST be excluded from report revenue — it is a document,
  // not new money. Default false = a normal renewal invoice that DOES count.
  fromOpeningBalance Boolean         @default(false)
  // ── Tax-invoice detail (PAY-Q14). Optional so every invoice issued before the checkout
  // flow stays valid; an invoice born from a CheckoutOrder fills all of them from the
  // order's snapshot — never from today's catalog price. Minor units, Int.
  orderId            String?          @db.ObjectId
  subtotalMinor      Int?
  vatRateBp          Int? // 1500 = 15%
  vatMinor           Int?
  totalMinor         Int?
  paidMonths         Int?
  bonusServiceMonths Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clientId, issuedAt])
  @@index([orderId])
  @@map("invoices")
}

/// Atomic sequential counters (e.g. gapless invoice numbering per year).
model Counter {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique // e.g. "invoice-2026"
  value Int    @default(0)

  @@map("counters")
}

// ============================================
// INTAKE ENGINE — admin-managed questionnaire
// Questions/options live in DB (admin-editable); client answers stay in
// Client.intake JSON keyed by IntakeQuestion.key, so downstream consumers
// (pre-publish audit, JSON-LD, admin brief) keep reading the same shape.
// ============================================

enum IntakeQuestionType {
  SELECT // single choice, dropdown
  RADIO // single choice, visible list
  MULTI_PILL // multi-select chips
  CHECKBOX // multi-select checkboxes
  TEXT // single-line text
  TEXTAREA // multi-line text
  BOOLEAN // single toggle
  REPEATED_GROUP // repeats a set of sub-fields (e.g. competitors) — shape in `config`
  GROUP // fixed nested sub-fields (e.g. YMYL reviewer) — shape in `config`
}

/// A questionnaire definition. One row today ("intake"); the parent table lets
/// new forms (onboarding, review) be added later with zero schema change.
model IntakeForm {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  key         String          @unique // "intake"
  title       String
  description String?
  version     Int             @default(1)
  enabled     Boolean         @default(true)
  sections    IntakeSection[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("intake_forms")
}

/// A group of questions inside a form (e.g. "نبرة الكتابة", "سياسة المحتوى").
model IntakeSection {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  formId      String           @db.ObjectId
  form        IntakeForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  key         String // stable section key: "voice", "policy", ...
  title       String
  description String?
  icon        String? // lucide icon name (e.g. "Mic2")
  order       Int              @default(0)
  enabled     Boolean          @default(true)
  visibility  Json? // conditional display, e.g. { ymylOnly: true } or { market: ["SA"] }
  questions   IntakeQuestion[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([formId, key])
  @@map("intake_sections")
}

/// A single question. `key` is the STABLE semantic path the answer is stored
/// under in Client.intake (e.g. "policy.forbiddenKeywords") — never changes on
/// edit, so downstream code never breaks. Editing label/options is always safe.
model IntakeQuestion {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  sectionId   String             @db.ObjectId
  section     IntakeSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key         String // stable answer path, e.g. "policy.forbiddenKeywords"
  label       String
  helpText    String?
  placeholder String?
  type        IntakeQuestionType
  required    Boolean            @default(false)
  maxLength   Int?
  order       Int                @default(0)
  enabled     Boolean            @default(true)
  visibility  Json? // per-question conditional + market scope
  config      Json? // type-specific shape (e.g. REPEATED_GROUP/GROUP sub-fields)
  options     IntakeOption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([sectionId, key])
  @@map("intake_questions")
}

/// A predefined choice for SELECT/RADIO/MULTI_PILL/CHECKBOX questions.
model IntakeOption {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  questionId  String         @db.ObjectId
  question    IntakeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value       String // stored value
  label       String // shown label
  order       Int            @default(0)
  enabled     Boolean        @default(true)
  marketScope String? // "SA" | "EG" | null (all markets)

  @@map("intake_options")
}

// ============================================
// REFERENCE DATA — admin-managed foundational lookups
// (Settings → Reference Data). Countries drive the client country picker;
// licensing authorities power YMYL verification. Read by console + SEO,
// written by admin. Replaces the hardcoded matrix in ymyl-config.ts.
// ============================================

/// Fixed YMYL category set. Mirrors Client.ymylCategory string values
/// ("medical" | "legal" | "financial"). Kept an enum here to enforce a valid
/// category on every authority row.
enum YmylCategory {
  medical
  legal
  financial
}

/// A supported country. `code` (ISO 3166-1 alpha-2) is the value stored on
/// Client.addressCountry and used to resolve licensing authorities.
model Country {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  code      String  @unique // ISO 3166-1 alpha-2: SA, EG, AE
  nameAr    String
  nameEn    String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

// ============================================
// REFERRAL — إحالة عميل لعميل
// ============================================

/// حالة الإحالة. المسار في اتجاه واحد: كل حالة تُغلق ما قبلها ولا ترجع.
/// `REJECTED` و`LOST` نهايتان مختلفتان: الأولى رفضٌ من المُرشَّح، والثانية انقطاعٌ
/// بلا رفض صريح — والتمييز بينهما هو ما يجعل تقرير الإحالات صادقاً.
enum ReferralLeadStatus {
  NEW
  CONTACTED
  SUBSCRIBED
  PAID
  REWARDED
  REJECTED
  LOST
}

/// إحالة يرفعها عميل قائم لمُرشَّح جديد.
///
/// نموذج مستقلّ عمداً، لا `ContactMessage` ولا `LeadScoring`: الأول رسالة زائر مجهول
/// بلا مُحيل ولا مسار، والثاني تسجيلُ نقاطٍ على عميل قائم. هذا صفٌّ له مُحيلٌ معلوم
/// ومسارُ حالاتٍ ينتهي بمكافأة مالية — فخلطه بأيٍّ منهما يجعل الاستعلام يكذب.
///
/// **لا افتراض سعودية في أي حقل.** المفتاح الدولي يكتبه المُحيل داخل الرقم نفسه بصيغة
/// `(+20) 100 123 4567`، والخادم يطبّعه إلى E.164. لا يعتمد هذا النموذج على
/// `Client.addressCountry` لأنه حقل غير نظيف (مقيس ٢٩ أغسطس على modonty_dev).
model ReferralLead {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// العميل صاحب الإحالة — مالك المكافأة.
  referrerClientId String @db.ObjectId
  referrerClient   Client @relation("ClientReferralLeads", fields: [referrerClientId], references: [id], onDelete: Cascade)

  /// اسم المُرشَّح كما كتبه المُحيل. اختياري: الرقم وحده يكفي للتواصل.
  candidateName String?

  /// ملاحظة يكتبها المُحيل عن العميل المرشّح لتظهر لفريق المتابعة.
  /// اختيارية؛ الغياب يبقى غياباً ولا تملؤه الواجهة بقيمة بديلة.
  candidateNote String?

  /// يكتب العميل الرقم في الحقل النصّي الواحد بصيغة `(+20) 100 123 4567`؛ الخادم
  /// يتحقق منه ثم يخزّنه دائماً بصيغة E.164 (`+201001234567`). لا نكرر بلد الرقم
  /// في حقل ثانٍ لأن المفتاح الدولي جزء من الرقم نفسه.
  /// `@unique` على الزوج أدناه يمنع إحالتين لنفس الرقم من نفس المُحيل، ويُبقي
  /// إحالة نفس الرقم من مُحيل آخر مسموحة (يقرّرها الأدمن).
  phoneE164 String

  /// لحظة تأكيد المُحيل أنّ المُرشَّح وافق على التواصل. إلزامية — بلا هذا الوقت لا يُنشأ
  /// الصفّ إطلاقاً، فالموافقة ليست خانةً في نموذج بل شرطُ وجودٍ للسجلّ.
  consentConfirmedAt DateTime

  status ReferralLeadStatus @default(NEW)

  /// السجلّ الزمني — كلٌّ منها يُكتب مرّة واحدة عند دخول حالته، ويبقى بعدها.
  contactedAt   DateTime?
  subscribedAt  DateTime?
  paidAt        DateTime?
  rewardedAt    DateTime?

  /// الفاتورة التي أثبتت السداد. هي مصدر `paidAt` ومفتاح عدم التكرار: منح المكافأة
  /// يشترط `rewardedAt == null`، فلا تُمنح مرّتين مهما أُعيد تشغيل العملية.
  paidInvoiceId String? @db.ObjectId

  /// العميل الذي صار منه المُرشَّح بعد الاشتراك — يُملأ عند `SUBSCRIBED`.
  convertedClientId String? @db.ObjectId

  /// سبب الرفض أو الانقطاع، بخطّ الأدمن. يُعرض في السجلّ الزمني كما هو.
  closingNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([referrerClientId, phoneE164])
  @@index([status, createdAt])
  @@index([referrerClientId, createdAt])
  @@map("referral_leads")
}

/// Where the sales team keeps a prospect BEFORE they become a client.
///
/// Brought over from the standalone `jbrseo_sales` database (Khalid, 2026-09-04): «أبغى بس
/// الجدول اللي فيه الـdata بتاعة العملاء اللي هي مسجلة، لأنه هنبتدي نعمل شغل تاني عليها».
/// Only the client sheet came across — reps, team leaders, targets, commission rates and
/// frozen statements were deliberately left behind to be redesigned from scratch.
///
/// WHY NOT just add rows to `clients`. A prospect cannot satisfy what that model requires:
/// `slug @unique`, `email`, and `subscriptionTier` are all mandatory there, and 6 of the 17
/// rows measured in production carry no email at all. Widening those four fields would
/// weaken the model every public page on modonty.com reads. The lead lives here until it
/// is approved, and `convertedClientId` keeps the two halves of its journey joined.
///
/// The one real gain of sharing modonty's database: `industryId` is a REAL relation here.
/// In the old sales app it was `industrySlug` + `industryName` — a text snapshot copied at
/// pick time, which silently went stale whenever an industry was renamed.
model SalesLead {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name    String
  company String?
  // NOT unique, unlike `Client.phone`. The same person may be entered twice before anyone
  // sorts the list — a duplicate is a thing to merge later, not a write to reject now.
  phone   String?
  // Optional, unlike `Client.email`. Measured on production 2026-09-04: 11 of 17 rows have
  // one. Requiring it here would make six real prospects unrecordable.
  email   String?

  contactName String?
  contactRole String?

  city           String?
  website        String?
  googleLocation String?

  industryId String?   @db.ObjectId
  industry   Industry? @relation(fields: [industryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// What the rep typed when none of the eight industries fitted.
  ///
  /// The point is not this lead — it is the list. A rep who cannot classify someone picks the
  /// nearest wrong row and the mistake is never visible; here she writes it instead, and the
  /// answers accumulate into the evidence for which industries we are actually missing.
  /// Measured before adding it: `industryId` was set on 1 of 20 leads, with 8 options offered.
  industryOther String?

  /// ISO alpha-2, matching `Country.code` — "SA" | "EG". A code rather than a relation:
  /// the countries table is a three-row lookup, and a lead entered for a market we have not
  /// created a row for yet should still save.
  countryCode String?

  /// The lead's origin, stored as the `value` of a `LeadSourceOption` row — NOT an enum.
  ///
  /// It was `LeadSource?`, a six-value enum, so adding one option meant a schema edit, a
  /// client regenerate and a deploy. Khalid owns this list, not the code: he adds to it from
  /// Dropdown Lists (`/settings/reference-data`).
  ///
  /// A plain string, not a relation: Mongo already stored the enum AS a string (measured —
  /// 17 × "SOCIAL", 1 × "REFERRAL", 2 absent), so this change touches no document. And a
  /// lead whose source row is later deleted keeps its own history rather than turning into
  /// an orphan that drops the whole query.
  source String?

  /// Paid ad, or did the same channel reach us on its own?
  ///
  /// A separate flag rather than paid/organic variants of every channel: doubling the list
  /// («انستقرام إعلان» + «انستقرام عادي») is where a picker starts getting mis-filled. This is
  /// `utm_medium` — an axis that crosses every source rather than sitting inside one.
  isPaidAd Boolean @default(false)

  /// Which campaign brought them — `utm_campaign`, meaningful only when `isPaidAd`.
  ///
  /// DEPRECATED — نصُّ اسم الحملة، حلّت محلّه العلاقة `campaignId` أدناه.
  ///
  /// يبقى مخزَّناً ولا يُحذف: هو السجلّ الوحيد لحملاتٍ سبقت الجدول، وحذفُ العمود يمحو من أين
  /// جاء هؤلاء العملاء. يُقرأ حين لا يوجد `campaignId`، ولا يُكتب من الشاشة بعد اليوم.
  campaign String?

  /// الحملة التي جاء منها — صفٌّ حقيقيّ لا نصّ.
  ///
  /// الفرق ليس شكلياً: النصّ الحرّ لا يُجمَّع («رمضان-٢٠٢٦» و«رمضان ٢٠٢٦» صفّان)، ولا يحمل
  /// كلفةً فيُقاس بها عائد. والعلاقة تجعل «هذه الحملة صرفت كذا وجابت كذا وأقفلت كذا» سؤالاً
  /// له جواب.
  ///
  /// اختياريّ لأن أكثر العملاء لا يجيئون من إعلان، و`NoAction` لأن مونجو بلا تعاقبٍ حقيقيّ.
  campaignId String?     @db.ObjectId
  adCampaign AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// The organic counterpart of `campaign`: how they found us when no ad was paid for.
  ///
  /// Its own column rather than sharing `campaign`: a column whose meaning flips based on a
  /// neighbouring flag reads fine today and is misread the first time someone queries it
  /// without the flag. `campaign` is grouped and counted; this is prose nobody groups.
  sourceNote String?

  /// DEPRECATED — superseded by `stage`. Kept mapped ONLY until every row is backfilled and
  /// verified; the delete pass then drops it from this file. Removing it from the schema does
  /// NOT drop the field from the documents (Prisma just stops mapping it, exactly as with the
  /// `social_posts` note below), so the old value stays recoverable if the backfill was wrong.
  status SalesLeadStatus @default(PROSPECT)

  /// Where this lead sits in the pipeline. Six stages, not the three of `status`: the missing
  /// three are the ones a rep actually acts on — an offer sent and unanswered is a different
  /// job from a negotiation, and both were "ACTIVE" before.
  ///
  /// `WON` is written by the conversion, `LOST` by the dialog that asks why. Neither is
  /// pickable from the form (see `PICKABLE_STAGES`), so the funnel cannot be skipped by hand.
  stage SalesStage @default(NEW)

  /// Why we lost them. The single most useful column in a sales table and the one nobody adds
  /// until a year in — without it "we lost 40 deals" is a number, with it it is a decision.
  lostReason SalesLostReason?
  lostNote   String?
  lostAt     DateTime?

  /// The deal. The old form asked WHO the lead was and never WHAT the deal was, so the list
  /// could not be sorted by anything that matters.
  ///
  /// **سلَقُ الباقة، لا قيمةٌ من إنم (١٧ سبتمبر ٢٠٢٦).**
  ///
  /// كان `SubscriptionTier`، والحجّةُ أنّ الفئة المطلوبة هي إحدى الفئات الحقيقيّة فلا
  /// داعيَ لقائمةٍ ثانية. لكنّ الإنم أربعُ قيمٍ ثابتة، فباقةٌ جديدة في `modonty_plans`
  /// لا يمكن أن تُختار هنا أصلاً — والقائمةُ في الكود كانت تُرفض صامتةً ما ليس فيها.
  ///
  /// صار يخزّن `ModontyPlan.slug` — وهو ما تعرضه الشاشةُ فعلاً. والتحويل بلا ترحيل:
  /// قيس على نسخة الإنتاج فوُجد **٠ من ٢٦** محتمَلاً يحمل قيمة.
  expectedTier    String?
  /// السعر الشهري الأساسي للباقة في سوق العميل — منه يُشتقّ كل شيء.
  expectedMonthly Float?
  /// مدّة الصفقة بالشهور المدفوعة: ٣ · ٦ · ١٢.
  ///
  /// الباقات لا تُباع شهريّاً («no monthly billing» — قرار ٣ أغسطس، مثبَّت في
  /// `pricing-durations.ts`)، فصفقةٌ بلا مدّة رقمٌ لا معنى له. والحافز شهورُ خدمةٍ مجانية لا
  /// خصمٌ في السعر، فلا يُخزَّن إجماليٌّ ولا نسبةُ خصم — كلاهما يُحسب من هذين الحقلين وحدهما،
  /// وتخزينهما يخلق رقماً ثانياً يتناقض مع الأوّل عند أوّل تغييرٍ في السعر.
  expectedMonths  Int?
  /// "SAR" | "EGP" — a string like `countryCode`, not an enum, and never assumed. Two markets
  /// with different currencies means an amount without one is not a number, it is a guess.
  currency        String?

  /// ── Denormalised from the newest open follow-up ──────────────────────────────────────
  /// `SalesLeadFollowUp` is the source of truth for the history. These two are a CACHE of its
  /// newest open row, written in the same action that writes the follow-up.
  ///
  /// They exist because the screen's first question is "who do I owe a call today?", and in
  /// MongoDB that means an aggregation over the child collection grouped per lead on every
  /// page load. An indexed field on the parent turns it into one ordinary query.
  ///
  /// Rule for anyone touching this: never write these two on their own. Write the follow-up,
  /// then refresh the cache from it — see `syncLeadNextAction`.
  nextActionAt   DateTime?
  nextActionNote String?
  /// When we last actually spoke to them — answers "this one has gone quiet for three weeks",
  /// which no `createdAt` or `updatedAt` can.
  lastContactAt  DateTime?

  /// Who is chasing this lead now. Distinct from `createdBy`, which is a fact about the past
  /// and never changes. Optional + NoAction for the same reason as every Staff link here.
  ownerId String? @db.ObjectId
  owner   Staff?  @relation("StaffOwnedLeads", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// The whole history of this lead — every call, message and visit.
  followUps SalesLeadFollowUp[]

  instagram String?
  facebook  String?
  tiktok    String?
  snapchat  String?
  twitter   String?
  linkedin  String?

  notes String?

  /// Filled the moment the lead is approved and becomes a client on modonty. The lead row
  /// is NOT deleted: it is the only record of how that client arrived.
  convertedClientId String?   @db.ObjectId
  convertedAt       DateTime?

  /// Who entered the row. Optional + NoAction like every other Staff link in this file —
  /// Mongo has no real cascade, and a required relation whose target is deleted turns the
  /// row into an orphan that drops the whole query, not just itself.
  createdById String? @db.ObjectId
  createdBy   Staff?  @relation("StaffSalesLeads", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdById])
  @@map("sales_leads")
}

/// How the lead reached us — a row Khalid edits, not an enum a developer deploys.
///
/// It replaces `enum LeadSource`, whose six values were inherited from the old sales app and
/// never measured (17 of 20 rows are `SOCIAL`). The list is his to grow: "معرض" today,
/// "توصية دكتور" tomorrow, with no schema edit in between.
///
/// `value` is what gets written onto `SalesLead.source` and must stay stable — renaming a
/// label must not rewrite history, so the label is edited freely while the value is not.
model LeadSourceOption {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Stored on the lead. Uppercase A–Z and underscores, generated once from the first label.
  value String @unique

  /// What a human reads in the dropdown. Editable at any time.
  label String

  /// Manual ordering in the dropdown; ties fall back to `label`.
  order Int @default(0)

  /// Retired options stay readable on old leads but leave the dropdown — the delete a user
  /// reaches for is almost always "stop offering this", not "erase where these clients came
  /// from".
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("lead_source_options")
}

/// الحملة الإعلانية — صفٌّ يؤسّسه مشتري الإعلانات قبل الإطلاق، لا نصٌّ يُكتب بعده.
///
/// كان اسم الحملة نصّاً حرّاً على العميل المحتمل (`SalesLead.campaign`)، فـ«رمضان-٢٠٢٦» و
/// «رمضان ٢٠٢٦» و«ramadan26» ثلاثةُ صفوفٍ في أيّ تقرير، وسؤال «الحملة دي جابت كام وبكام؟»
/// بلا جواب لأن الكلفة لم تكن مخزَّنةً أصلاً في أيّ مكان.
///
/// ── ما فيها وما ليس فيها ───────────────────────────────────────────────────────────────
/// هذه **وحدةُ إسنادٍ وتكلفة**، لا نسخةٌ من مدير إعلانات ميتا. الجمهور والإبداع وهدف التحسين
/// تعيش على `ad set` و`ad` في المنصّة نفسها، وحملةٌ واحدة قد تحوي خمس مجموعاتٍ بخمسة جماهير —
/// فنسخُ أيٍّ منها هنا يعني حقلاً لا جواب صحيح له. المصدر:
/// `developers.facebook.com/docs/marketing-api/campaign-structure`.
model AdCampaign {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// اسمٌ يقرؤه إنسان — يطابق ما كُتب في المنصّة كي يجد نفسه مَن يقارن الشاشتين.
  name String

  /// "SA" | "EG" — نفس عرف `SalesLead.countryCode`: رمزٌ لا علاقة، والقائمة ثلاثة صفوف.
  countryCode String

  /// "SAR" | "EGP" — نتيجةٌ للسوق لا سؤالٌ مستقلّ، وتُكتب لحظة الحفظ فيبقى الرقم مقروءاً
  /// حتى لو تغيّرت عملة السوق يوماً.
  currency String

  /// إلى أيّ موقعٍ يوصّل هذا الإعلان — مدونتي أم جبر سيو.
  ///
  /// خالد (٥ سبتمبر): «عندي جبر سيو ممكن أطلّع فيه إعلانات، ومدونتي كذلك — كيف بتفصلها؟».
  /// وهو حقلٌ لازم لا ترفيهيّ: منه يُبنى أصل الرابط الموسوم، وكان مكتوباً في الكود ثابتاً على
  /// مدونتي — فحملةُ جبر سيو كانت ستُنتج رابطاً يوصّل إلى الموقع الخطأ.
  ///
  /// وهو أيضاً الحدّ الذي يُقرأ عنده تقرير المصروف: «صرفنا كذا على مدونتي» سؤالٌ مختلف عن
  /// «صرفنا كذا على جبر سيو».
  ///
  /// ── وما لا يقدر عليه هذا الحقل ───────────────────────────────────────────────────────
  /// التطبيقان يتشاركان القاعدة (مقيس: `jbrseo/.env` و`.env.local` يشيران إلى `modonty` و
  /// `modonty_dev`)، لكنّ جبر سيو **لا يملك جدول عملاء محتملين**: مجموعاته ١٣ وما يخصّ
  /// الزائر فيها `Subscriber` و`PaymentAttempt` و`ExitReason`. فحملةٌ وجهتها جبر سيو تعرف
  /// **كم صرفت** ولا تعرف **كم جابت** حتى يُربط تسجيلُ زائره بـ`sales_leads`.
  site AdSite @default(MODONTY)

  /// أين تُنشر. تعدادٌ في الكود لا صفوفٌ في القاعدة — بخلاف `LeadSourceOption`.
  ///
  /// والسبب أن هذا الحقل **يقود كوداً**: منه يُشتقّ `utm_source` في الرابط الموسوم، وعليه
  /// يُرتَّب المنسدل بحسب الوصول في كل سوق. قائمةٌ يحرّرها المستخدم تعني صفّاً جديداً بلا
  /// وسمٍ يقابله، فيخرج رابطٌ ناقص المفتاح.
  channel AdChannel

  /// الهدف كما هو مضبوطٌ في المنصّة. يعيش على الحملة نفسها في ميتا وسناب وتيك توك.
  ///
  /// وسناب يدمج «تفاعل» و«وعي» في `AWARENESS_AND_ENGAGEMENT`، وجوجل لا يملك حقل هدفٍ أصلاً
  /// (عنده نوع القناة واستراتيجية المزايدة) — فهذه قيمتُنا نحن، لا مرآةٌ حرفية لكل منصّة.
  objective AdObjective

  startAt DateTime
  /// إلزاميّ لا اختياريّ: عدد الأيام يُشتقّ منه، وعليه يُبنى الإجمالي المعروض. حملةٌ بلا
  /// نهاية تعني ميزانيةً بلا سقفٍ محسوب.
  endAt   DateTime

  /// تبدأ **مسوّدة** لا شغّالة — وتوثيق جوجل يقولها حرفياً: أنشئ الحملة موقوفة كي لا تنطلق
  /// الإعلانات فوراً، وشغّلها بعد اكتمال الاستهداف. الافتراضيّ الخطأ هنا يصرف فلوساً على
  /// حملةٍ نصف مبنيّة. المصدر: `developers.google.com/google-ads/api/docs/campaigns/create-campaigns`.
  status AdCampaignStatus @default(DRAFT)

  /// ميزانية اليوم — **وهي وحدها المخزَّنة** (خالد ٥ سبتمبر).
  ///
  /// الإجماليّ مشتقٌّ: `dailyBudget × عدد الأيام`. وتخزينه يخلق رقماً ثانياً يكذب عند أوّل
  /// تمديد: مدُّ الحملة أسبوعاً يُبقي الإجماليَّ على حاله ويخفض اليوميَّ سرّاً إلى رقمٍ لم
  /// يضبطه أحد في أيّ منصّة، ثم يُبنى عليه تقرير.
  ///
  /// و`Float` لا `Int`: مَن يكتب إجمالياً لا يقبل القسمة (١٢٬٥٠٠ على ٣٠) ينتج `416.67`.
  dailyBudget Float

  /// ── الضريبة خارج هذه المرحلة (خالد ٥ سبتمبر) ─────────────────────────────────────────
  /// كان هنا `budgetIncludesVat` و`vatRate`، وأُخرِجا بقراره: «ليس له داعٍ في هذه المرحلة».
  /// والحذف كاملٌ لا تعطيلٌ — حقلٌ يُكتب ولا يُقرأ هو ما يُبنى عليه لاحقاً منطقٌ نصفه غائب.
  /// المقاس الذي أُخِذ حينها (ميتا تضيفها بسعر البلد إن لم يكن الرقم الضريبيّ على الحساب —
  /// السعودية ١٥٪ ومصر ١٤٪) محفوظٌ في `documents/idea/CAMPAIGNS.html` إن رجعنا إليها.

  /// حدٌّ لا يُتجاوز مهما حدث — يقابل `spend_cap` في ميتا و`lifetime_spend_cap_micro` في سناب.
  spendCap Float?

  /// ── الاستهداف: نيّةُ الحملة لا إعدادُها ────────────────────────────────────────────────
  /// أربعة حقول نصّية يكتبها مشتري الإعلانات ليعرف بعد شهرين **على مَن** صرف، لا كم صرف.
  ///
  /// وهي **لنا** لا مرآةٌ للمنصّة: في ميتا يعيش الاستهداف على `ad set` لا على الحملة، وحملةٌ
  /// واحدة قد تحوي خمس مجموعاتٍ بخمسة جماهير. فهذه لا تُزامَن ولا تُقارَن بإعداد المنصّة —
  /// هي ما قصده مَن أطلقها.
  ///
  /// ونصٌّ حرّ بقرار خالد (٥ سبتمبر) بعد أن قيل له الحدّ صراحةً: لا يُجمَّع. «الرياض» و
  /// «الریاض» صفّان، فلا يصحّ سؤال «كل حملات الرياض جابت كام؟» — تُقرأ حملةً حملة.
  targetRegion   String?
  targetAge      String?
  targetAudience String?

  /// الصفحة التي يهبط عليها الضاغط — مسارٌ لا رابطٌ كامل (`/pricing`).
  ///
  /// وهو الحقل الوحيد من الأربعة **الذي يعمل**: يدخل في الرابط الموسوم فيوصّل الإعلان إلى
  /// صفحته لا إلى الرئيسية. وصفحتان مختلفتان تعطيان نتيجتين مختلفتين لنفس الميزانية.
  ///
  /// ومسارٌ لا رابط: الأصل يجيء من `site`، فرابطٌ كاملٌ هنا يخلق مصدرَي حقيقةٍ للنطاق —
  /// ويكفي أن يُكتب `modonty.com` في حملةٍ وجهتُها جبر سيو ليصبّ الإعلان في غير موضعه.
  landingPath String?

  /// المفتاح الأوّل: معرّف الحملة **في المنصّة نفسها**، يُنسخ منها ولا يُخترع.
  ///
  /// به يجيء المصروف إلينا يوم نربط واجهة المنصّة. واختياريّ لأنه لا يوجد بعد لحظة تأسيس
  /// المسوّدة — الحملة تُنشأ عندنا أوّلاً ثم هناك.
  platformCampaignId String?

  /// المفتاح الثاني: وسم الرابط، وبه يُنسب **العميل** إلينا.
  ///
  /// فريدٌ لأنه مفتاح ربط: وسمان متطابقان يجعلان نسبة العميل إلى إحدى حملتين تخميناً. ويوضع
  /// في الرابط مع `utm_id` الذي تعرّفه جوجل بأنه معرّف الحملة.
  utmCampaign String @unique

  note String?

  /// مَن جاءنا منها. علاقةٌ لا نصّ — وهي كلّ الغرض من هذا الجدول.
  leads SalesLead[]

  /// مَن أسّسها. اختياريّ + `NoAction` كعادة كل ارتباطٍ بـ`Staff` في هذا الملف: مونجو بلا
  /// تعاقبٍ حقيقيّ، وارتباطٌ إلزاميّ يُحذف هدفه يحوّل الصفّ إلى يتيمٍ يُسقط الاستعلام كلّه.
  createdById String? @db.ObjectId
  createdBy   Staff?  @relation("StaffAdCampaigns", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startAt])
  @@index([countryCode, channel])
  @@map("ad_campaigns")
}

/// المنصّات التي نشتري منها فعلاً في السوقين. الترتيب هنا أبجديُّ المعنى لا ترتيب العرض —
/// ترتيب المنسدل يتبع الوصول في كل سوق ويعيش في الكود، لأنه يختلف بين السعودية ومصر.
enum AdChannel {
  TIKTOK
  YOUTUBE
  SNAPCHAT
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
  /// بحث جوجل — ليس اجتماعياً فلا يُرتَّب معها بالوصول، ويبقى آخر القائمة.
  ///
  /// أُضيف رغم غيابه عن النموذج المعتمَد: كلّ ما بُني عليه الوصل (`utm_id` و`{campaignid}`)
  /// مقروءٌ من توثيق جوجل، وإضافة قيمةٍ للتعداد اليوم مجّانية بينما إضافتها بعد كتابة صفوفٍ
  /// تعني ترحيلاً.
  GOOGLE
}

/// مواقعنا التي توصّل إليها إعلاناتنا. تعدادٌ لا نصّ: أصل الرابط يُشتقّ منه، وموقعٌ يُكتب
/// بيدٍ يعني رابطاً بحرفٍ ناقص لا يوصّل إلى شيء.
enum AdSite {
  MODONTY
  JBRSEO
}

enum AdObjective {
  LEADS
  SALES
  TRAFFIC
  ENGAGEMENT
  AWARENESS
}

/// حالةٌ واحدة عندنا، بينما المنصّات تفرّق بين `status` (ما ضُبط) و`effective_status` (ما
/// يحدث فعلاً — قد تتوقّف الحملة لنفاد رصيد الحساب). الفرق يُقال في شاشة المتابعة لا يُخزَّن،
/// لأن مصدره المنصّة لا نحن.
enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// باقات البيع بأسعار كل سوق — **نسخة طبق الأصل** من `Plan` في جبر سيو.
///
/// خالد (٤ سبتمبر): «الـtable تبع الـprice اللي موجود في جبر سيو، اعمل واحد عندنا typical
/// identical. هنشتغل عليه الآن، وبعدين لما نحوّل جبر سيو هننقل عليه».
///
/// ── لماذا نسخة لا قراءة من الأصل ─────────────────────────────────────────────────────────
/// كنّا نقرأ مجموعة `Plan` بأمرٍ خام لأنها ليست في سكيمانا — تملكها جبر سيو وتكتب فيها.
/// وذلك يعني: لا أنواع، ولا تحقّق، ولا قدرة على التعديل من الأدمن، وكسرٌ صامت لو غيّرت جبر
/// سيو شكل صفوفها. وهذا الجدول يجعل مدونتي تملك نسخَتها فتكتب فيها وتحكمها، وحين يُنقل جبر
/// سيو إلى المستودع تُدمج المجموعتان في هذه — لا في تلك.
///
/// ── مطابقة الحقول ───────────────────────────────────────────────────────────────────────
/// كل حقلٍ هنا موجودٌ هناك بنفس الاسم والنوع والافتراضي، بلا زيادة ولا نقصان. التطابق مقصود:
/// النقل يصير نسخاً مباشراً، وأي حقلٍ نخترعه اليوم يصير فرقاً نعالجه يومها.
/// المصدر: `JBRSEO/jbrseo.com/prisma/schema.prisma:145-171`.
///
/// ── اسم المجموعة ────────────────────────────────────────────────────────────────────────
/// `modonty_plans` لا `Plan`: الأخيرة قائمةٌ في القاعدة نفسها وتكتب فيها جبر سيو، وتسميتُنا
/// إيّاها تجعل التطبيقين يكتبان في مكانٍ واحد بسكيمتين — وهو أسوأ من مصدرين منفصلين.
model ModontyPlan {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Control
  country      String // "SA" | "EG"
  slug         String // "free" | "presence" | "starter" | "growth" | "scale"
  visible      Boolean @default(true)
  displayOrder Int

  // Core content
  name          String
  tagline       String  @default("")
  priceMonthly  Int     @default(0)
  priceYearly   Int     @default(0)
  articlesLabel String  @default("")
  ctaText       String  @default("")
  /// السطر المميّز الذي يُعرض قرب السعر — «الميزة التي تصطاد».
  hook          String?
  highlights    String[]

  // Badges
  badge         String?
  featuredBadge String?

  updatedAt DateTime @updatedAt

  @@unique([country, slug])
  @@index([country, displayOrder])
  @@map("modonty_plans")
}

/// DEPRECATED — the three states that predate `SalesStage`. Dropped once the backfill is
/// verified. Khalid (2026-09-04): «هنعمل لها قائمة بالحالات اللي إحنا محتاجينها».
enum SalesLeadStatus {
  PROSPECT
  ACTIVE
  ARCHIVED
}

/// The pipeline. Ordered — the list reads top to bottom as the deal progresses, and the two
/// terminal stages sit at the end where a funnel chart expects them.
enum SalesStage {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

/// Why a deal died. A closed list, not free text: free text cannot be counted, and the whole
/// point of recording a loss is to count it. `OTHER` carries `lostNote` for the rest.
enum SalesLostReason {
  PRICE
  COMPETITOR
  NO_RESPONSE
  NOT_NOW
  NOT_A_FIT
  OTHER
}

/// How the contact happened. `NOTE` is the escape hatch for "something I want on the record
/// that was not a conversation" — a rep who has nowhere to put that writes it in the wrong
/// field instead.
enum FollowUpChannel {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  VISIT
  NOTE
}

/// One contact with a lead — the row Khalid asked for (2026-09-04): «تليفون، واتصال، والكلام
/// هذا كله يكون فيه follow up… لأن العميل ممكن يكون فيه قصة حياته كاملة في الـfollow up».
///
/// This replaces the single `SalesLead.notes` column, which was a real defect and not just a
/// limitation: every save overwrote it, so a lead could be worked for six months and the row
/// would show only the last sentence anyone typed.
///
/// ── Why "what happened" and "the next appointment" live on the SAME row ──────────────────
/// Because that is one event. The rep calls, they talk, and at the end of that same call they
/// agree on when to speak next. Splitting them into two tables creates two facts that must be
/// kept in step by hand, and they drift the first week. So: a row is a contact that happened,
/// optionally carrying the appointment it produced. The lead's current appointment is simply
/// the newest row whose `doneAt` is still null.
///
/// ── On deleting a lead ───────────────────────────────────────────────────────────────────
/// `onDelete: Cascade` is declared, but on MongoDB Prisma EMULATES it in the client — the
/// official docs are explicit that the prisma relation mode "does not apply to raw queries".
/// So it protects deletes made through this codebase and nothing else; a row removed in
/// Compass or Atlas leaves its follow-ups orphaned, and an orphan breaks the whole query in
/// Mongo, not just its own row. Two consequences, both deliberate:
///   1. Nothing in the app deletes a lead. It archives (see `SalesStage.LOST`).
///   2. Any read that starts from THIS model and includes `lead` must tolerate its absence.
model SalesLeadFollowUp {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  leadId String    @db.ObjectId
  lead   SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  channel FollowUpChannel @default(CALL)

  /// When the contact HAPPENED — not when it was typed. A rep logging yesterday's call this
  /// morning is the normal case, and `createdAt` would file it under the wrong day.
  happenedAt DateTime @default(now())

  /// What was said. Required: a follow-up with no content is a row that costs a read and
  /// tells the next person nothing.
  body String

  /// The appointment this contact produced, if any.
  nextActionAt   DateTime?
  nextActionNote String?

  /// Set when the appointment has been acted on, so it drops out of "due today". Null while
  /// it is still owed — which is what the due query filters on, together with `nextActionAt`.
  doneAt DateTime?

  /// The stage the lead moved to in this contact, when it moved. Lets the history read as a
  /// story ("quoted on the 3rd, negotiating by the 11th") instead of a flat list of notes.
  stageAfter SalesStage?

  createdById String? @db.ObjectId
  createdBy   Staff?  @relation("StaffLeadFollowUps", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The lead's own timeline, newest first.
  @@index([leadId, happenedAt])
  /// "Who do I owe a call?" across every lead — the screen's opening question.
  @@index([doneAt, nextActionAt])
  @@index([createdById])
  @@map("sales_lead_followups")
}

// REMOVED 2026-07-30 (Khalid): the whole social-publishing feature is gone — the
// /social admin pages, `lib/social/{meta,twitter}.ts`, and the auto-post on first
// publish. `SocialPost` + `SocialPlatform` + `SocialPostStatus` were only ever used
// by that code, so the model went with it.
//
// The `social_posts` MongoDB collection is NOT dropped — Prisma simply stops
// mapping it. Old rows stay readable via mongosh if the history is ever needed;
// drop the collection manually (after a backup) once it is confirmed unwanted.

/// A licensing/regulatory body a YMYL client picks during verification.
/// Linked to a country by ISO `countryCode` (no relation — resolved in queries).
model LicensingAuthority {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  countryCode String // → Country.code (ISO 3166-1 alpha-2)
  category    YmylCategory
  code        String // short identifier shown alongside the name (MOH, SCFHS, CMA…)
  nameAr      String
  nameEn      String
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, category, code])
  @@index([countryCode, category])
  @@map("licensing_authorities")
}

// Named CTA presets the admin adds WITHOUT a code change (Khalid 2026-07-24).
// A preset is not a new behaviour — picking one fills the three fields that already
// exist on Client (ctaMode / ctaLabel / ctaUrl), so every surface that renders a CTA
// and every segment that counts one keeps working untouched. The two real behaviours
// stay in code and cannot be added from a screen:
//   FORM → internal booking sheet — the lead lands in OUR database
//   LINK → tracked external anchor (https · wa.me · tel:) — we only see the click
// «Unlimited CTAs» therefore means unlimited label + behaviour + destination combos,
// which already covers booking, store, WhatsApp and phone.
// The button text IS the identity here (Khalid 2026-07-24: «أنت بتتكلم مع إنسان»).
// There is deliberately no admin-facing slug — the machine identifier is `id`, and the
// human identifier is what the visitor reads. Uniqueness is enforced on `labelKey`, the
// NORMALISED text: Arabic makes «تسوق» and «تسوّق» two different strings that render
// almost identically, so comparing the raw text would guard nothing. `labelAr` keeps
// exactly what was typed — the normalisation exists only to answer «is this the same
// button?».
model CtaPreset {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  labelAr    String // the Arabic text the visitor actually reads on the button
  labelKey   String        @unique // derived from labelAr: no diacritics, unified alef/yaa, collapsed spaces
  mode       ClientCtaMode // FORM | LINK — NONE is «no button», never a preset
  defaultUrl String? // LINK only: prefilled destination (https · wa.me · tel:)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("cta_presets")
}

// ============================================
// REELS — merged into Media (locked 2026-08-05)
//
// The `Reel` table is gone. A media file IS the reel: the row that holds the image
// or the video carries the reel state itself. What this removes is the copy — two
// rows holding the same URL, kept in sync by hand in two admin actions, where every
// bug in this feature came from.
//
// `Media.type` keeps its old meaning (the file's ROLE) and is NOT touched: 15 queries
// read it and 6 write it. Reel membership rides on top as its own switch instead.
//
// There is no `ReelType` any more — image vs video is already in `mimeType`.
// Study: بطاقات بورد «الطلّات» في documents/tasks/TASK.html (الملف حُذف ٢٢ أغسطس بعد نقل محتواه)
// ============================================

/// How loud a note to the content team is allowed to be.
///
/// Three levels, deliberately — not two, not five. Two cannot separate "read this" from
/// "work is blocked"; five or more collapse in practice into "urgent" and "ignored",
/// because every sender believes their own note is urgent. Three forces a real choice.
enum NotificationPriority {
  NORMAL /// للعلم — نفّذها لما توصلها
  IMPORTANT /// تحتاج تحرّكاً هذا الأسبوع
  URGENT /// شغل واقف — اليوم
}


/// A note the operations manager sent to the content team's Telegram about one client.
///
/// The row is the record, the Telegram message is just its delivery. Which is why
/// `delivered` and `error` are stored: a log that says "sent" while Telegram was down is
/// worse than no log at all — somebody would rely on it.
///
/// Identity is stored twice on purpose, exactly like [AuditLog]: `sentById` is the key
/// that never changes, and the name/email are a SNAPSHOT of who that person was at that
/// moment — so the history still answers "who told us?" after they leave and their staff
/// record is gone.
model ClientNotification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  message  String
  priority NotificationPriority @default(NORMAL)

  /// Who the note is FOR. EMPTY means everyone in the content group.
  ///
  /// One Telegram group holds the whole team, so the only thing that tells a person a note
  /// is theirs is seeing their name on it. Ids are kept for filtering later; names are
  /// SNAPSHOTTED for the same reason `sentByName` is — a note has to keep saying who it was
  /// addressed to after that person leaves and their staff row is gone.
  recipientIds   String[] @db.ObjectId
  recipientNames String[]

  // Who sent it — the signed-in staff member, never a value the browser supplies.
  sentById    String  @db.ObjectId
  sentByName  String
  sentByEmail String

  // Outcome of the actual Telegram call.
  delivered Boolean
  error     String?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("client_notifications")
}

/// One row per installed mobile device. It owns the Expo token, not the Client row,
/// because one client account may be active on several phones and tokens rotate.
model MobileDevice {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// ExpoPushToken[...] or ExponentPushToken[...]. Unique so a re-login moves the
  /// token to the current authenticated client rather than creating a duplicate.
  expoPushToken String @unique
  platform      String // "android" | "ios"
  deviceName    String?
  appVersion    String?

  enabled      Boolean  @default(true)
  lastSeenAt   DateTime @default(now())
  disabledAt   DateTime?
  disabledReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId, enabled])
  @@map("mobile_devices")
}

enum ReelStatus {
  DRAFT
  PENDING_APPROVAL // client upload awaiting admin approval
  APPROVED // approved, not yet live in the feed
  PUBLISHED // live on the public feed + standalone watch page
  REJECTED
  ARCHIVED
}

enum ReelUploader {
  ADMIN
  CLIENT
}

enum ReelTranscriptStatus {
  PENDING // auto transcription runs after approval (Arabic — language pinned manually)
  DONE
  FAILED
  SKIPPED // images / transcription not applicable
}

/// Reaction kinds on a media file. One row per (file, actor, kind).
///
/// `FAVORITE` needs a signed-in user, `LIKE` allows an anonymous visitor. The old
/// two-table split expressed that rule in the database; one table with a nullable
/// `userId` cannot — so the guard moved into the server action that writes the row.
enum MediaReactionKind {
  LIKE
  FAVORITE
}

/// Comments on a media file — same shape as article comments (nesting + moderation).
model MediaComment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  content String

  mediaId String @db.ObjectId
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  parentId String?       @db.ObjectId
  parent   MediaComment? @relation("MediaCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  replies MediaComment[] @relation("MediaCommentReplies")

  status   CommentStatus @default(PENDING)
  isEdited Boolean       @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  reactions CommentReaction[]

  @@index([mediaId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@map("media_comments")
}

/// A visitor's like or favorite ON THE FILE.
///
/// Two uniqueness rules, not one: a signed-in visitor is identified by `userId`, an
/// anonymous one by `sessionId`. Drop either and the same person can react without
/// limit through the other path.
model MediaReaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  mediaId String @db.ObjectId
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  kind MediaReactionKind

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // anonymous visitors

  createdAt DateTime @default(now())

  @@unique([mediaId, kind, userId])
  @@unique([mediaId, kind, sessionId])
  @@index([mediaId, kind])
  @@index([userId])
  @@map("media_reactions")
}

/// A like or dislike ON A COMMENT — a separate table on purpose.
///
/// It cannot live inside `MediaReaction`: that row points at a file, this one points
/// at a comment. Merging them would force a row that references two different things
/// with one of the two columns always empty.
model CommentReaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  commentId String       @db.ObjectId
  comment   MediaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  isLike Boolean // true = like · false = dislike

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // anonymous visitors

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@unique([commentId, sessionId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

/// One row per backup attempt — success or failure.
///
/// Exists because both earlier backup paths failed silently: the manual script copied
/// modonty_dev while everyone read it as production, and the scheduled .bat never ran
/// once (zero output folders on disk, undetected for months). A backup system without
/// a record of its own runs cannot tell you it has stopped.
///
/// `dbName` is stored and displayed deliberately — it is the single field that would
/// have exposed the original trap at a glance.
/// Decisions: documents/tasks/BACKUP-STRATEGY-v1.html (ق5)
model BackupRun {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  source BackupSource // who produced it — the daily cron, Khalid's machine, or Atlas
  dbName String // "modonty" | "modonty_dev" — shown in the UI, never inferred
  status BackupStatus @default(RUNNING)

  collections Int? // collections written
  documents   Int? // total documents across all collections
  sizeBytes   Int? // compressed size actually stored
  bunnyPath   String? // folder on the private zone, e.g. daily/2026-08-04

  errorText String? // failing collection + message when status = FAILED

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([status, startedAt])
  @@index([source, startedAt])
  @@map("backup_runs")
}

enum BackupSource {
  VERCEL_CRON // daily, the guaranteed layer
  LOCAL_DUMP // mongodump on Khalid's machine — opportunistic, BSON format
  RESTORE_TEST // monthly restore drill, not a backup itself
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ═══════════════════════════════════════════════════════════════════
// برومبتات الذكاء الاصطناعي — مصدر حقيقة واحد للتطبيقات الثلاثة.
//
// خالد (٢٨ أغسطس ٢٠٢٦): «أي برومبت جديد ولا أي AI بستخدمه في أي مكان في
// البروجيكت، أبغى آخذ key واضح يكون هو البرومبت». فالقاعدة صارت:
// **صفر برومبت مكتوب في الكود.** الكود لا يعرف النصّ — ينادي المفتاح وحده.
//
// السبب: البرومبت سياسة وأسلوب لا منطق — يتغيّر بالذوق لا بالمتطلّبات،
// فتعديل كلمة فيه لا يفترض أن يمرّ بنشر. وتكلفته صفر على الزائر: يُقرأ مرّة
// على السيرفر قبل نداء النموذج، والنداء أصلاً يضرب القاعدة وينتظر النموذج
// مئات الملّي ثانية — فقراءةٌ مخزَّنة تضيع في الضجيج.
//
// الجرد الذي وُلد منه هذا الجدول: `documents/tasks/scan-prompts.mjs`
// (٧ برومبتات حيّة: مدونتي ٣ · الأدمن ٤ · الكونسول صفر).
// ═══════════════════════════════════════════════════════════════════

model AiPrompt {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// المفتاح هو هوية البرومبت: `<التطبيق>.<الميزة>.<الدور>` — `modo.identity` · `admin.image.gallery`.
  /// الكود ينادي به ولا يعرف النصّ إطلاقاً، فيُقرأ وحده بلا شرح.
  key String @unique

  /// أي تطبيق يملكه: `modonty` · `admin` · `console`.
  app String

  /// مزوّد النموذج: `Cohere` · `OpenAI` · `Gemini`. للعرض والتصفية، لا للتوجيه.
  provider String

  /// اسم بشري في شاشة الأدمن، وسطرٌ يقول أين يظهر أثره للزائر.
  title   String
  surface String

  /// النصّ نفسه — وهو الشيء الوحيد الذي يُحرَّر عادةً.
  body String

  /// **العقد.** المتغيّرات التي يجب أن يحملها النصّ (`categoryName` · `articleTitle`).
  /// الحفظ يُرفض إن نقص واحد منها، والرسالة تسمّيه — وإلا فقد البرومبت سياقه بصمت
  /// بعد تعديل بريء، وهو عطلٌ لا يظهر إلا في جواب خاطئ للزائر.
  requiredVars String[]

  /// ماذا ينكسر لو غاب هذا البرومبت — يُعرض في الشاشة كي يعرف المحرّر ما يمسّه.
  onEmpty String?

  /// معطَّل = لا يُقرأ من القاعدة، فيرجع النداء إلى نصّ الكود الاحتياطي.
  isActive Boolean @default(true)

  /// مَن عدّل ومتى — خالد طلب أن يراجعها، والمراجعة تحتاج أثراً.
  updatedById String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([app])
  @@map("ai_prompts")
}
