/// Universal page-view log — one row per genuine page entry on ANY surface NOT
/// already covered by ArticleView/ClientView (home, categories, tags, authors,
/// help, search, etc.). Feeds the footer "بالأرقام" views total alongside
/// article + client views (additive, no double-count). Honest count: a
/// refresh-in-place is suppressed in /api/track/pageview; a genuine return after
/// navigating elsewhere counts.
model PageView {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  path     String // pathname, e.g. "/", "/categories", "/tags/seo"
  pageType String // coarse bucket: home | categories | tags | authors | help | search | other

  userId    String? @db.ObjectId
  sessionId String?

  userAgent String?
  referrer  String?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@map("page_views")
}

model ClientComment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Content
  content String // Comment text

  // Relationships
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId // Optional - allow anonymous comments
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Reply support (nested comments)
  parentId String? @db.ObjectId // If null, it's a top-level comment
  parent   ClientComment? @relation("ClientCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  ClientComment[] @relation("ClientCommentReplies")

  // Status & Moderation
  status   CommentStatus @default(PENDING)
  isEdited Boolean       @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  // Relationships for interactions
  likes    ClientCommentLike[]
  dislikes ClientCommentDislike[]

  @@index([clientId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@map("client_comments")
}

/// Customer review of a CLIENT's service — stars + text, one per visitor per client.
/// Separate from ClientComment (discussion): rating is required, @@unique enforces
/// one review per author, feeds AggregateRating + Review[] JSON-LD on the client page.
/// A visitor's review OF a client. `reviewer` is a `User` (a signed-in visitor) — it is NOT
/// the `Author` model, which is the person who writes articles. The field used to be called
/// `author`, which read as if a Client had an Author relation; it never did (renamed
/// 2026-07-30). `@map("authorId")` keeps the stored MongoDB field name, so this rename is
/// code-only: no document changes, nothing to migrate, zero production impact.
///
/// NOTE on `onDelete: Cascade` — MongoDB has no referential actions; Prisma emulates them
/// "on a best-effort basis" and only for deletes issued through Prisma Client. A user removed
/// any other way leaves an orphaned reviewerId, so every READ must tolerate a missing
/// reviewer instead of joining the required relation (see client-reviews.ts).
model ClientReview {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  clientId   String @db.ObjectId
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewerId String @map("authorId") @db.ObjectId
  reviewer   User   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  rating  Int    // 1–5 (required)
  comment String // review text

  status CommentStatus @default(PENDING) // PENDING until moderated → APPROVED feeds the page

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, reviewerId]) // one review per visitor per client (DB fields unchanged)
  @@index([clientId, status])
  @@map("client_reviews")
}

