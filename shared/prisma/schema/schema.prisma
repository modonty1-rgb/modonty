// Main Prisma schema file for Modonty Blog Platform
// MongoDB provider for multi-client blog platform with 100% SEO optimization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  EDITOR
}

// Company staff who sign in to the ADMIN app. Kept in a SEPARATE table from
// public readers (User) so a reader can never gain admin access by a role flip.
enum StaffRole {
  ADMIN
  EDITOR
  CREATIVE
  SOCIAL
  QC
  SALES
}

// Board columns for staff task management. FIXED on purpose: the value lives in
// the URL (`/tasks/in-progress`) and drives the counters, so a column cannot be
// renamed out from under a bookmark or a count. Custom lists were the rejected
// alternative — they need a second table and an admin screen to manage it.
enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ArticleStatus {
  WRITING
  DRAFT
  AWAITING_APPROVAL
  NEEDS_REVISION
  SCHEDULED
  PUBLISHED
  // Live on the CLIENT's own website, never on modonty.com. This value is the
  // isolation wall: every public modonty query filters `status: PUBLISHED`
  // exactly, so an article carrying this value is invisible to the site, the
  // sitemap, the feed and llms.txt without a single line of hide-logic.
  PUBLISHED_ON_CLIENT_SITE
  ARCHIVED
}

enum TrafficSource {
  ORGANIC
  DIRECT
  REFERRAL
  SOCIAL
  EMAIL
  PAID
  INTERNAL // same-site navigation (was misclassified as ORGANIC before 2026-07-07)
}

enum SubscriptionTier {
  BASIC
  STANDARD
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum MediaType {
  LOGO
  POST
  OGIMAGE // Social share image (og:image) — reserved for future use
  TWITTER_IMAGE
  HERO
  GENERAL
  GALLERY // Client-page gallery image (ImageObject[])
  CLIENT_MINI // Client mini/card image (1200×630 · 1.91:1) — sidebar slider + article client card
}

enum MediaScope {
  CLIENT   // Belongs to a specific client
  GENERAL  // No client — visible in all pickers
  PLATFORM // Modonty platform assets (categories, logos, OG images)
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum ArticleFAQStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ConversionType {
  SIGNUP
  CONTACT_FORM
  DOWNLOAD
  NEWSLETTER
  PURCHASE
  TRIAL_START
  DEMO_REQUEST
  PHONE_CLICK
  EMAIL_CLICK
  DIRECTORY_VIEW
  BOOKING // FORM submit (احجز الآن)
  LINK_CLICK // external CTA click (تسوّق الآن) — known logged-in user = warm lead
}

enum CTAType {
  BUTTON
  LINK
  FORM
  BANNER
  POPUP
}

enum ClientCtaMode {
  NONE
  FORM
  LINK
}

enum SharePlatform {
  FACEBOOK
  TWITTER
  LINKEDIN
  WHATSAPP
  EMAIL
  COPY_LINK
  PRINT
  OTHER
}

enum CampaignType {
  EMAIL
  SOCIAL
  PAID_ADS
  SEO
  AFFILIATE
  INFLUENCER
  CONTENT
}

enum LinkType {
  INTERNAL
  EXTERNAL
  AFFILIATE
  CITATION
  SOCIAL
  EMAIL
  PHONE
  DOWNLOAD
}

// ============================================
// AUTHENTICATION MODELS
// ============================================

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // NextAuth.js required fields
  name          String?
  email         String?   @unique
  emailVerified DateTime? // Email verification timestamp
  image         String? // NextAuth standard field (profile image URL)

  // Custom fields
  bio                   String?   // Short user bio (max 500 chars)
  password              String?   // Hashed password (optional for OAuth users)
  passwordResetToken    String?   // SHA-256 hash of token
  passwordResetExpires  DateTime? // typically 1h from request
  role                  UserRole @default(EDITOR)
  avatar   String? // Keep for compatibility, prefer using 'image'

  // Email notification preferences (USR-R3)
  notificationPreferences Json? // { commentReply: true, faqReply: true, newsletter: true }

  // Links to clients (for client users)
  clientAccess String[] @db.ObjectId // Array of client IDs this user can access

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth.js relations
  accounts Account[]
  sessions Session[]

  // Interaction relations
  comments              Comment[]
  clientComments        ClientComment[]
  clientReviews         ClientReview[]
  articleLikes          ArticleLike[]
  articleDislikes       ArticleDislike[]
  articleFavorites      ArticleFavorite[]
  clientLikes           ClientLike[]
  clientDislikes        ClientDislike[]
  clientFavorites       ClientFavorite[]
  commentLikes          CommentLike[]
  commentDislikes       CommentDislike[]
  clientCommentLikes    ClientCommentLike[]
  clientCommentDislikes ClientCommentDislike[]
  articleViews          ArticleView[]
  clientViews           ClientView[]
  shares                Share[]
  conversions           Conversion[]
  ctaClicks             CTAClick[]
  linkClicks            ArticleLinkClick[]
  campaignTracking      CampaignTracking[]
  leadScoring           LeadScoring[]
  engagementDuration    EngagementDuration[]
  faqFeedbacks         FAQFeedback[]
  chatbotMessages      ChatbotMessage[]
  contactMessages      ContactMessage[]
  notifications        Notification[]
  ownedClients         Client[]         @relation("ClientOwner")
  bookingRequests      BookingRequest[]
  mediaComments        MediaComment[]
  mediaReactions       MediaReaction[]
  commentReactions     CommentReaction[]

  @@index([role])
  @@map("users")
}

// Company staff (admin panel sign-in). Separate collection from `users` (public
// readers). Migration copies the 8 admins here PRESERVING their _id, so every
// existing reference to a staff id (createdBy/reviewedBy/authorId/notifications…)
// keeps resolving. Relations to other models are added in a later step.
model Staff {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?

  /// ── واجهة العميل (خالد ١٥ سبتمبر ٢٠٢٦) ───────────────────────────────────────
  /// مسار الدفع المصريّ تحويلٌ بنكيّ بلا بوّابة تحميه، فالمشتري يرسل مالاً إلى حسابٍ
  /// لا يعرفه. واسمٌ ووجهٌ ورقمٌ لإنسانٍ بعينه يقصّر تلك المسافة أكثر من أي نصّ طمأنة.
  ///
  /// ولماذا ثلاثة حقولٍ لا دورٌ جديد في `StaffRole`: الدور يحكم **ما يفتحه الموظّف في
  /// الأدمن**، و«مدير حساب» وظيفةٌ تجاه العميل لا صلاحيةَ دخول. ودمجهما يمنع محرّرةً من
  /// التواصل مع عميل إلا بإعطائها شاشات المبيعات كلّها، ويمنع بائعاً من أن يكون واجهةً
  /// وبائعاً معاً — لأن الدور واحد. فالصلاحية في `role`، والظهور هنا.
  /// رقما تواصلٍ يُعرضان للعملاء — E.164 عبر `shared/lib/phone`.
  ///
  /// ── ليش رقمان لا واحد (خالد ١٥ سبتمبر ٢٠٢٦) ──
  /// «المصري محتاج يشوف الرقمين… الرقم المصري عشان يتواصل برقم مصري يوفر علينا تكلفه».
  /// فالمشتري المصريّ يرى **الاثنين**: المصريّ هو زرّ التواصل — مكالمةٌ محلّية لا دولية —
  /// والسعوديّ مكتوبٌ جنبه لأنه إثباتُ أن خلف الصفحة مؤسّسةً سعودية حقيقية. وهذا يهمّ
  /// تحديداً في مسار مصر: تحويلٌ بنكيّ بلا بوّابة تحميه، والثقة كلّ ما يملكه المشتري.
  ///
  /// ومفتاحها السوق كبقيّة الكود (`market === "EG" ? phoneEg : phoneSa`). ومن ينقص رقم
  /// سوقه يسقط على الآخر: زرّ تواصلٍ برقمٍ بعيد خيرٌ من زرٍّ يختفي.
  ///
  /// ⚠ أرقام عملٍ لا شخصية: ما يُنشر على صفحةٍ حيّة يُجمَع في قوائم الإزعاج ولا يُسحَب،
  /// ومن يترك العمل يبقى عملاؤنا يتصلون برقمه.
  phoneSa String?
  phoneEg String?

  /// اللقب كما يقرأه العميل («مديرة الحسابات») — لا `role` التقنيّ («SALES»).
  titleAr String?

  /// هل يُعرض هذا الشخص للعملاء خارج الأدمن؟ غيابه يقرأ **لا** — الاتجاه الآمن:
  /// بياناتُ موظّفٍ لا تُنشر بالسهو، بل بتأشيرةٍ صريحة.
  isPublicContact Boolean? @default(false)

  // Auth (admin uses credentials + JWT — no NextAuth adapter, so no Account/Session)
  password             String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  role StaffRole @default(ADMIN)

  // Employment status. Absent/null = active (never backfilled); only explicit false
  // means "left" — the record + their history stay, but they can no longer sign in.
  isActive Boolean? @default(true)

  /// Whether this person may open the daily report — a permission ON THE PERSON, not a
  /// consequence of their role. Khalid (2026-09-04): «بدل ما يكون admin، الموظف نفسه في
  /// تأسيسه يكون فيه زي الـcheckmark… مش شرط يكون admin».
  ///
  /// ADMIN passes without it (see `canSeeReports`): tying the report to this box alone
  /// would lock the next admin out of their own report until someone remembered to tick it.
  /// Absent on the rows that predate the field, which reads as false — the safe direction.
  canViewReports Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[] @relation("StaffNotifications")
  salesClients  Client[]       @relation("StaffSalesClients")
  salesLeads    SalesLead[]    @relation("StaffSalesLeads")
  editorClients Client[]       @relation("StaffEditorClients")
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreatedBy")

  /// Leads this person is RESPONSIBLE for, as opposed to `salesLeads` — the ones they
  /// happened to type in. The two diverge the first time a lead is handed over, and the
  /// question "who is chasing this?" is answered by this one, never by who created the row.
  ownedLeads    SalesLead[]         @relation("StaffOwnedLeads")
  leadFollowUps SalesLeadFollowUp[] @relation("StaffLeadFollowUps")

  /// الحملات التي أسّسها — مشتري الإعلانات. علاقةٌ عكسيّة يفرضها بريزما على كل ارتباط.
  adCampaigns AdCampaign[] @relation("StaffAdCampaigns")

  @@index([role])
  @@map("staff")
}

// A unit of work handed to one member of staff. Deliberately standalone: it
// carries no article/client foreign key, because the board has to hold the work
// that has no entity behind it ("call the printer", "renew the domain") — which
// is most of what a small team actually tracks.
model Task {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(NORMAL)

  // Manual order inside a column. A FLOAT, not an int: dropping a card between
  // two others writes the midpoint of its neighbours — ONE row updated instead
  // of renumbering the whole column on every drag.
  position Float @default(0)

  dueDate DateTime?

  // Both staff links are OPTIONAL and NoAction, matching Client.salesRep. Mongo
  // has no real cascade, and a REQUIRED relation whose target is deleted turns
  // every row into an orphan that drops the entire query — not just its own row.
  assigneeId String? @db.ObjectId
  assignee   Staff?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdById String? @db.ObjectId
  createdBy   Staff?  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Stamped once, when the card first lands in DONE. Kept separate from
  // `updatedAt` so editing a finished task does not rewrite when it finished.
  completedAt DateTime?

  // Archived, never deleted — Khalid, 2026-09-02: «مافي حذف، أرشفه بدل الحذف».
  //
  // A DATE on the task, not a fifth column: archiving is orthogonal to where the
  // work stands, so a card restored from the archive returns to the column it
  // left. A fifth status would have to forget that, and would put a column on
  // the board that is not part of the workflow.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The board's only read: live cards in one column, ordered. `archivedAt` leads
  // because every board query filters on it first — an index that starts with
  // `status` would scan archived rows before discarding them.
  @@index([archivedAt, status, position])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model Account {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  type              String // OAuth or email
  provider          String // google, facebook, credentials, etc.
  providerAccountId String // Provider's unique user ID

  // OAuth tokens (optional, for OAuth providers)
  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  // Relations
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String // Email address or other identifier
  token      String   @unique
  expires    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ChatbotMessage {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Null for a visitor on the free trial. Optional on purpose: their turns cost the same money
  /// as a member's, so a spend ceiling that cannot see them does not cap the bill (measured
  /// 2026-08-19 — anonymous turns were not written at all, and the counter read this table).
  userId            String?  @db.ObjectId
  user              User?    @relation(fields: [userId], references: [id])
  /// Groups the turns of one conversation. Without it a reload lost the thread, because
  /// the only copy of the conversation lived in React state.
  conversationId    String?  @db.ObjectId
  /// Position inside the conversation, so turns replay in the order they happened.
  turnIndex         Int?
  userQuery         String
  assistantResponse String
  scopeType         String // "article" | "industry" | "category"
  articleSlug       String?
  categorySlug      String?
  /// The scope Modo actually answers in. Partners belong to an industry, so this is the only
  /// column that says which part of the business a conversation belonged to.
  industrySlug      String?
  articleId         String?  @db.ObjectId
  categoryId        String?  @db.ObjectId
  industryId        String?  @db.ObjectId
  outcome           String // "outOfScope" | "redirect" | "stream" | "error"
  source            String? // "web" | "db" | null
  /// The visitor's verdict on this answer: true 👍, false 👎, null = not rated.
  /// It is the only human judgment we have, and the calibration set is built from it — the five
  /// reranker thresholds cannot be tuned on anything else.
  wasHelpful        Boolean?
  webSources        Json? // [{title, link}] for web search results
  /// The articles offered on a `redirect` turn — the reply itself is empty, so without this
  /// the history row renders as a question with a blank answer.
  redirectArticles  Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([userId, conversationId, createdAt])
  @@index([articleSlug])
  @@index([categorySlug])
  @@index([industrySlug])
  @@index([wasHelpful])
  @@index([createdAt])
  @@map("chatbot_messages")
}

// ============================================
// CLIENT/ORGANIZATION MODELS
// ============================================

// ---- Client-page presentation (embedded composite types, MongoDB) ----
// Stored ON the Client document (read-together, bounded, no independent lifecycle).
// JSON-LD: services→OfferCatalog · teamMembers→employee:Person[] · credentials→hasCredential.

type ClientServiceItem {
  title       String
  description String?
  icon        String? // lucide icon name (optional)
}

type ClientTeamMember {
  name     String
  role     String?
  bio      String?
  photoUrl String? // Cloudinary
}

type ClientAchievement {
  value       String // e.g. "12+", "98%"
  label       String // e.g. "سنة خبرة" (≤52 chars)
  image       String? // Bunny CDN (reels): clients/{id}/achievements/*.webp
  description String? // story paragraph (≤250 chars)
}

type ClientCredential {
  name      String // e.g. "ISO 9001"
  authority String? // issuing body
  year      String?
  url       String? // proof / certificate link
}

model Client {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId // wiil use as unique for gtm integration
  name      String
  slug      String  @unique
  legalName String? // Schema.org Organization
  url       String? // Organization website

  // Media (optional for backward compatibility, required in form UI)
  logoMediaId      String? @db.ObjectId
  logoMedia        Media?  @relation("ClientLogoMedia", fields: [logoMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  heroImageMediaId String? @db.ObjectId
  heroImageMedia   Media?  @relation("ClientHeroImageMedia", fields: [heroImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Schema.org Organization - Social profiles
  sameAs String[] // LinkedIn, Twitter, Facebook URLs

  // Contact
  email String
  phone String? @unique

  // Security
  password String? // Hashed password for client authentication

  // SEO
  seoTitle       String?
  seoDescription String?
  description    String? // Schema.org Organization description (separate from seoDescription)

  // Business Information
  businessBrief     String? // Business description for content writers
  industryId        String?   @db.ObjectId // Industry/category
  industry          Industry? @relation(fields: [industryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Sales — the rep (Staff with role SALES) who brought & manages this client.
  salesRepId        String?   @db.ObjectId
  salesRep          Staff?    @relation("StaffSalesClients", fields: [salesRepId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Editor — the content writer (Staff with role EDITOR) responsible for this
  // client's articles. Informational only: the schema.org author stays Modonty.
  editorId          String?   @db.ObjectId
  editor            Staff?    @relation("StaffEditorClients", fields: [editorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  targetAudience    String? // Target audience description
  contentPriorities String[] // Key topics/priorities

  // Contact Point (Schema.org)
  contactType String? // customer service, technical support, sales, etc.

  // Address (for Local SEO)
  addressStreet     String?
  addressCity       String?
  addressCountry    String?
  addressPostalCode String?

  // Saudi Arabia & Gulf Identifiers (CRITICAL)
  commercialRegistrationNumber String? // CR Number - CRITICAL
  vatID                        String? // VAT registration number (ZATCA)
  taxID                        String? // Tax identification number (ZATCA/Zakat)
  legalForm                    String? // Entity type: LLC, JSC, Sole Proprietorship, Partnership, etc.

  // Address Enhancement (National Address Format)
  addressRegion                String? // Province/region (Saudi has 13 regions)
  addressNeighborhood          String? // Neighborhood/district (National Address)
  addressBuildingNumber        String? // Building number (National Address)
  addressAdditionalNumber      String? // Additional number (National Address)
  addressLatitude              Float?  // Geographic latitude for GeoCoordinates
  addressLongitude             Float?  // Geographic longitude for GeoCoordinates

  // Classification & Business Info
  businessActivityCode         String? // Local business activity classification code
  isicV4                       String? // International Standard Industrial Classification (V4)
  numberOfEmployees            String? // Employee count (QuantitativeValue as string)
  // (Deprecated 2026-05-24: licenseNumber + licenseAuthority moved to Client.ymylData JSON, owned by YMYL system)

  // Additional Properties
  alternateName                String? // Alternative names (Arabic name, trade name, etc.)
  slogan                       String? // Company slogan/motto
  newsletterCtaText            String? // Custom newsletter CTA text on article page (MB1)
  keywords                     String[] // Keywords for classification
  knowsLanguage                String[] // Languages: ["Arabic", "English"]
  organizationType             String? // Subtype: Organization, Corporation, LocalBusiness, NonProfit, etc.

  // Organization Relationships
  parentOrganizationId         String? @db.ObjectId // Parent company reference

  // Twitter Cards
  // (Twitter cache fields moved to nextjsMetadata)

  // Canonical URL
  canonicalUrl String?

  // GBP
  gbpProfileUrl String?
  gbpPlaceId    String?
  gbpAccountId  String?
  gbpLocationId String?
  gbpCategory   String?

  // Business Details
  priceRange                String?
  openingHoursSpecification Json?

  // Subscription Management
  /// **سقط `subscriptionTier` (١٧ سبتمبر ٢٠٢٦).**
  ///
  /// كان `SubscriptionTier` إلزاميّاً على العميل، ثمّ صار اختياريّاً ليكشف المترجمُ
  /// قرّاءَه، ثمّ سقط: قيس على نسخةِ الإنتاج فوُجد **صفرُ كاتبٍ وصفرُ قارئ** — ثمانيةُ
  /// مواضعَ باقيةٍ في الشيفرة كلُّها تعليقاتٌ تشرح سقوطَه. وباقةُ العميل تُقرأ اليوم من
  /// الطلب الساري (`CheckoutOrder.planName`).
  ///
  /// ومونغو لا يحذف ما في المستندات حين يسقط الحقلُ من السكيما — القيمُ الاثنتان
  /// والأربعون باقيةٌ في القاعدة، مهجورةً، تُنظَّف في الترحيل.
  subscriptionTierConfigId String? @db.ObjectId // Reference to tier config
  subscriptionTierConfig SubscriptionTierConfig? @relation("ClientTierConfig", fields: [subscriptionTierConfigId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// **بداية احتساب الاشتراك** — من هذا اليوم تُعدّ المدّة المشتراة وأشهر الهدية.
  /// عرضٌ لا مصدر: تُنسخ من `CheckoutOrder.serviceStartedAt` للطلب الساري، لا من يوم التفعيل.
  ///
  /// كان زرّ التفعيل يكتب فيه `new Date()` — فيأكل من العميل مدّة التجهيز كلّها ويقصّر
  /// اشتراكه بقدرها. صار يوم التفعيل له حقله `activatedAt` أدناه (خالد ١٦ سبتمبر ٢٠٢٦:
  /// «في تاريخ على التفعيل وفي تاريخ على بداية احتساب الاشتراك»).
  ///
  /// الاسم لم يتغيّر عن قصد: العشرون موضعاً التي تعرضه تعرضه بوصفه «بداية الاشتراك»،
  /// وهو ما صار عليه فعلاً — فصحّت بلا لمس.
  subscriptionStartDate DateTime?
  /// **يوم الدفع وفتح الحساب** — ومنه نبدأ التجهيز: البروفايل التجاريّ · الموقع · الداتا ·
  /// الكونسول. وهذه المدّة **على حسابنا**، لا تُحسب على العميل: شغلنا نحن لا خدمتُه هو.
  ///
  /// يُكتب في `activate-client.ts`، وقيمته للعملاء السابقين تأتي بلا تخمين — ما في
  /// `subscriptionStartDate` اليوم هو حرفيّاً ما كتبه زرّ التفعيل.
  activatedAt           DateTime?
  subscriptionEndDate   DateTime?
  articlesPerMonth      Int? // Calculated from tier (can be overridden manually)
  /// **حقلٌ متقاعد — مصدرُ ترحيلٍ لا غير (١٧ سبتمبر ٢٠٢٦).**
  ///
  /// لا يقرؤه ولا يكتبه سطرٌ واحد في التطبيقات الأربعة. الموضعُ الوحيد الذي يلمسه
  /// هو `admin/app/api/dev/rebuild-orders` — وهو يبني منه الطلباتِ للعملاء القدامى،
  /// ويرفض أيّ قاعدةٍ غير `modonty_dev`. فلا سبيلَ لأن يمسّ الإنتاج.
  ///
  /// كان يقول مدّةَ الاشتراك، وقيس على بيانات الإنتاج فخالف المبلغَ المدفوع في
  /// **٢٣ من ٢٨** عميلاً. المدّةُ اليوم `CheckoutOrder.paidMonths` — رقمٌ دُفع مقابلَه.
  billingCycle          String?            @default("annual") // "monthly" | "annual"
  subscriptionStatus    SubscriptionStatus @default(PENDING)
  /// **سقط `paymentStatus` (١٧ سبتمبر ٢٠٢٦).**
  ///
  /// كان يقول أدفع العميلُ أم لا، وهو **لا يُكتب فيه «متأخّر» في أيّ مسارٍ بالمستودع
  /// كلِّه** — يُكتب «مسدَّد» عند التفعيل ويبقى. فقيس على بيانات الإنتاج: ٢٦ عميلاً
  /// بلا فاتورةٍ واحدة مكتوبٌ عليهم «مسدَّد»، وهي شارةٌ يراها العميلُ في بوّابته.
  ///
  /// والحالةُ اليوم تُحسب من الفواتير: `admin/lib/clients/payment-state/`. و«بلا فواتير»
  /// حالةٌ ثالثةٌ لا تُطوى في «مسدَّد» — مَن لم تُصدَر له فاتورةٌ ليس مسدِّداً ولا متأخّراً.
  /// و`Invoice.paymentStatus` يبقى: هو المصدر.
  ///
  /// ومونغو لا يحذف ما في المستندات حين يسقط الحقلُ من السكيما — القيمُ باقيةٌ مهجورةً.

  /// **الطلب الساري** — أيّ صفقةٍ تحكم هذا العميل الآن. منه تُقرأ الباقة والسعر والمدّة
  /// والمندوب والعملة، وينتقل عند كل ترقيةٍ وتجديد إلى الطلب الجديد بينما يبقى القديم في
  /// السجلّ بسعره القديم — فيتّضح تاريخ العميل الماليّ بدل أن يُدهَس.
  ///
  /// موضعه على الكرت لا على الطلب: حقلٌ واحد لا يمكن أن يحمل قيمتين، أمّا علامةٌ «ساري»
  /// على الطلب فيمكن أن يحملها طلبان معاً وقاعدة البيانات لا تمنع ذلك.
  ///
  /// **بلا `@relation` عن قصد** (MONEY-FLOW القسم ٨، الاحتمال ٦ المعتمد): الجدولان منفصلان،
  /// والعميل يُؤرشَف لا يُحذَف — فلا حاجة لقيدٍ يجعلهما متعلّقين ببعضهما.
  activeOrderId         String?            @db.ObjectId

  // ── الأرشفة: العميل المنتهي يختفي من القوائم، وماله في مكانه، ويرجع متى شئنا ──────────
  // نفس منطق `Invoice.archivedAt` القائم: المستند الماليّ لا يُحذف مع من صدر له، والسنة
  // المالية تبقى مقفولة ولو رحل العميل. والأرشفة أقوى من «الحذف مع فحص»: الفحص يمنعك مرّةً
  // واحدة ثمّ لو تجاوزتَه ضاع الأمر، والأرشفة لا تحتاج قراراً صعباً أصلاً.
  // خالد ١٦ سبتمبر ٢٠٢٦: «ما في حذف، حيكون في أرشفة، وإذا في بيانات ماليّة تفضل فاتورته».
  //
  // ويسبق الأرشفةَ فحصٌ يقول ما على العميل: كم له طلب؟ كم فاتورة؟ فيه غير مسدّدة؟
  // والظهور على مدونتي يتبع هذا الحقل لا حالةَ الاشتراك — فصفحة الشريك تبقى بعد الانتهاء
  // (مقالاته على نطاقنا، وإخفاؤها يكسر روابط ويضيّع ترتيباً بُني في شهور).
  archivedAt            DateTime?
  archivedReason        String?
  archivedByUserId      String?            @db.ObjectId
  /// **حقلٌ متقاعد — مصدرُ ترحيلٍ لا غير (١٧ سبتمبر ٢٠٢٦).**
  ///
  /// لا يقرؤه ولا يكتبه سطرٌ واحد في التطبيقات الأربعة. الموضعُ الوحيد الذي يلمسه
  /// هو `admin/app/api/dev/rebuild-orders` — وهو يبني منه الطلباتِ للعملاء القدامى،
  /// ويرفض أيّ قاعدةٍ غير `modonty_dev`. فلا سبيلَ لأن يمسّ الإنتاج.
  ///
  /// كان دفعةَ التأسيس: رقمٌ بلا عملة (تُشتقّ من نصّ البلد) ولا تاريخِ دفع (يُؤخذ
  /// يومُ إنشاء الصفّ). وصارت على `CheckoutOrder.totalMinor` بعملتها ويومِ دفعها.
  /// وقيس التطابقُ قبل التبديل: مجموعُ الأرصدة ١٠٤٬٣٣٥ = مجموعُ الطلبات ١٠٤٬٣٣٥.
  openingBalance        Float?
  // Platform's own / demo accounts (مدونتي, جبر, بسيطة…). Free by nature — excluded from
  // every billing, renewal and money counter so they never appear as "expired" or
  // "unpaid". Admin-controlled via a checkbox on the client edit form. OPTIONAL on
  // purpose: legacy docs predate the field, so `isSet` (Mongo) must stay available to
  // tell "not internal" (absent/false) from the handful marked true.
  isInternal            Boolean?           @default(false)

  // Presentation — featured "premium" partner spotlight. Manual admin toggle
  // (suggested for active annual subscribers). Drives the «شركاء مميّزون» section,
  // the badge, the hero slider, and priority ordering on the public site.
  isFeatured            Boolean            @default(false)

  /// **موثَّق** — شارة التوثيق على مدونتي. خانةٌ يضعها الأدمن بيده، لا تُستنتج.
  ///
  /// خالد ١٧ سبتمبر ٢٠٢٦: «أي عميل يشترك معانا يأخذ علامة الموثّق، لأنّنا ما نسجّله إلّا
  /// بعد ما نتأكّد من أوراقه الرسميّة» — فوجودُ العميل عندنا هو نفسه شهادةُ الفحص.
  ///
  /// `@default(true)` لذلك: الخانة تُشال للاستثناء لا تُوضع للقاعدة. وهي تحلّ العملاء
  /// القائمين بلا ترحيل — الحقل غائبٌ في مستنداتهم، ومونغو يقرأ الغائب بالافتراضيّ.
  ///
  /// ولماذا خانةٌ لا اشتقاق: `commercialRegistrationNumber` و`verificationImageUrl`
  /// بياناتٌ **يدخلها العميل بنفسه**، فامتلاؤها لا يعني أنّ أحداً راجعها. هذه شهادةُ فحصٍ
  /// منّا، لا حقلُ بيانات منه.
  ///
  /// وهي غير `isFeatured`: تلك قرارٌ تسويقيّ (سلايدر «الشركاء المميّزون»)، وهذه شهادةُ
  /// أوراق. لا تُشتقّ إحداهما من الأخرى.
  ///
  /// قبلها كانت تُحسب في ثلاثة مواضع بمنطقين متناقضين: صفحة الشريك تقبل
  /// `commercialRegistrationNumber || legalName || verificationImageUrl`، والقوائم والبحث
  /// يقرآن `subscriptionTier === PRO || PREMIUM`. فعميلٌ بسجلٍّ تجاريّ وباقةٍ رخيصة كان
  /// يظهر موثَّقاً في صفحته وغيرَ موثَّق في القائمة. والآن مصدرٌ واحد يقرأه الثلاثة.
  isVerified            Boolean            @default(true)

  /// Does the client see the «مجدولة» tab in their console articles page — the queue of
  /// articles our team has scheduled but not published yet?
  ///
  /// Defaults to TRUE because that tab has been live for every client since it was built;
  /// starting at false would silently take away something they already see. The switch is
  /// therefore a way to HIDE it from a particular client (a nervous one who reads an
  /// unpublished date as a promise), not a way to unlock it.
  ///
  /// Read only to decide whether to render the tab — never used in a `where` filter. That
  /// matters: existing documents predate the field, so the key is simply ABSENT in Mongo,
  /// and an absent key matches neither `true` nor `false` in a query. Reading it back
  /// returns the default, which is exactly what those clients should get.
  showSchedule          Boolean            @default(true)

  // ============================================
  // Publishing to the client's own website
  // ============================================

  /// Is this client allowed to receive articles on their OWN website instead of
  /// modonty.com? Admin-only switch on the client edit form. Turning it on is
  /// what auto-generates `apiKey`, and it cannot be turned on while
  /// `articlesBaseUrl` is empty.
  canPublishToOwnSite Boolean @default(false)

  /// Where the client's articles live on their own domain, e.g.
  /// "https://jbrseo.com/articles". Every canonical URL, `mainEntityOfPage`,
  /// `og:url` and internal link of that client's articles is built from it.
  /// Changing it triggers a background rebake of all their articles.
  articlesBaseUrl String?

  /// Read-only API key handed to the client's website. Plaintext on purpose —
  /// it grants read access to articles that are about to be public anyway, and a
  /// hash would make «show me my key» impossible. One key per client, no expiry;
  /// a lost key is replaced by us on request, not self-served.
  /// Format: "mdk_" + 32 random bytes, base64url.
  apiKey           String?
  apiKeyCreatedAt  DateTime?
  apiKeyLastUsedAt DateTime? // Last successful call — a silent integration shows up here
  apiKeySuspended  Boolean   @default(false) // Admin kill-switch; the key stays, the service stops

  // Metadata
  foundingDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Modonty user who owns/manages this client (for notifications e.g. contact reply)
  userId String? @db.ObjectId
  user   User?   @relation("ClientOwner", fields: [userId], references: [id], onDelete: SetNull)

  // ============================================
  // JSON-LD Knowledge Graph
  // ============================================
  jsonLdStructuredData   String?   @db.String // Cached @graph JSON string (source of truth)
  jsonLdLastGenerated    DateTime? // When JSON-LD was last generated
  jsonLdValidationReport Json? // {adobe: {valid, errors, warnings}, custom: {...}, richResults: {...}}
  
  // Complete Meta Tags Object
  nextjsMetadata              Json?     // Cached Next.js Metadata object (title, description, openGraph, twitter, robots)
  nextjsMetadataLastGenerated DateTime? // When metadata was last generated

  // Client Notification Preferences
  notificationPreferences Json? // { articlePublished, articleApproved, commentsNew, supportReplies }

  // ============ Telegram Integration ============
  telegramChatId           String?   // chat_id بعد ما يتم الربط
  telegramPairingCode      String?   // كود 6 أرقام للربط
  telegramPairingExpiresAt DateTime? // الكود ينتهي بعد 10 دقائق
  telegramConnectedAt      DateTime? // وقت اكتمال الربط
  telegramEventPreferences Json?     // { commentNew: true, articleView: false, ... } — 26 event toggle

  // ============ Primary CTA («احجز الآن») — admin-controlled ============
  ctaMode  ClientCtaMode @default(NONE) // NONE | FORM | LINK
  ctaLabel String?                      // the text actually rendered — the client's own wording, or the picked button's
  ctaUrl   String?                      // mode=LINK only (https / wa.me / tel:)
  // Which button from Settings → Dropdown Lists this client is on. Kept so the picker still
  // shows the chosen button after the admin rewords it for this client: the WORDING lives in
  // ctaLabel, the IDENTITY lives here. Deliberately not a relation — deleting a button must
  // never touch a client, whose resolved mode/label/url keep working untouched.
  ctaPresetId String? @db.ObjectId

  // Content-responsibility acknowledgement (acceptance proof; editable text lives on Settings)
  disclaimerAcceptedAt       DateTime?
  disclaimerAcceptedByUserId String?   @db.ObjectId
  disclaimerAcceptedVersion  Int? // snapshot of Settings.disclaimerVersion at accept time

  // Unified Intake — single JSON home for all content/SEO strategy answers
  // Replaces the scattered fields below + the SeoIntake model (Phase 2 will remove them).
  intake          Json?      // { voice, audience, goals, policy, technical, business, story, customers, strategy, competition, ymylReviewer, version }
  intakeUpdatedAt DateTime?
  intakeUpdatedBy String?    // userId who last edited the intake

  // SEO Intake & Strategy (static/config - dynamic data in related tables)
  technicalProfile           Json?   // { platform?, stagingUrl?, hreflang?, cacheType? }
  seoGoals                   Json?   // { primaryGoal?, kpis?, successMetrics?, timeline? }
  seoMetrics                 Json?   // { domainAuthority?, backlinkCount?, lastUpdated? }
  linkBuildingPolicy         String?
  brandGuidelines            Json?   // { tone?, voice?, colors?, dosAndDonts? }
  contentTone                String?
  complianceConstraints      Json?   // { industry?, restrictedClaims?, needsReview? }
  googleBusinessProfileUrl   String?
  forbiddenKeywords          String[]
  forbiddenClaims            String[]
  competitiveMentionsAllowed Boolean?

  // YMYL (Your Money Your Life) verification — admin-controlled per client.
  // When isYmyl=true, ymylCategory determines which JSON shape applies to ymylData
  // (see admin/lib/seo/ymyl-config.ts). Drives form rendering, publish gates, and
  // JSON-LD output (MedicalClinic / LegalService / FinancialService).
  isYmyl        Boolean @default(false)
  ymylCategory  String? // "medical" | "legal" | "financial"
  ymylData      Json?   // shape varies per ymylCategory — see ymyl-config.ts

  // The partner's site look (header/footer/colour/blocks) lives on its own row — ClientSite.
  site ClientSite?

  // ============ Client Page (mini-site presentation) ============
  //
  // The intro video, twice over — on purpose, for as long as the migration takes.
  //
  // `introVideoUrl` is what five clients have today: a bare link to YouTube, Facebook or
  // Google Drive, on somebody ELSE's channel. Google credits that video to the host, the
  // client cannot edit or delete it, and two of the five links do not even play. It stays
  // readable so nobody's page goes dark mid-migration, and it is cleared the moment its
  // replacement lands.
  //
  // `introVideoMedia` is where it goes: our own file on Bunny, carrying the title,
  // description, cover and duration that a valid VideoObject needs — which is why the
  // schema.org output for this video has been switched off until now.
  introVideoUrl        String? // legacy external link — read-only, cleared on upload
  introVideoMediaId    String? @db.ObjectId
  // NoAction on both, exactly like logoMedia/heroImageMedia above: Client→Media→Client is
  // a referential cycle, and Prisma refuses any other action on it.
  introVideoMedia      Media?  @relation("ClientIntroVideoMedia", fields: [introVideoMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verificationImageUrl String?             // صورة التوثيق (سجل/ترخيص) — from the client's media library (Bunny), displayed on page (admin-controlled)
  services             ClientServiceItem[] // OfferCatalog
  teamMembers          ClientTeamMember[]  // employee: Person[]
  achievements         ClientAchievement[] // stats counters
  credentials          ClientCredential[]  // hasCredential

  // Relationships
  articles          Article[]
  subscribers       Subscriber[]
  // الإحالات التي رفعها هذا العميل. الاتجاه واحد: العميل مُحيلٌ لا مُحالٌ إليه —
  // المُرشَّح ليس عميلاً بعد، وحين يصير عميلاً يُسجَّل معرّفه في `convertedClientId`.
  referralLeads     ReferralLead[] @relation("ClientReferralLeads")
  media             Media[]      @relation("ClientMedia")
  parentOrganization Client?     @relation("ClientParent", fields: [parentOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subOrganizations  Client[]     @relation("ClientParent")

  // Interaction relations
  comments        ClientComment[]
  clientFaqs      ClientFAQ[]
  reviews         ClientReview[]
  likes           ClientLike[]
  dislikes        ClientDislike[]
  favorites       ClientFavorite[]
  views           ClientView[]
  shares          Share[]
  conversions       Conversion[]
  ctaClicks         CTAClick[]
  leadScoring       LeadScoring[]
  campaignTracking  CampaignTracking[]
  engagementDuration EngagementDuration[]
  contactMessages  ContactMessage[]
  notifications    Notification[]
  mobileDevices    MobileDevice[]
  bookingRequests  BookingRequest[]

  // SEO Intake relations
  seoIntakes     SeoIntake[]
  competitors    ClientCompetitor[]
  targetKeywords ClientKeyword[]

  // Campaign sales lead (from teaser CTA)
  campaignInterest CampaignInterest?

  // Notes the operations manager pushed to the content team's Telegram about this client.
  clientNotifications ClientNotification[]

  // Billing
  invoices Invoice[]

  @@index([industryId])
  @@index([userId])
  @@index([createdAt])
  @@index([apiKey]) // Bearer auth on the client-site read endpoint resolves the owner by key
  @@map("clients")
}

// ============================================
// PARTNER SITE — the partner's look, one row per client
// ============================================

/// What the partner chose in the console «إعدادات الموقع» + page screens. Every field is a
/// KEY into a code registry (shared/components/partner-site/free/…): the component is
/// code, this row is the choice. One row per client, named columns (Khalid 2026-08-18:
/// «صفّ واحد متّفقين») — no key/value rows, no catalog. Absent row = all defaults.
model ClientSite {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  clientId String @unique @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  headerTemplate String   @default("classic") // HEADER_TEMPLATES key
  footerTemplate String   @default("columns") // FOOTER_TEMPLATES key
  primaryColor   String? // palette hex; null = modonty's colour
  hiddenSections String[] // block keys the partner switched OFF (any page); a new block is visible by default
  /// `<label>.modonty.com`, validated by shared validateSubdomain.
  ///
  /// NOT `@unique`, on purpose. `@unique` builds a PLAIN unique index, and MongoDB indexes a
  /// missing field as null — so only ONE row may be without a subdomain. Reproduced on dev
  /// 2026-08-30: the second partner to save his site's look got
  /// `P2002 target: client_sites_subdomain_key` for a field he never touched, because another
  /// row already held the null. (Prisma's "NULLs are distinct" note covers relational
  /// databases only, and its MongoDB schema has no sparse/partial index syntax.)
  ///
  /// Uniqueness is still enforced by the database — a PARTIAL unique index that indexes real
  /// strings only, created outside the schema because Prisma's MongoDB schema cannot express it:
  ///     db.client_sites.createIndex({subdomain:1},
  ///       {unique:true, name:"client_sites_subdomain_partial_unique",
  ///        partialFilterExpression:{subdomain:{$type:"string"}}})
  /// Verified on dev 2026-08-30: two rows without a subdomain coexist, and two rows claiming
  /// the same label are rejected with P2002 on `client_sites_subdomain_partial_unique`, which
  /// `saveMySite` turns into «هذا الاسم مستخدم — جرّب غيره».
  ///
  /// ⚠️ The index must be created on production too, or the same P2002 hits the second partner
  /// there. `prisma db push` does NOT create it — it is not in this schema.
  subdomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_sites")
}

/// Booking / lead requests from the «احجز الآن» / «اترك رقمك» CTA. Two channels (see `channel`):
/// FORM (phone callback, login required → name/email snapshotted from session) or WhatsApp
/// (tracked click, anonymous). `source` = the surface it came from (article_dock/card/client_page/list).
model BookingRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  articleId   String?  @db.ObjectId // null when booked from client page / listing (not an article)
  article     Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  userId      String?  @db.ObjectId // SetNull on account deletion — snapshot below preserves the lead
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  source      String // article_dock | article_card | client_page | client_list
  // Lead channel: "form" = «اترك رقمك» callback (has phone) · "whatsapp" = tracked WhatsApp
  // click (anonymous — no phone; the conversation happens on WhatsApp itself).
  channel     String   @default("form")
  name        String? // snapshot from session (null for whatsapp leads)
  email       String? // snapshot from session (null for whatsapp leads)
  phone       String? // collected by the form (null for whatsapp leads)
  preferredAt DateTime? // free-text preferred time now lives in `message`; kept for legacy
  confirmedAt DateTime? // appointment time the provider CONFIRMS from the console
  message     String?
  status      String   @default("new") // new | contacted | done | archived
  // Visitor identity (from getVisitorContext) — powers whatsapp-lead dedup:
  // one whatsapp lead per (visitorId × clientId × sessionId). Also useful analytics.
  visitorId   String?
  sessionId   String?
  // Geo snapshot from Vercel headers (x-vercel-ip-*) — shown on the whatsapp lead row.
  country     String?
  city        String?
  ipAddress   String?
  userAgent   String?
  // YMYL liability acknowledgment — true when the visitor ticked the disclaimer
  // (required for isYmyl clients; false otherwise). Recorded as proof of consent.
  disclaimerAccepted   Boolean   @default(false)
  disclaimerAcceptedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([clientId, channel]) // console filter: form vs whatsapp
  @@index([clientId, channel, visitorId, sessionId]) // whatsapp-lead dedup lookup
  @@index([userId])
  @@index([status])
  @@map("booking_requests")
}

// ============================================
// SEO INTAKE MODELS
// ============================================

model SeoIntake {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  answers     Json     // Full questionnaire answers by section
  collectedAt DateTime @default(now())
  collectedBy String?  // User/system who collected

  @@index([clientId])
  @@map("seo_intakes")
}

model ClientCompetitor {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  clientId String  @db.ObjectId
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  url      String?
  notes    String?
  order    Int     @default(0)  // Display/priority order

  @@index([clientId])
  @@map("client_competitors")
}

model ClientKeyword {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  clientId String  @db.ObjectId
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyword  String
  intent   String? // transactional | informational | commercial
  priority Int     @default(0)
  reason   String?

  @@index([clientId])
  @@map("client_keywords")
}

// ============================================
// CAMPAIGN INTEREST — sales leads from teaser CTA
// ============================================

enum CampaignReach {
  OWN      // own newsletter subscribers
  INDUSTRY // subscribers from same industry across modonty
  FULL     // entire modonty subscriber base
}

enum CampaignInterestStatus {
  NEW       // just submitted, awaiting team contact
  CONTACTED // team reached out
  CONVERTED // client booked/paid for a campaign
  CANCELLED // client declined or unresponsive
}

model CampaignInterest {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  clientId String @unique @db.ObjectId // one record per client (Idempotency: subsequent clicks update reach)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  reach  CampaignReach
  source String?       // which CTA was clicked: "hero" | "tier-own" | "tier-industry" | "tier-full" | "final-cta"

  status CampaignInterestStatus @default(NEW)

  assignedTo   String?   @db.ObjectId // User handling this lead
  notes        String?                 // admin notes (history of reach changes appended automatically)
  contactedAt  DateTime?
  convertedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("campaign_interests")
}

// ============================================
// SUBSCRIPTION TIER CONFIG
// ============================================

model SubscriptionTierConfig {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId

  // ─── Step A (compatibility — تُحذف Step B بعد refactor الـ 52 ملف) ───
  tier            SubscriptionTier @unique
  price           Float
  articlesPerMonth Int
  name            String
  isActive        Boolean          @default(true)
  isPopular       Boolean          @default(false)
  description     String?
  createdAt       DateTime         @default(now())

  // ─── Jbrseo integration (Round 6) ───
  jbrseoId        String?         @unique          // "free" | "starter" | "growth" | "scale"
  pricing         Json?                            // { SA: { mo, yr }, EG: { mo, yr } }
  articleCounts   Json?                            // global mapping: { اسم الباقة: عدد المقالات }
  syncedAtSA      DateTime?
  syncedAtEG      DateTime?

  updatedAt       DateTime        @updatedAt

  // Relationships
  clients         Client[]        @relation("ClientTierConfig")

  @@map("subscription_tier_configs")
}

// ============================================
// COMMERCIAL CATALOG — public plans and market-specific prices
// ============================================
// Deliberately separate from SubscriptionTierConfig: the latter is an internal
// operational tier enum, while this catalog must let the business add, retire,
// price, and order sellable plans without a code change.

enum CommercialPlanTheme {
  NEUTRAL
  PRIMARY
  ACCENT
  PREMIUM
}

model CommercialPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
    name        String
    articlesPerMonth Int?
    highlights  String[]
  badge       String?
  /// سطر خاطف واحد يظهر قرب السعر — «٦ شهور مجاناً مع السنة» (PAY-G11).
  /// واحد لا قائمة: جملتان خاطفتان ليستا أقوى، بل لا خاطفة.
  hook        String?
  /// نصّ زرّ هذه الباقة. فارغاً يسقط على النصّ الافتراضي في المكوّن — فباقة جديدة
  /// تُرسم صحيحة بلا تعبئة، ولا يبقى النصّ حبيس الكود لمن أراد تغييره.
  ctaText     String?
  /// شارة ثانية تميّز بطاقةً واحدة عن أخواتها («الأكثر اختياراً»). وجودها يرفع البطاقة
  /// بصرياً أيضاً — فهي وسمٌ وتمييزٌ معاً، كما عند جبر سيو (`featured = !!featuredBadge`).
  featuredBadge String?
  /// سقط `tier` (١٧ سبتمبر ٢٠٢٦). كان يربط الباقة بفئةٍ من الإنم، وهو ما حبس
  /// الكتالوج في **أربع باقاتٍ للأبد**: الإنم أربعُ قيم، وحارسُ النشر كان يمنع
  /// باقتين منشورتين على القيمة الواحدة. وُلد لأنّ `slug` كان هاشاً لا يصلح
  /// مفتاحاً مقروءاً؛ فلمّا صار السلَق ذا معنى (`intilaqa` · `zakham` · `riyada`)
  /// وهو `@unique`، سقط الوسيطُ وسقط معه السقف.
  theme       CommercialPlanTheme @default(NEUTRAL)
  isPublished Boolean  @default(false)
  displayOrder Int    @default(0)
  prices      CommercialPlanPrice[]
  features    CommercialPlanFeature[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, displayOrder])
  @@map("commercial_plans")
}

model CommercialFeature {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  /// الوحدة تُطبع بعد الكمّية («١٢ مقال/شهر»). قائمة مغلقة في الأدمن لا كتابةً حرّة
  /// (خالد ١٤ سبتمبر ٢٠٢٦) — الكتابة اليدوية أنتجت «مقال/شهر» و«مقال / شهر» و«مقالات»
  /// لنفس المعنى، وحساب الإجمالي يميّز الوحدات الشهرية بـ«/شهر» فاختلاف مسافةٍ يُسقط الرقم.
  unitLabel   String?
  isActive    Boolean  @default(true)
  /// سطرٌ يستحقّ أن يُرى قبل غيره — يُطبع عريضاً على بطاقة الباقة (خالد ١٤ سبتمبر ٢٠٢٦).
  /// قرارُ تسويقٍ لا تصنيفُ محتوى، فمكانه المكتبة حيث تُعرَّف الميزة مرّة.
  isHighlighted Boolean @default(false)
  /// هل تنزل هذه الميزة في الفاتورة؟ (خالد ١٣ سبتمبر ٢٠٢٦: «نعمل شيك اللي يطلع في الفاتورة»)
  ///
  /// البطاقة تعرض كل مزايا الباقة — هذا تسويق. والفاتورة مستند **التزام**: كل سطر فيها
  /// شيءٌ يستطيع العميل أن يطالب به ونستطيع أن نثبت تسليمه. فما لا يُثبت لا ينزل —
  /// «محتواك جاهز للذكاء الاصطناعي» جاهزيّةٌ عند طرفٍ ثالث، و«طلّات» تُقرأ وصولاً،
  /// و«تنبيهات» تتبع أحداثاً قد لا تقع.
  ///
  /// افتراضها `false`: ميزةٌ جديدة لا تدخل مستنداً قانونياً حتى يقرّر إنسانٌ أنها تُثبَت.
  /// وموضعها المكتبة لا الإسناد: الميزة تُعرَّف مرّة وتُستعمل في كل الباقات، فلا يتناقض
  /// حكمُها بين باقةٍ وأخرى.
  billable    Boolean  @default(false)
  displayOrder Int     @default(0)
  assignments CommercialPlanFeature[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("commercial_features")
}

model CommercialPlanFeature {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  planId    String            @db.ObjectId
  plan      CommercialPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String            @db.ObjectId
  feature   CommercialFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)
  quantity  Int?
  note      String?
  displayOrder Int            @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([planId, featureId])
  @@index([planId, displayOrder])
  @@map("commercial_plan_features")
}

model CommercialPlanPrice {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  planId      String         @db.ObjectId
  plan        CommercialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  market      String         // SA | EG; market is selected by the request proxy
  currency    String         // SAR | EGP
  // Major unit base price. Checkout will snapshot and convert the final amount
  // to a provider-specific minor unit; never use a Float for money.
  monthlyBase Int
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([planId, market])
  @@index([market, isActive])
  @@map("commercial_plan_prices")
}

/**
 * كلام صفحة البيع حول البطاقات — صفّ واحد لكل سوق (PAY-G13).
 *
 * لماذا: البطاقات صارت من القاعدة، لكن كل ما حولها (عنوان القسم، شريط إعلان عرض، عناصر
 * الثقة) لا مكان له — ولو تُرك لكُتب في الكود، وهو ما تمنعه بطاقة PAY-DYNAMIC: نصف بطاقة
 * جبر سيو مكتوب في الكود، فتغيير كلمة فيه نشرة كاملة.
 *
 * حقول مسمّاة لا Json: نظير جبر سيو (`PriceSectionMeta`) يخزّن `trustItems` و`uiStrings`
 * ككتل Json — وهو نفس نمط `LandingSection { data: Json }` الذي هجره هو نفسه حين قسّم
 * الأسعار إلى صفوف. كتلة Json تقبل أي شكل، فلا يحرسها مخطّط ولا يكشف كسرَها إلا الزائر.
 *
 * `uiStrings` لم يُنقل عمداً: كلمات البطاقة الثابتة («/ شهر» · «شهر خدمة») قليلة ويحكمها
 * تصريفٌ عربي في الكود (`formatMonths`) — جعلها نصّاً في القاعدة يفتح باب كسر اللغة بلا
 * حارس. تُفتح بندٌ مستقلّ إن طُلبت.
 */
model PaySectionContent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  /// SA | EG — صفّ واحد لكل سوق، والسوق يختاره البروكسي حسب الدولة.
  market       String   @unique
  /// شريط أعلى الصفحة: «العرض ينتهي نهاية الشهر». فارغاً لا يُرسم الشريط أصلاً.
  announcement String?
  headline     String?
  subheadline  String?
  /// أسطر «من ائتمنّا» القصيرة. مصفوفة نصّ لا Json — نفس نمط `CommercialPlan.highlights`.
  trustItems   String[]

  // ─── نصوص البيع التي كانت مكتوبة في الكود (PAY-G20) ───
  // خالد ١٣ سبتمبر ٢٠٢٦: «ضيفهم ونحرّرهم من الأدمن». كلّها ادّعاءات تجارية أو قانونية
  // تتغيّر بتغيّر السوق والمزوّد — فبقاؤها في الكود يجعل تعديل كلمة نشرةً كاملة.
  /// «شامل ضريبة القيمة المضافة ١٥٪» — ادّعاء عن قانون السوق، لا يُخمَّن لسوق غير مقيس.
  vatNote            String?
  /// «قسّطها على دفعات» — فارغاً لا يظهر زرّ التقسيط أصلاً (تمارا ترفض مصر).
  installmentLabel   String?
  /// «استرداد ١٤ يوم — لو ما فعّلنا حسابك» — وعدٌ يخصّ الاشتراك لا طريقة الدفع.
  refundNote         String?
  /// حاشية أسفل الشبكة وسطرها الثاني (اسم البوّابة وشهادتها).
  paymentFootnote    String?
  paymentFootnoteSub String?
  /// أسماء شعارات الدفع من القائمة المغلقة في `shared/lib/commercial/pay-mark-names.ts`.
  payMarks           String[]
  /// شعار التقسيط وحده — يُفصل لأن التقسيط شركة مستقلّة بعقدها لا بوّابتنا.
  installmentMark    String?

  /// ── قسم الفريق على صفحة التصفّح (خالد ١٥ سبتمبر ٢٠٢٦) ──
  /// عنوانه وسطره — وهما نصّا بيعٍ كبقيّة نصوص هذه الصفحة، فمكانهما هنا لا الكود.
  ///
  /// وسببٌ ثانٍ أخصّ: الصياغة الأولى كانت «فريقٌ باسمه ووجهه»، ووصفها خالد بأنها
  /// **تقلّل الثقة** — وهو محقّ: جملةٌ تعلن أننا نثبت أننا حقيقيّون تزرع الشكّ الذي
  /// تنفيه، كلافتةٍ مكتوبٍ عليها «هذا ليس نصباً». والوجوه تعمل صامتةً، والسطر يقول
  /// ما يفعله الفريق لا أنه موجود. ونصٌّ كهذا يُضبط بالتجربة، فيجب أن يتغيّر بلا نشرة.
  ///
  /// فارغين يسقطان على نصٍّ افتراضيّ في المكوّن — فالقسم يُرسم صحيحاً قبل أن يُملأ.
  teamHeadline    String?
  teamSubheadline String?

  updatedAt    DateTime @updatedAt

  @@map("pay_section_content")
}

/** Single duration policy shared by every plan — see PAY-Q3 (one policy, not one row per plan). */
model CommercialTermPolicy {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  paidMonths        Int      @unique
  bonusServiceMonths Int     @default(0)
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  /// The duration /pay opens on, marked «الأنسب» (PAY-G8). At most ONE row may hold it —
  /// enforced in `setRecommendedCommercialTerm`, which clears the others in the same
  /// transaction. Two recommendations are not a stronger hint, they are none at all.
  ///
  /// jbrseo hard-codes this (`RECOMMENDED_DURATION = 6` in lib/pricing-durations.ts), so
  /// moving the recommendation is a deploy there. Here it is a row.
  isRecommended     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("commercial_term_policies")
}

// ============================================
// CHECKOUT — an order is a SNAPSHOT, never a reference (PAY-P2 · PAY-AV-SNAPSHOT)
// ============================================
// jbrseo's `Subscriber` mixed buyer, payment attempt and customer in one row keyed by
// (email, plan, billing), so a repeat purchase overwrote the previous order, and its
// success page recomputed the total from TODAY's price. Here the order carries every
// term it was sold under; changing or deleting the plan afterwards cannot touch it.
// Money is in MINOR units (halala / piastre) as Int — never Float.

enum CheckoutOrderStatus {
  AWAITING_PAYMENT  // Saudi — gateway session opened, waiting for the provider
  AWAITING_TRANSFER // Egypt — buyer transfers by hand, staff confirms (PAY-Q12)
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  NGENIUS
  TAMARA
  BANK_TRANSFER
  /// إنستا باي (مصر) — قناةُ تحويلٍ يدويّ كالبنكيّ، يؤكّدها موظّفٌ يرى وصول المبلغ.
  /// كانت تُعرض للمشتري وتُسجَّل `BANK_TRANSFER` فلا أثرَ لها (خالد ١٨ سبتمبر ٢٠٢٦: «مهمّة جدّاً»).
  INSTAPAY
  /// طلبٌ مُرحَّل من بيانات العميل القديمة — الترحيلُ نفسه يكتب معاملةً بهذا المزوّد
  /// (خالد ١٨ سبتمبر ٢٠٢٦: «المفروض الترحيل هو اللي يكتب، عشان لو فيه بوّابة مو شغّالة
  /// نكون عارفين إنّ فيه خلل»). فطلبٌ مدفوعٌ بلا معاملةٍ أصلاً = عطلٌ حقيقيّ لا حالةٌ طبيعيّة.
  MIGRATED
}

model CheckoutOrder {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  /// Human order number, gapless per year via `Counter` (key `order-YYYY`): ORD-2026-00042.
  /// Also sent to the provider as the merchant reference.
  number String @unique

  market   String // SA | EG
  currency String // SAR | EGP

  // ── Buyer ─────────────────────────────────────────────────────────────────────
  buyerName    String
  buyerEmail   String
  buyerPhone   String // E.164 via shared/lib/phone
  businessName String?
  country      String?

  // ── Plan snapshot — deliberately NO relation: deleting the plan must not cascade here
  planId           String?           @db.ObjectId
  planSlug         String
  planName         String
  /// سقط `planTier` (١٧ سبتمبر ٢٠٢٦): كان يُكتب في سبعة مواضع ويُقرأ في **صفر**.
  /// اللقطةُ تحمل `planSlug` و`planName`، وهما ما يُعرَض ويُبحَث به — والفئةُ كانت
  /// وسيطاً وُلد لأنّ سلَق الباقة كان هاشاً بلا معنى، فسقط بسقوطه.
  articlesPerMonth Int?

  /// ما وُعد به المشتري، مجمَّداً لحظة الشراء — سطرٌ لكل ميزة كما قرأها على البطاقة
  /// («٨٤ مقال على مدونتي» · «نظام حجوزات احجز الآن»).
  ///
  /// مُخزَّنٌ هنا لا مقروءٌ من الكتالوج وقت إصدار الفاتورة: الباقة تتغيّر — تُضاف ميزة
  /// أو تُنقص كمّية — والفاتورة مستندُ التزامٍ يجب أن يقول ما اتُّفق عليه يومها لا ما
  /// صارت عليه الباقة اليوم. وهو نفس سبب تجميد السعر في الحقول أعلاه (PAY-AV-SNAPSHOT).
  ///
  /// نصوصٌ جاهزة لا معرّفات: حذفُ ميزةٍ من الكتالوج بعد سنة يجب ألّا يُفرغ سطراً في
  /// فاتورةٍ صادرة.
  planCommitments  String[]

  // ── Price snapshot (minor units) ────────────────────────────────────────────────
  monthlyBaseMinor   Int
  paidMonths         Int
  bonusServiceMonths Int
  subtotalMinor      Int
  vatRateBp          Int // basis points: 1500 = 15%
  vatMinor           Int
  totalMinor         Int // what the buyer pays = monthlyBase × paidMonths (VAT-inclusive, PAY-Q7)

  // ── State ──────────────────────────────────────────────────────────────────────
  status       CheckoutOrderStatus
  paidAt       DateTime?
  failedReason String?

  /// **بداية فترة هذا الطلب** — ومنها تُحسب `paidMonths + bonusServiceMonths`، فتُعرف النهاية.
  ///
  /// موضعها هنا لا على المقال (خالد ١٦ سبتمبر ٢٠٢٦: «عميل بكرته وبعد كذا ترانزاكشن زي
  /// الحسابات العاديّة»): الطلب سطرٌ في دفتر العميل، والسطر يحمل تاريخه. والطلب هو من يقول
  /// المدّة أصلاً — فهو من يقول متى بدأت. أمّا المقال فحدثٌ يُطلق الكتابة، لا مكانُ تخزينها.
  ///
  /// **من يملؤها:**
  /// · الطلب الأوّل للعميل — يوم يصله أوّل مقال على الكونسول (`AWAITING_APPROVAL`)، لا يوم
  ///   الدفع: مدّة التجهيز بعد الدفع شغلنا نحن لا خدمتُه هو. تُكتب مرّةً واحدة ولا تُعاد،
  ///   ولو ردّ المقال للتعديل ثمّ رجع.
  /// · طلب التجديد — من نهاية الفترة السابقة، فيتّصل الاشتراك بلا فجوة ولا تداخل.
  ///
  /// وهي تُغني عن سلسلة `??` في `create-invoice.ts` التي تتحايل اليوم على غياب هذا الحقل:
  /// `client.subscriptionEndDate ?? firstPublished?.datePublished ?? now`.
  ///
  /// فارغة = الطلب مدفوعٌ ولم تبدأ خدمته بعد — وهي بذاتها إشارةُ «طلبٌ نائم» (البند ٦).
  serviceStartedAt DateTime?
  /// **يومُ تفعيل هذا الطلب** — لا يومُ إنشائه ولا يومُ بدء الخدمة.
  ///
  /// كان على العميل وحده (`Client.activatedAt`)، والعميلُ يُجدّد: فطلبُ السنة الثانية
  /// له تفعيلُه الخاصّ، وحقلٌ واحدٌ على الكرت يمحو الأوّل. فالحدثُ يخصّ الطلب لا الكرت،
  /// و`Client.activatedAt` يصير عرضاً من الطلب الساري كما صارت الباقةُ والحصّة.
  ///
  /// خالد ١٧ سبتمبر ٢٠٢٦: «تاريخ الأكتيفيشن وتاريخ أوّل أرتيكل المفروض يكونوا موجودين
  /// برضو في الطلب». وأوّلُ مقالٍ **لا يُخزَّن هنا**: يُحسب من
  /// `MIN(Article.firstDeliveredAt)` — تخزينُه يخلق مصدراً ثانياً يكذب أوّلَ ما يُعدَّل مقال.
  activatedAt      DateTime?

  // ── Manual confirmation (Egypt) — who said the money arrived, when, by which reference
  /**
   * ملاحظة داخليّة على الطلب — يكتبها الموظّف، ولا تُعرض للعميل ولا تُطبع على
   * الفاتورة (خالد ١٥ سبتمبر ٢٠٢٦: «لو في أي ملاحظات على الطلب هذا»).
   *
   * موضعها على الطلب لا على العميل: الملاحظة تخصّ صفقةً بعينها («حوّل نصفه
   * والباقي بعد أسبوع»)، والعميل قد يكون له عشر صفقات.
   */
  /**
   * من باع هذا الاشتراك — يُملأ في الطلب اليدويّ وينتقل إلى العميل عند التفعيل.
   *
   * موضعه على الطلب لا على العميل وحده: العمولة تخصّ صفقةً بعينها، وقد يجدّد
   * للعميل مندوبٌ غير الذي باعه أوّل مرّة. وفارغٌ لطلبات صفحة الدفع — الزائر يشتري بلا مندوب.
   *
   * خالد ١٥ سبتمبر ٢٠٢٦ — والمقيس على الإنتاج: ٢٠ عميلاً من ٤١ بلا مندوب.
   */
  salesRepId        String? @db.ObjectId
  notes             String?
  transferReference String?
  transferDate      DateTime?
  confirmedByUserId String?   @db.ObjectId
  confirmedAt       DateTime?

  // ── What came after (PAY-Q6): the client account and the invoice issued from this order
  clientId  String? @db.ObjectId
  invoiceId String? @db.ObjectId
  /// **من أي عميلٍ محتمَل جاء هذا الطلب** — يُملأ حين يُفتح الطلب من /sales-leads.
  ///
  /// كان تحويلُ المحتمَل يسأل الموظّف «اختر الباقة» ويكتبها على الكرت مباشرةً — بابُ
  /// ميلادٍ ثالث بفلوسٍ مكتوبةٍ باليد، لا طلبَ وراءها ولا مبلغَ مدفوع. صار التحويل
  /// يفتح طلباً حقيقيّاً، ومن الطلب يُولد العميل بزرّ «فعّل» نفسه.
  ///
  /// ومنه يُختَم SalesLead.convertedClientId لحظةَ التفعيل، فيُقفل خطُّ الرحلة:
  /// محتمَل ← طلبٌ مدفوع ← عميل. وبلا @relation عن قصد — نفس قاعدة activeOrderId:
  /// الجدولان منفصلان، وحذفُ محتمَلٍ لا يمسّ طلباً ماليّاً.
  leadId    String? @db.ObjectId

  transactions PaymentTransaction[]
  attempts     PaymentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([buyerEmail])
  @@map("checkout_orders")
}

model PaymentTransaction {
  id      String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId String        @db.ObjectId
  order   CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          PaymentProvider
  providerOrderRef  String? // the provider's own order id (N-Genius order reference)
  providerReference String? // settlement / transfer reference shown to humans
  status            String // provider-native status, kept verbatim
  amountMinor       Int
  currency          String
  rawStatus         String?
  settledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([providerReference])
  @@map("payment_transactions")
}

/// Idempotency for provider callbacks: the same providerEventId is stored once and any
/// repeat returns 200 without touching the order (PAY-KEEP: منع التكرار).
model PaymentWebhookEvent {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  provider        PaymentProvider
  providerEventId String          @unique
  orderId         String?         @db.ObjectId
  eventType       String?
  payload         Json
  receivedAt      DateTime        @default(now())
  processedAt     DateTime?
  error           String?

  @@map("payment_webhook_events")
}

/// The stage a payment died at. Closed list, not free text: a free-text stage turns the
/// failures screen into a pile of near-duplicate strings nobody can count.
/// `validate` · `session` · `3ds` happen in the BROWSER before any order exists.
enum PaymentAttemptStage {
  validate      // تحقّق مدخلات المشتري في المتصفّح
  session       // توليد جلسة الدفع عند المزوّد
  create_order  // إنشاء الطلب عندنا
  auth          // تفويض البطاقة
  three_ds      // التحقّق الثنائي
  poll          // الاستعلام الاحتياطي عن الحالة
  webhook       // ما وصل من المزوّد
}

enum PaymentAttemptOutcome {
  failed
  declined
  timeout
  error
}

/// Failure intelligence. NEVER card data beyond the BIN (first six digits).
///
/// Widened 13 Sep 2026 (PAY-G14). The five-field version could only describe a failure
/// that already had an order, so the most likely failure in our market — a foreign or
/// Egyptian card rejected at tokenization, in the browser, BEFORE an order exists — left
/// no trace at all. jbrseo hit exactly this and answered it with sixteen fields plus a
/// browser endpoint; the fields below are that lesson, not an invention.
///
/// PRIVACY: `cardBin` is the first SIX digits only. It identifies the ISSUING BANK AND
/// COUNTRY — which is the whole question behind "why do foreign cards fail?" — and cannot
/// identify a cardholder. No PAN, no CVV, no holder name, ever. The test for anything
/// added here: could this row appear in a leak without harming the person it describes?
model PaymentAttempt {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  /// Null for a failure that happened before an order was created — the case that used
  /// to vanish. Do not make this required again.
  orderId  String?        @db.ObjectId
  order    CheckoutOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider PaymentProvider
  reasonCode String?
  message    String?
  createdAt  DateTime @default(now())

  // ─── PAY-G14 ───
  stage      PaymentAttemptStage?
  outcome    PaymentAttemptOutcome?
  /// The provider's own payment state, verbatim (e.g. DECLINED / FAILED) — kept raw
  /// because its vocabulary is theirs and mapping it here would lose detail.
  state      String?
  /// What was being bought, snapshotted as plain values: the plan may be renamed or
  /// retired later, and a failure log that follows a live row stops describing the past.
  planSlug   String?
  paidMonths Int?
  market     String?
  /// visa | mastercard | mada — how the card is routed, which is often the failure itself.
  cardScheme String?
  /// First SIX digits only. See PRIVACY above.
  cardBin    String?
  /// Set only when the buyer had already typed it; a failure with no email is still logged.
  email      String?
  ip         String?
  userAgent  String?
  /// The provider's reference for this attempt, when one was issued before it failed.
  providerRef String?

  @@index([orderId])
  @@index([createdAt])
  @@index([stage])
  @@index([market])
  @@map("payment_attempts")
}

// ============================================
// JBRSEO SUBSCRIBERS MIRROR — سقط ١٧ سبتمبر ٢٠٢٦
// ============================================
// كان مرآةً لمجموعة `Subscriber` في جبر سيو، تُملأ بزرّ مزامنةٍ في تبويب `/clients`.
// وتكامُلُ جبر سيو أُلغي من أوّله، فبقي التبويبُ يعرض ٢٧ صفّاً لنظامٍ لم يعد يُستعمل
// (خالد ١٧ سبتمبر: «لغيناه من أوّل، فهذه سقطت في الجرد»).
//
// والأخطر أنّه كان **بابَ ميلادٍ رابعاً** للعميل: `convertSubscriberToClientAction`
// يصنع عميلاً من مشترِكٍ ويختار له الباقة من الكتالوج — بلا طلبٍ مدفوع، فيتجاوز
// المصدرَ الذي قام عليه هذا الريفاكتور كلُّه.
//
// سقط معه ٩٣٠ سطراً في سبعة ملفّات. ولا حقلَ على `Client` كان يشير إليه، فلم يُيتَّم
// أحد. والصفوفُ الـ٢٧ تبقى في مونغو مهجورةً — إسقاطُ الموديل لا يحذف بيانات.

// ============================================
// EMAIL EVENTS (Resend webhook tracking)
// ============================================
// Generic, reusable log of Resend email events (delivered, opened, clicked, bounced...).
// Linked to an entity via tags sent with the email (clientId + emailType). No formal
// relation — query by clientId directly (same pattern as conversion tracking).
model EmailEvent {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  emailId   String                         // Resend data.email_id
  type      String                         // delivered | opened | clicked | bounced | sent | complained | delivery_delayed
  recipient String?                        // data.to[0]
  subject   String?
  emailType String?                        // our tag: e.g. "client-welcome"
  clientId  String?   @db.ObjectId         // our tag: which client this email was about
  eventAt   DateTime?                      // Resend data.created_at (when the event happened)
  createdAt DateTime  @default(now())       // when we received the webhook

  @@index([emailId])
  @@index([clientId])
  @@index([type])
  @@index([emailType])
  @@map("email_events")
}

// ============================================
// AUTHOR MODELS
// ============================================

model Author {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String // Schema.org Person
  slug String @unique

  // Schema.org Person - Name fields
  firstName String? // Schema.org givenName
  lastName  String? // Schema.org familyName

  // Schema.org Person - E-E-A-T fields
  jobTitle String? // WorksFor job title
  worksFor String? @db.ObjectId // Organization/Client reference
  bio      String?
  image    String? // Profile image
  imageAlt String? // Alt text for profile image (accessibility + SEO)
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  imageMediaId String? @db.ObjectId
  imageMedia   Media?  @relation("AuthorImageMedia", fields: [imageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  url      String? // Author page URL
  email    String? // Schema.org email - Contact email (optional, privacy-sensitive)

  // Social profiles for verification (sameAs)
  linkedIn String?
  twitter  String?
  facebook String?
  sameAs   String[] // Additional social profiles

  // E-E-A-T Signals
  credentials        String[] // Degrees, certifications
  qualifications     String[] // Professional qualifications
  expertiseAreas     String[] // Topics of specialization (knowsAbout)
  experienceYears    Int?
  verificationStatus Boolean  @default(false)
  memberOf          String[] // Schema.org memberOf - Professional organizations (E-E-A-T authoritativeness)

  // Education (optional structured data)
  education Json? // Array of education objects

  // SEO
  seoTitle       String?
  seoDescription String?
  socialImage    String? // Cloudinary URL (w_1200,h_630,c_fill,q_auto,f_auto)
  socialImageAlt String? // Alt text
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  socialImageMediaId String? @db.ObjectId
  socialImageMedia   Media?  @relation("AuthorSocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cloudinaryPublicId String? // Cloudinary public_id for direct deletion
  canonicalUrl   String?

  // === SEO Cache - Standard Pattern ===
  nextjsMetadata              Json?
  nextjsMetadataLastGenerated DateTime?
  jsonLdStructuredData        String?   @db.String
  jsonLdLastGenerated         DateTime?
  jsonLdValidationReport      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  articles         Article[] @relation("ArticleAuthor")
  reviewedArticles Article[] @relation("ArticleReviewer")

  @@map("authors")
}

// ============================================
// CONTENT MODELS
// ============================================

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  description String?
  parentId    String? @db.ObjectId // Hierarchical categories

  // SEO
  seoTitle       String?
  seoDescription String?
  socialImage    String? // Cloudinary URL (w_1200,h_630,c_fill,q_auto,f_auto)
  socialImageAlt String? // Alt text
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  socialImageMediaId String? @db.ObjectId
  socialImageMedia   Media?  @relation("CategorySocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cloudinaryPublicId String? // Cloudinary public_id for direct deletion
  canonicalUrl   String?

  // === SEO Cache - Standard Pattern ===
  nextjsMetadata              Json?
  nextjsMetadataLastGenerated DateTime?
  jsonLdStructuredData        String?   @db.String
  jsonLdLastGenerated         DateTime?
  jsonLdValidationReport      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  articles Article[]
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryHierarchy")

  @@index([parentId])
  @@map("categories")
}

model Tag {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  description String?

  // SEO
  seoTitle       String?
  seoDescription String?
  socialImage    String? // Cloudinary URL (w_1200,h_630,c_fill,q_auto,f_auto)
  socialImageAlt String? // Alt text
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  socialImageMediaId String? @db.ObjectId
  socialImageMedia   Media?  @relation("TagSocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cloudinaryPublicId String? // Cloudinary public_id for direct deletion
  canonicalUrl   String?

  // === SEO Cache - Standard Pattern ===
  nextjsMetadata              Json?
  nextjsMetadataLastGenerated DateTime?
  jsonLdStructuredData        String?   @db.String
  jsonLdLastGenerated         DateTime?
  jsonLdValidationReport      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  articles ArticleTag[]

  @@map("tags")
}

model Industry {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  description String?

  // SEO
  seoTitle       String?
  seoDescription String?
  socialImage    String? // Cloudinary URL (w_1200,h_630,c_fill,q_auto,f_auto)
  socialImageAlt String? // Alt text
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  socialImageMediaId String? @db.ObjectId
  socialImageMedia   Media?  @relation("IndustrySocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cloudinaryPublicId String? // Cloudinary public_id for direct deletion
  canonicalUrl   String?

  // === SEO Cache - Standard Pattern ===
  nextjsMetadata              Json?
  nextjsMetadataLastGenerated DateTime?
  jsonLdStructuredData        String?   @db.String
  jsonLdLastGenerated         DateTime?
  jsonLdValidationReport      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  clients    Client[]
  faqs       IndustryFAQ[]
  salesLeads SalesLead[]

  @@map("industries")
}

/// One embedded slice of an article, stored so Modo never re-embeds the same immutable text.
/// Before this existed, every single question re-chunked and re-embedded up to 30 full articles
/// at request time — the largest line on the bill, and it grew with the corpus rather than with
/// revenue. Cohere's own guidance is embed-once-at-ingest, embed-only-the-query-at-request.
///
/// `contentHash` is the invalidation key: when an article's text changes the hash changes, the
/// old rows stop matching, and the chunks are rebuilt on the next question.
model ArticleChunk {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Position within the article, so chunks can be replayed in reading order.
  chunkIndex Int
  /// The chunk text exactly as it was embedded — the reranker and the model read this, not the article.
  text       String
  /// embed-multilingual-v3.0 returns 1024 floats.
  embedding  Float[]
  /// Hash of the source text this chunk was derived from.
  contentHash String
  /// "article" = a slice of the article body · "faq" = a partner's published answer.
  /// Both live here because they are embedded and searched identically; only their source differs.
  /// Optional on purpose: rows written before this column exist without it, and in Mongo an
  /// absent field cannot be matched by value. Optional lets the query use `isSet` instead of
  /// forcing a backfill over the whole cache.
  kind        String? @default("article")

  createdAt DateTime @default(now())

  @@index([articleId, chunkIndex])
  @@index([articleId, contentHash])
  @@index([articleId, kind])
  @@map("article_chunks")
}

/// Questions visitors asked Modo that no article answers, published on the industry page.
/// Khalid's call (2026-08-18): the industry page already lists the partners who serve that
/// need, so an answer landing there sits directly above the people who can be booked — and
/// it fills a page measured at 1232 characters of mostly navigation.
/// Mirrors ArticleFAQ/ClientFAQ so the admin review screen is the same in all three.
model IndustryFAQ {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  industryId String   @db.ObjectId
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  question String // Schema.org Question
  answer   String? // Empty until reviewed and answered
  position Int     @default(0)
  status   ArticleFAQStatus @default(PENDING) // reuse the existing enum

  /// How many visitors asked essentially this — the demand signal that ranks the content backlog.
  askedCount Int @default(1)

  submittedByName  String?
  submittedByEmail String?
  source           String? @default("manual") // "manual" | "chatbot" | "user"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industryId, position])
  @@index([industryId, status])
  @@index([status, askedCount])
  @@map("industry_faqs")
}

/// Permanent (308) redirects served by proxy.ts for merged/renamed entity slugs.
/// section = matcher segment (articles|categories|tags|industries|clients).
/// One redirect per (section, fromSlug); target is another live slug in the same section.
/// Google treats 308 ≡ 301 (Search Central) → passes link equity to the successor.
model Redirect {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String
  fromSlug  String
  toSlug    String
  createdAt DateTime @default(now())

  @@unique([section, fromSlug])
  @@map("redirects")
}

model Article {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Optimistic concurrency — user-initiated edits only.
  // System operations (SEO regen, JSON-LD storage, cron) MUST NOT bump this.
  // Only update-article action increments it. Use this (not updatedAt) for conflict detection.
  userVersion Int @default(0)

  // Basic content
  title         String // Schema.org Article headline
  slug          String
  excerpt       String?
  content String // Article body (markdown/HTML)
  audioUrl      String? // Audio version URL (A7)
  // Length of that recording, in whole seconds. Stored rather than read from the file: the
  // listen tab and the /audio shelf both show the duration before anything plays, and without
  // this every article view would range-read the audio just to learn a number — measured on a
  // two-hour recording, that is a 116MB origin hit for a feature most readers never use.
  // Written when the recording is uploaded; null means "not measured yet", never "zero".
  audioDurationSeconds Int?

  // Relationships
  clientId   String    @db.ObjectId
  client     Client    @relation(fields: [clientId], references: [id])
  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId   String    @db.ObjectId
  author     Author    @relation("ArticleAuthor", fields: [authorId], references: [id])

  // YMYL reviewer (required when client.isYmyl=true). Cross-client allowed so
  // freelance specialists can review for multiple clients.
  reviewedById String? @db.ObjectId
  reviewer     Author? @relation("ArticleReviewer", fields: [reviewedById], references: [id])

  // Status & workflow
  status        ArticleStatus @default(WRITING)
  scheduledAt   DateTime?
  featured      Boolean       @default(false)
  revisionNotes String? // Client's feedback when requesting changes (status=NEEDS_REVISION)

  /// متى وصل هذا المقال العميلَ أوّل مرّة — أي أوّل ما صارت حالته `AWAITING_APPROVAL`.
  ///
  /// **إشارةٌ تشغيليّة، لا مرساةُ فوترة.** تجيب عن سؤالٍ يخصّ هذا المقال وحده: «قاعد عند
  /// العميل من كم يوم بلا موافقة؟» — وهو ما لا يقوله أيٌّ من تواريخ هذا الصفّ: `createdAt`
  /// يسبق الوصول، و`datePublished` يتأخّر عنه، و`scheduledAt` قد لا يوجد، و`dateModified`
  /// يُدهَس مع كل تغيير.
  ///
  /// أمّا بداية احتساب الاشتراك فموضعها `CheckoutOrder.serviceStartedAt` — الطلب سطرٌ في
  /// دفتر العميل وهو من يحمل تاريخه، والمقال حدثٌ يُطلق الكتابة هناك لا مكانُ تخزينها
  /// (خالد ١٦ سبتمبر ٢٠٢٦). ولو خُزِّنت هنا لانكسر التجديد: الطلب الثاني كان سيرجع إلى
  /// أوّل مقالٍ في حياة العميل كلّها.
  ///
  /// **يُكتب مرّةً واحدة ولا يُعاد**: العميل قد يردّه للتعديل (`NEEDS_REVISION`) ثمّ يرجع
  /// `AWAITING_APPROVAL` ثانيةً — والوصول الأوّل هو المقصود، لا الأخير.
  firstDeliveredAt DateTime?

  // ============================================
  // Client-site articles («مقالات العملاء»)
  // ============================================

  /// DESTINATION, deliberately separate from `status`. Set once, when the article
  /// is created from the admin's «مقالات العملاء» section — there is no checkbox
  /// and no button that moves an article between sections.
  ///
  /// It drives BAKING, not visibility: when true, `canonicalUrl`,
  /// `mainEntityOfPage`, the JSON-LD card, `og:url` and every internal link are
  /// built from `client.articlesBaseUrl` instead of modonty's domain — from the
  /// very first save, while the article is still a draft. Visibility is the job
  /// of `status: PUBLISHED_ON_CLIENT_SITE`.
  ///
  /// Never used alone in a public `where` filter: existing documents predate the
  /// field, so the key is simply ABSENT in Mongo and matches neither true nor
  /// false. Reading it back returns the default, which is correct for them.
  isClientSiteArticle Boolean @default(false)

  /// The client's ONE main article — the hub every other article of that client
  /// links up to. Marked by the editor, and only for a client who already has at
  /// least four articles (a hub with nothing under it is a thin page).
  isMainArticle Boolean @default(false)

  /// Last time the client's own website actually fetched this article through
  /// the console read endpoint. Absent = never fetched. This is what exposes a
  /// client whose integration broke silently.
  lastFetchedAt DateTime?

  // Schema.org Article - Required fields
  datePublished    DateTime? // ISO 8601
  /// تاريخ تعديل **المحتوى**، وهو ما تقرأه جوجل — لا تاريخ آخر لمسة تقنية على الصفّ.
  ///
  /// كان `@updatedAt`، ومعناه في توثيق Prisma: «automatically refresh the field with the
  /// current timestamp **on record modification**» — أي كل كتابة، ولو لم تمسّ حرفاً من
  /// المقال. وعلى هذا الصفّ ٢٦ موضع كتابة، أغلبها ليس تعديل محتوى: ترحيل بني · منظّف
  /// الكانونيكال · إعادة حساب العدّادات · تغييرات الحالة الأربعة · الأرشفة · عدّاد
  /// التعليقات · قرارات الموبايل. فمقال لم يُمسّ منذ أبريل كان يعلن «حُدِّث اليوم».
  ///
  /// Google · Publication dates: «The dates must describe the publication or update date
  /// of the page, not the stories or events described therein.»
  ///
  /// `@default(now())` لا `@updatedAt`: موضعا إنشاء المقال لا يمرّران قيمة (مقيس ٢٩ أغسطس)،
  /// فحقلٌ إلزاميّ بلا افتراضي كان سيكسر الإنشاء. والتحديث الحقيقي يضبطه `update-article.ts`
  /// صراحةً. والتتبّع التقني له حقله المستقلّ `updatedAt` أدناه.
  dateModified     DateTime  @default(now())
  lastReviewed     DateTime? // Content freshness signal
  mainEntityOfPage String? // Canonical URL

  // Schema.org Article - Extended fields
  wordCount          Int? // Auto-calculated content depth
  readingTimeMinutes Int? // Auto-calculated (~200-250 words/min)
  contentDepth       String? // short, medium, long

  // Meta tags
  seoTitle       String?
  seoDescription String? // 155-160 chars optimal

  // Open Graph (Complete)
  ogArticleAuthor        String?
  ogArticlePublishedTime DateTime?
  ogArticleModifiedTime  DateTime?

  // Technical SEO
  canonicalUrl String?

  // Breadcrumb support
  breadcrumbPath Json? // Array for BreadcrumbList schema

  // Featured media
  featuredImageId String? @db.ObjectId
  featuredImage   Media?  @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // ============================================
  // JSON-LD Knowledge Graph (Phase 1)
  // ============================================

  // JSON-LD Cache & Validation
  jsonLdStructuredData   String?   @db.String // Cached @graph JSON string (source of truth)
  jsonLdLastGenerated    DateTime? // When JSON-LD was last generated
  jsonLdValidationReport Json? // {adobe: {valid, errors, warnings}, custom: {...}, richResults: {...}}

  // Content for structured data
  articleBodyText String? // Plain text extracted from content (for schema.org articleBody)

  // Optional semantic enhancement (for AI crawlers)
  semanticKeywords Json? // Array of {name, wikidataId?, url?} for entity disambiguation

  // E-E-A-T enhancement
  citations String[] // External authoritative source URLs (isBasedOn/citation)

  // Schema versioning (safe rollback)
  // (removed: jsonLdVersion/jsonLdHistory/jsonLdDiffSummary)

  // Performance tracking
  // (removed: jsonLdGenerationTimeMs/performanceBudgetMet)

  // ============================================
  // Next.js Metadata Cache
  // ============================================
  nextjsMetadata Json? // Cached Next.js Metadata object
  nextjsMetadataLastGenerated DateTime? // When metadata was last generated

  // Denormalized interaction counts (updated atomically with each interaction)
  likesCount     Int @default(0)
  dislikesCount  Int @default(0)
  commentsCount  Int @default(0)
  favoritesCount Int @default(0)
  viewsCount     Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  tags        ArticleTag[]
  versions    ArticleVersion[]
  analytics   Analytics[]
  relatedFrom RelatedArticle[] @relation("ArticleRelatedFrom")
  relatedTo   RelatedArticle[] @relation("ArticleRelatedTo")
  faqs        ArticleFAQ[]
  chunks      ArticleChunk[] // Modo's cached embeddings of this article's text
  gallery     ArticleMedia[] // Image gallery for article
  // Reels that PROMOTE this article — a third, distinct meaning next to
  // `featuredImage` (the article's cover) and `gallery` (images inside it).
  reelMedia   Media[]        @relation("MediaReelArticle")

  // Interaction relations
  comments    Comment[]
  likes       ArticleLike[]
  dislikes    ArticleDislike[]
  favorites   ArticleFavorite[]
  views       ArticleView[]
  shares      Share[]
  conversions Conversion[]
  ctaClicks         CTAClick[]
  linkClicks        ArticleLinkClick[]
  campaignTracking  CampaignTracking[]
  engagementDuration EngagementDuration[]
  bookingRequests   BookingRequest[]

  @@unique([clientId, slug]) // Slug unique per client
  @@index([clientId, status, datePublished])
  // Read endpoint for client sites: filter by owner + PUBLISHED_ON_CLIENT_SITE,
  // page with a cursor on updatedAt.
  @@index([clientId, status, updatedAt])
  @@index([status, datePublished])
  @@index([categoryId, status, datePublished])
  @@index([authorId, status, datePublished])
  @@index([dateModified])
  @@index([datePublished])
  @@map("articles")
}

model ArticleVersion {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Snapshot of article data
  title          String
  content        String
  excerpt        String?
  seoTitle       String?
  seoDescription String?

  // Audit trail
  createdBy String?  @db.ObjectId // User ID
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@map("article_versions")
}

model ArticleTag {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  tagId     String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
  @@map("article_tags")
}

// ============================================
// ARTICLE MEDIA GALLERY (Phase 1 - JSON-LD)
// ============================================

model ArticleMedia {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  articleId String @db.ObjectId
  mediaId   String @db.ObjectId

  // Gallery metadata
  position Int     @default(0) // Display order in gallery (drag & drop)
  caption  String? // Per-article caption override (differs from Media.caption)
  altText  String? // Per-article alt text override (for SEO customization)

  // Relationships
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, mediaId])
  @@index([articleId, position])
  @@index([mediaId])
  @@map("article_media")
}

// ============================================
// MEDIA MODELS
// ============================================

model Media {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // File info
  filename String
  url      String // CDN/Storage URL
  mimeType String
  fileSize Int? // Bytes

  // Schema.org ImageObject
  width           Int?
  height          Int?
  encodingFormat  String? // image/jpeg, image/png, etc.
  contentUrl      String?
  thumbnailUrl    String?
  copyrightHolder String?

  // SEO (Critical)
  altText     String? // Required for accessibility and SEO
  caption     String?
  credit      String?
  title       String?
  description String?

  /// متى كتب الذكاء `altText` و`description` لهذه الصورة — و**تُمسح لحظة يعدّلها إنسان**.
  ///
  /// بلا هذا الحقل تصير «المسوّدة المؤقتة» دائمةً بلا توثيق: الدرجة تقفز إلى الأخضر على
  /// كلامٍ آلي، فيُعدّ البند منجزاً وهو لم يُقرأ. وهي نفس العلّة التي عالجناها في لوحة
  /// المهام يوم ٣ سبتمبر — حالةٌ تُعلَن ولا تُكتب في الحقل الذي تقرأه الآلة.
  ///
  /// ويحمل معنىً ثانياً أهمّ: **قفلُ التسمية**. اسم الملف يُشتقّ من `altText`، وإعادة
  /// التسمية على بني نسخٌ ثم حذف يقتل الرابط القديم — فصورةٌ عليها هذا الوسم ممنوعةٌ من
  /// التسمية حتى يقرأها إنسان. القفل في البنية لا في مربّع اختيار يُتخطّى بضغطة.
  ///
  /// تاريخٌ لا Boolean: «متى» تجيب أيضاً على «هل»، وتُظهر المسوّدات التي شاخت بلا مراجعة.
  /// وغيابه في مونجو يعني «كتبها إنسان» — وهو الصحيح لكل صفٍّ سبق هذا الحقل.
  seoDraftedByAiAt DateTime?
  license     String? // License type (CC0, CC-BY, CC-BY-SA, CC-BY-NC, Commercial, All Rights Reserved, Public Domain)
  creator     String? // Creator/Author name
  dateCreated DateTime? // Date when the image was created (from EXIF or manual)

  // Schema.org Enhancement
  geoLatitude     Float? // Geographic latitude
  geoLongitude    Float? // Geographic longitude
  geoLocationName String? // Human-readable location name
  contentLocation String? // Content location (where the image was taken/shows)
  exifData        Json? // Full EXIF metadata stored as JSON

  // Cloudinary Integration
  cloudinaryPublicId  String? // Cloudinary public ID
  cloudinaryVersion   String? // Cloudinary version
  cloudinarySignature String? // Cloudinary signature

  // Bunny Migration (ADDITIVE — dual-read). Does NOT touch `url`.
  // Production keeps reading `url` (Cloudinary) until the controlled switch (Epic 3.5).
  bunnyUrl String? // Bunny CDN URL — populated by Dual-Write (new uploads) + migration script (old assets)

  // Blur placeholder for next/image `placeholder="blur"` — a base64 data URL of a 10px WebP.
  // Next.js requires a DATA URL, never a remote link: it embeds the value as `href` inside an
  // inline SVG served through `background-image`, and browsers block external loads from there
  // (verified in next@16.2.9 `get-img-props.js:508` + `image-blur-svg.js`). ~110-130 chars each.
  // Generated with sharp at every write path — Bunny's optimizer is OFF on all pull zones.
  // Do NOT pre-blur it: Next applies `feGaussianBlur stdDeviation='20'` itself.
  blurDataURL String?

  // Client association (REQUIRED after migration)
  // Temporarily optional to allow querying existing media without clientId
  clientId String? @db.ObjectId
  client   Client? @relation("ClientMedia", fields: [clientId], references: [id], onDelete: Cascade)

  // Scope: CLIENT | GENERAL | PLATFORM
  // Existing records without this field default to GENERAL on read
  scope MediaScope @default(GENERAL)

  // Media type classification
  type MediaType @default(GENERAL)

  // Primary client media roles (centralized; many clients can share same media)
  logoClients      Client[] @relation("ClientLogoMedia")
  heroImageClients Client[] @relation("ClientHeroImageMedia")
  introVideoClients Client[] @relation("ClientIntroVideoMedia")
  // Modonty Core (T2): back-relations for the six platform entities
  authorImages        Author[]   @relation("AuthorImageMedia")
  authorSocialImages  Author[]   @relation("AuthorSocialImageMedia")
  categorySocialImages Category[] @relation("CategorySocialImageMedia")
  tagSocialImages     Tag[]      @relation("TagSocialImageMedia")
  industrySocialImages Industry[] @relation("IndustrySocialImageMedia")
  modontyHeroImages   Modonty[]  @relation("ModontyHeroImageMedia")
  modontySocialImages Modonty[]  @relation("ModontySocialImageMedia")

  // ── Reels (merged 2026-08-05 — the `Reel` table is gone) ─────────────────
  //
  // TWO INDEPENDENT SWITCHES, not one state. An image can sit in the client's
  // gallery AND run as a reel at the same time; it can also be pulled out of the
  // gallery and stay a reel. Neither switch implies the other.
  //
  // `inGallery` defaults to true, but a default does NOT reach rows that already
  // exist — in MongoDB the key is simply ABSENT, and an absent key matches neither
  // `true` nor `null`. Existing rows are filled explicitly in the backfill step;
  // until then no gallery query may read this field, or every gallery renders empty.
  inGallery Boolean @default(true)
  inReels   Boolean @default(false)

  // Reel workflow — null on every file that never entered the reels flow.
  reelStatus          ReelStatus?
  reelUploadedBy      ReelUploader?
  reelRejectionReason String?
  // Standalone watch page. Uniqueness is checked IN CODE: a database unique index
  // would reject the second file that simply has no slug at all.
  reelSlug            String?
  reelApprovedAt      DateTime?
  reelPublishedAt     DateTime? // feed = newest first
  reelRevealedAt      DateTime? // hidden-batch launch — null = still hidden

  /// The article this reel promotes. A third meaning, distinct from
  /// `featuredArticles` (this file is the article's cover) and `articleGallery`
  /// (this file sits inside the article) — which is why it needs its own field.
  reelArticleId String?  @db.ObjectId
  reelArticle   Article? @relation("MediaReelArticle", fields: [reelArticleId], references: [id], onDelete: SetNull)

  // Video reels (Bunny Stream) — full public URLs, modonty holds zero Bunny secrets.
  // Images need none of these: `url` and `thumbnailUrl` above already carry them.
  bunnyVideoId String? // Bunny Stream video GUID
  playbackUrl  String? // HLS playlist
  mp4Url       String? // Google requires a fetchable file (no token auth)
  durationSec  Int? // ≤ 90s locked limit

  transcript       String?
  transcriptStatus ReelTranscriptStatus?

  // Cached counters — TikTok-style rail: like / comment / favorite, no dislike.
  viewsCount     Int @default(0)
  likesCount     Int @default(0)
  commentsCount  Int @default(0)
  favoritesCount Int @default(0)

  // Relationships
  featuredArticles Article[]      @relation("ArticleFeaturedImage")
  articleGallery   ArticleMedia[] // Gallery appearances in articles
  comments         MediaComment[]
  reactions        MediaReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([clientId, createdAt])
  @@index([clientId, type])
  @@index([scope])
  @@index([clientId, scope])
  @@index([filename])
  // Reels — the three that came over from the old table, plus the gallery switch.
  // Without them the feed and the approval queue scan the whole media collection.
  @@index([clientId, reelStatus])
  @@index([reelStatus, reelPublishedAt])
  @@index([reelArticleId])
  @@index([clientId, inGallery])
  @@map("media")
}

// ============================================
// ANALYTICS MODELS
// ============================================

model Analytics {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientId  String? @db.ObjectId

  // User/Session tracking (for unique visitor calculation)
  sessionId String? // Browser session ID (cookie-based)
  userId    String? @db.ObjectId // User ID if logged in

  // Core Web Vitals (2025 Standard) - per view
  lcp  Float? // Largest Contentful Paint (target < 2.5s)
  cls  Float? // Cumulative Layout Shift (target < 0.1)
  inp  Float? // Interaction to Next Paint (target < 200ms) - replaced FID in 2024
  fid  Float? // First Input Delay (legacy, target < 100ms)
  ttfb Float? // Time to First Byte (target < 800ms)
  tbt  Float? // Total Blocking Time (target < 200ms)

  // Engagement metrics - per view
  timeOnPage       Float? // Seconds spent on page for THIS view
  scrollDepth      Float? // Percentage scrolled (0-100) for THIS view
  bounced          Boolean @default(false) // Did user leave immediately? (bounce)
  clickThroughRate Float? // CTR for THIS view (if applicable)

  // Traffic sources - per view
  source         TrafficSource @default(DIRECT) // default was ORGANIC pre-2026-07-07 (misleading)
  searchEngine   String? // Google, Bing, etc.
  referrerDomain String?
  userAgent      String? // Browser user agent
  ipAddress      String? // IP address (for geo-location if needed)

  // Geo - per view (Vercel edge headers: x-vercel-ip-country/-country-region/-city — free, no external API)
  country String? // ISO 3166-1 alpha-2 (SA, EG, ...)
  region  String? // ISO 3166-2 region portion
  city    String? // decoded city name

  timestamp DateTime @default(now())

  @@index([articleId, timestamp])
  @@index([clientId, timestamp])
  @@index([timestamp])
  @@index([sessionId])
  @@index([userId])
  @@map("analytics")
}

// ============================================
// NEWSLETTER MODELS
// ============================================

model Subscriber {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String
  name     String?
  clientId String  @db.ObjectId
  client   Client  @relation(fields: [clientId], references: [id])

  // GDPR compliance
  subscribed     Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  consentGiven   Boolean   @default(false)
  consentDate    DateTime?

  // Preferences
  preferences Json? // Notification preferences

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, clientId])
  @@index([clientId])
  @@map("subscribers")
}

model NewsSubscriber {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  name           String?
  subscribed     Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  consentGiven   Boolean   @default(false)
  consentDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([subscribed])
  @@index([createdAt])
  @@map("news_subscribers")
}

// ============================================
// RELATION MODELS
// ============================================

model ArticleFAQ {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  question String // Schema.org Question
  answer   String? // Optional until client answers (reader submissions)
  position Int // Order in FAQ list
  status   ArticleFAQStatus @default(PENDING) // PENDING until client answers, then PUBLISHED

  submittedByName  String? // Set for reader submissions
  submittedByEmail String? // Set for reader submissions
  source           String? @default("manual") // "manual" | "chatbot" | "user" (CHAT-FAQ2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, position])
  @@index([articleId, status])
  @@map("faqs")
}

model ClientFAQ {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  question String // Schema.org Question
  answer   String? // Optional until client answers (reader submissions)
  position Int // Order in FAQ list
  status   ArticleFAQStatus @default(PENDING) // reuse existing enum — PENDING until answered, then PUBLISHED

  submittedByName  String? // Set for reader submissions
  submittedByEmail String? // Set for reader submissions
  source           String? @default("manual") // "manual" | "chatbot" | "user"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, position])
  @@index([clientId, status])
  @@map("client_faqs")
}

model RelatedArticle {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  articleId String  @db.ObjectId
  relatedId String  @db.ObjectId
  article   Article @relation("ArticleRelatedFrom", fields: [articleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  related   Article @relation("ArticleRelatedTo", fields: [relatedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  relationshipType String? @default("related") // related, similar, recommended

  createdAt DateTime @default(now())

  @@unique([articleId, relatedId])
  @@index([articleId])
  @@index([relatedId])
  @@map("related_articles")
}

// ============================================
// INTERACTION MODELS
// ============================================

model Comment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Content
  content String // Comment text

  // Relationships
  articleId String @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId // Optional - allow anonymous comments
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Reply support (nested comments)
  parentId String? @db.ObjectId // If null, it's a top-level comment
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  // Status & Moderation
  status   CommentStatus @default(PENDING) // PENDING, APPROVED, REJECTED, DELETED
  isEdited Boolean       @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime? // When comment was last edited

  // Relationships for interactions
  likes    CommentLike[]
  dislikes CommentDislike[]

  @@index([articleId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@map("comments")
}

model ArticleLike {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId // Optional - allow anonymous likes
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional: session-based tracking for anonymous users
  sessionId String? // Browser session ID for anonymous likes

  createdAt DateTime @default(now())

  // Ensure one like per user per article
  @@unique([articleId, userId])
  @@unique([articleId, sessionId]) // For anonymous users
  @@index([articleId])
  @@index([userId])
  @@map("article_likes")
}

model ArticleDislike {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // For anonymous users

  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@unique([articleId, sessionId])
  @@index([articleId])
  @@index([userId])
  @@map("article_dislikes")
}

model ArticleFavorite {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId // Required - favorites need user account
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
  @@map("article_favorites")
}

model CommentLike {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  commentId String  @db.ObjectId
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // For anonymous users

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@unique([commentId, sessionId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

model CommentDislike {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  commentId String  @db.ObjectId
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // For anonymous users

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@unique([commentId, sessionId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_dislikes")
}

model ArticleView {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId // Optional - logged in users
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Anonymous tracking
  sessionId String? // Browser session ID
  ipAddress String? // IP address for unique visitor tracking

  // Metadata
