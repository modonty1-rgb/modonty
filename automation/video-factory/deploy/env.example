# /opt/video-factory/.env  (chmod 600) — names only, values never in git
GEMINI_API_KEY=            # AI Studio, project modonty (Tier 1)
ANTHROPIC_API_KEY=         # NEW key for the factory only (decision D23), from the Anthropic console
RADAR_ADMIN_URL=https://admin.modonty.com
RADAR_INGEST_SECRET=       # same value as the admin on Vercel (header x-radar-secret)
BUNNY_REELS_STORAGE_ZONE_NAME=
BUNNY_REELS_STORAGE_PASSWORD=
BUNNY_REELS_PULL_ZONE_HOSTNAME=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_PREFIX=video-factory # folder in modonty-reels-media (tests used video-factory-dev)
# switches — all off on a fresh install: the factory only makes files and stops before the admin
INGEST_ENABLED=0           # 1 after the admin side (/api/videos/*, /videos) is in production
PUBLISH_ENABLED=0          # 1 to publish approved items to YouTube
TELEGRAM_ENABLED=0         # destination decided in a separate session with Khalid
TELEGRAM_BOT_TOKEN=
TELEGRAM_VIDEO_CHAT_ID=
WATCH_BACKFILL=0           # 1 = queue the feed's existing articles on the first watch
MAX_PER_DAY=6
