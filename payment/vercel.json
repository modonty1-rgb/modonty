{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @modonty/payment build",
  "installCommand": "pnpm install --filter @modonty/payment...",
  "framework": "nextjs",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- ./ ../shared ../pnpm-lock.yaml ../package.json"
}
