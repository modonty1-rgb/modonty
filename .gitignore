# Dependencies
node_modules/
.pnp
.pnp.js

# Lockfiles (only root should have pnpm-lock.yaml in monorepo)
**/pnpm-lock.yaml
!pnpm-lock.yaml

# Build outputs
.next/
out/
dist/
build/

# Test logs
logs/

# Environment files
.env
.env*.local
.env.production
.env.shared
!.env.shared.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma (generated client)
node_modules/.prisma/

# Testing
coverage/
.nyc_output/

# Database backups (local only — never push to git)
backups/

# Misc
*.pem


# Playwright MCP snapshots
.playwright-mcp/
*.png
# Brand favicon assets — tracked despite the *.png ignore above
!modonty/app/apple-icon.png
!brand/favicon/*.png
!modonty/public/trust/*.png
.vercel

# نسخ احتياطية يخلّفها سكربت تدقيق الأيقونات (scripts/refresh-icon-inventory.mjs).
# دخلت الكوميت مرّة سهواً — سبعة ملفّات لا كود فيها ولا وثيقة.
*.bak

# مخزن pnpm المحلّي — يُبنى من pnpm-lock.yaml، ولا يدخل المستودع أبداً.
.pnpm-store/

# نسخة حالة Claude المحليّة — ٧٬٧٢٥ ملفّاً على قرص خالد، لا علاقة لها بالمشروع.
# كانت تجعل VS Code يعرض «7K+» على Source Control فيختفي فيها كل تغيير حقيقي
# (خالد ١٤ سبتمبر ٢٠٢٦). تبقى على القرص ولا تدخل git ولا العدّاد.
backup/

# ولاحقةُ النسخ قبل التعديل: task-data.json.bak-before-x — النمط `*.bak` لا يطابقها،
# فالنجمة لا تمتدّ إلى ما بعد «bak». وبقيت ٤٣ نسخة تُحسب في عدّاد VS Code.
*.bak-*

# سكربتات القياس المؤقّتة ونواتجها. تُكتب لفحصٍ واحد ثم ينتهي غرضها، ونتيجتها
# تُسجَّل على اللوحة دليلاً خاماً — فالسكربت نفسه لا يضيف شيئاً. وإبقاؤها أخطر من
# حذفها: مكتوبة لحالة يومها (منفذ ٣٠٠١ · مسارات تغيّرت · app/(pay) لم يعد موجوداً)،
# فتشغيلها اليوم يعطي جواباً خاطئاً بثقة. مكانها الصحيح مجلّد مؤقّت خارج المستودع.
__tmp-*

# لقطات الشاشة في جذر المستودع — أدلّة بصرية للحظتها، تُلصق في الرد أو اللوحة ثم
# ينتهي غرضها. القيد على الجذر وحده (/) فلا يمسّ صور المشروع في public/ و.playwright-mcp.
# قياس قبل الإضافة: صفر لقطة متتبَّعة في الجذر.
/*.png
/*.jpg
/*.jpeg

# مجلّد المؤقّت الوحيد (خالد ١٤ سبتمبر ٢٠٢٦: «حطّ مجلّد واحد… ما تحطّ لي أي حاجة
# في الروت»). كل لقطة وسكربت قياس وسجلّ يسقط فيه، ولا يصل git ولا عدّاد VS Code.
# وREADME وحده يبقى ليعرف القادم القاعدة.
scratch/*
!scratch/README.md
