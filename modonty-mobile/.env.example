# عنوان خادم مدونتي الذي يخدم /api/mobile/v1 — بلا شرطة أخيرة.
# لا قيمة احتياطية في الكود: غيابه يُظهر شاشة «الإعداد ناقص» بدل الاتصال بعنوان لم يختره أحد.
# التطوير المحلي على جهاز أندرويد: عنوان جهازك على الشبكة، مثل http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=

# عنوان موقع مدونتي على الويب — يُفتح منه «عن مدونتي» و«الخصوصية» و«الشروط» لأن /api/mobile/v1
# لا يملك نقطة للصفحات الثابتة بعد (C20). ومنه يُبنى رابط المشاركة لمقال.
EXPO_PUBLIC_WEB_URL=

# دخول Google على الجوّال: معرّف عميل الويب (يُصدر idToken بجمهور يقبله الخادم GOOGLE_CLIENT_ID)،
# ومعرّف عميل iOS ومخطّطه المعكوس لبناء iOS. ليست أسراراً، لكنها خاصّة بالمشروع فلا تُكتب في الكود.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# مشروع EAS — يحتاجه توكن Expo Push.
EXPO_PUBLIC_EAS_PROJECT_ID=
