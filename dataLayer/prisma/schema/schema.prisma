/// Customer review of a CLIENT's service — stars + text, one per visitor per client.
/// Separate from ClientComment (discussion): rating is required, @@unique enforces
/// one review per author, feeds AggregateRating + Review[] JSON-LD on the client page.
/// A visitor's review OF a client. `reviewer` is a `User` (a signed-in visitor) — it is NOT
/// the `Author` model, which is the person who writes articles. The field used to be called
/// `author`, which read as if a Client had an Author relation; it never did (renamed
/// 2026-07-30). `@map("authorId")` keeps the stored MongoDB field name, so this rename is
/// code-only: no document changes, nothing to migrate, zero production impact.
///
/// NOTE on `onDelete: Cascade` — MongoDB has no referential actions; Prisma emulates them
/// "on a best-effort basis" and only for deletes issued through Prisma Client. A user removed
/// any other way leaves an orphaned reviewerId, so every READ must tolerate a missing
/// reviewer instead of joining the required relation (see client-reviews.ts).
model ClientReview {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  clientId   String @db.ObjectId
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewerId String @map("authorId") @db.ObjectId
  reviewer   User   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  rating  Int    // 1–5 (required)
  comment String // review text

  status CommentStatus @default(PENDING) // PENDING until moderated → APPROVED feeds the page

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, reviewerId]) // one review per visitor per client (DB fields unchanged)
  @@index([clientId, status])
  @@map("client_reviews")
}

