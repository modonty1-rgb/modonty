  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Campaign identification
  campaignId   String // Unique campaign identifier
  campaignName String
  type         CampaignType

  // Relationships - track campaign performance on articles/clients
  articleId String?  @db.ObjectId
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // UTM parameters (industry standard)
  utmSource   String? // Traffic source (google, facebook, email)
  utmMedium   String? // Marketing medium (cpc, email, social)
  utmCampaign String? // Campaign name
  utmTerm     String? // Paid search keyword
  utmContent  String? // Ad variation/content

  // Performance metrics
  cost        Float? // Campaign cost
  currency    String? @default("USD")
  impressions Int? // Ad impressions
  clicks      Int? // Ad clicks
  conversions Int? // Conversions from this touchpoint

  // Attribution
  sessionId            String?
  firstVisit           Boolean @default(true) // First visit from campaign
  conversionAttributed Boolean @default(false) // Did this touchpoint lead to conversion?

  // Metadata
  referrer  String?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@unique([campaignId, sessionId]) // Prevent duplicate tracking
  @@index([campaignId, createdAt])
  @@index([utmCampaign, createdAt])
  @@index([type, createdAt])
  @@index([articleId])
  @@index([clientId])
  @@index([userId])
  @@map("campaign_tracking")
}

model LeadScoring {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  userId String? @db.ObjectId // Known user
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String? @db.ObjectId // Which client this lead is for
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Anonymous lead tracking
  sessionId String?
  email     String? // Captured email (if available)
  phone     String? // Captured phone (if available)

  // Engagement scoring (0-100)
  engagementScore Int @default(0) // Overall engagement score

  // Score components
  viewScore        Int @default(0) // Based on page views
  timeScore        Int @default(0) // Based on time spent
  interactionScore Int @default(0) // Based on likes, comments, shares
  conversionScore  Int @default(0) // Based on conversions

  // Behavior tracking
  pagesViewed    Int    @default(0)
  totalTimeSpent Float  @default(0) // Total seconds
  interactions   Int    @default(0) // Total interactions (likes, comments, shares)
  conversions    Int    @default(0)

  // Qualification
  isQualified        Boolean  @default(false) // Meets qualification threshold
  qualificationLevel String? // HOT, WARM, COLD

  // Last activity
  lastActivityAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId, engagementScore])
  @@index([isQualified, engagementScore])
  @@index([sessionId])
  @@unique([userId, clientId])
  @@unique([sessionId, clientId])
  @@map("lead_scoring")
}

model EngagementDuration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  articleId String?  @db.ObjectId
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Engagement metrics
  sessionId     String?
  timeOnPage    Float // Total seconds on page
  activeTime    Float? // Active engagement time (user actively scrolling/interacting)
  scrollDepth   Float // Percentage scrolled (0-100)
  maxScrollDepth Float // Maximum scroll depth reached

  // Reading behavior
  readingTime    Float? // Estimated reading time (content length based)
  completionRate Float? // How much of content was read (0-100)

  // Interaction timing
  firstInteractionAt DateTime? // When user first interacted (click, scroll)
  lastInteractionAt  DateTime? // Last interaction timestamp
  timeToFirstClick   Float? // Seconds until first click/interaction

  // Bounce detection
  bounced        Boolean @default(false) // Left within 30 seconds
  engagedSession Boolean @default(false) // Spent > 2 minutes or scrolled > 75%

  // Metadata
  pageLoadTime Float? // Page load performance
  referrer     String?

  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([clientId, createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([bounced, timeOnPage])
  @@map("engagement_duration")
}

model ArticleLinkClick {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  articleId String  @db.ObjectId
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Link details
  linkUrl    String // The URL that was clicked
  linkText   String? // Anchor text of the link
  linkType   LinkType // INTERNAL, EXTERNAL, AFFILIATE, CITATION, SOCIAL
  isExternal Boolean @default(true) // Whether link goes to external domain

  // Context
  linkPosition   Int? // Position of link in article (0-indexed)
  sectionContext String? // Which section/paragraph the link is in
  linkDomain     String? // Extracted domain for grouping (e.g., "example.com")

  // Engagement context
  sessionId   String?
  timeOnPage  Float? // Seconds on page before clicking link
  scrollDepth Float? // Scroll depth when link was clicked (0-100%)

  // Campaign/Attribution
  campaignId  String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  // Metadata
  userAgent String?
  referrer  String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([linkUrl, createdAt])
  @@index([linkType, createdAt])
  @@index([linkDomain, createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([isExternal])
  @@map("article_link_clicks")
}

// ============================================
// SETTINGS MODEL (Singleton Pattern)
// ============================================

model Settings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Singleton lock — guarantees only ONE Settings doc ever exists.
  // All callers MUST use upsert({where: {singletonKey: "global"}}) — never findFirst+create.
  singletonKey String @unique @default("global")

  // Cascade progress tracking (T1.8 — UI feedback for Save & Publish)
  cascadeStatus      String?   // "running" | "done" | "error" | null = idle
  cascadeProgress    Json?     // { total, completed, phase: "articles"|"clients"|"categories"|"tags"|"industries"|"listings" }
  cascadeStartedAt   DateTime?
  cascadeCompletedAt DateTime?
  cascadeError       String?

  // SEO Title Settings
  seoTitleMin      Int     @default(30)
  seoTitleMax      Int     @default(60)
  seoTitleRestrict Boolean @default(false) // false = allow max (warn), true = restrict (block)

  // SEO Description Settings
  seoDescriptionMin      Int     @default(120)
  seoDescriptionMax      Int     @default(160)
  seoDescriptionRestrict Boolean @default(false) // false = allow max (warn), true = restrict (block)

  // Twitter Title Settings
  twitterTitleMax      Int     @default(70)
  twitterTitleRestrict Boolean @default(true) // true = hard limit (Twitter display limit)

  // Twitter Description Settings
  twitterDescriptionMax      Int     @default(200)
  twitterDescriptionRestrict Boolean @default(true) // true = hard limit (Twitter display limit)

  // OG Title Settings
  ogTitleMax      Int     @default(60)
  ogTitleRestrict Boolean @default(false)

  // OG Description Settings
  ogDescriptionMax      Int     @default(200)
  ogDescriptionRestrict Boolean @default(false)

  // Social Media Links (Platform-wide)
  facebookUrl  String?
  twitterUrl   String?
  linkedInUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  tiktokUrl    String?
  pinterestUrl String?
  snapchatUrl  String?
  whatsappChannelUrl String? // Modonty WhatsApp Channel link
  telegramChannelUrl String? // Modonty Telegram Channel link
  googleBusinessProfileUrl String? // Modonty/JBR Google Business Profile (Maps) URL — feeds Organization sameAs; team pastes it after creating + verifying the profile

  // Content-responsibility disclaimer (admin-edited central text; clients accept it in console)
  disclaimerText    String? @db.String // full acknowledgement text shown to clients
  disclaimerVersion Int     @default(1) // bump when text changes → clients re-prompted

  // Telegram — admin activity feed. When true, ALL client Telegram events are
  // mirrored to TELEGRAM_ADMIN_CHAT_ID (full site-activity firehose for the admin).
  telegramAdminMirrorAll Boolean @default(true)

  // Site & Organization (from .env defaults, editable in Settings UI)
  siteUrl             String?
  siteName            String?
  brandDescription    String?
  siteAuthor          String?
  inLanguage            String?  // Default language code (e.g., "ar", "en") for hreflang
  defaultMetaRobots     String?  // Default meta robots (e.g. "index, follow")
  defaultGooglebot      String?  // Default meta googlebot (e.g. "index, follow")
  defaultOgType         String?  // Default og:type (e.g. "website")
  defaultOgLocale       String?  // Default og:locale (e.g. "ar_SA")
  defaultOgDeterminer   String?  // Default og:determiner (e.g. "auto")
  defaultTwitterCard    String?  // Default twitter:card (e.g. "summary_large_image")
  defaultSitemapPriority Float?  // Default sitemap priority (0.5)
  defaultSitemapChangeFreq String? // Default sitemap changefreq (e.g. "monthly")
  articleDefaultSitemapChangeFreq String? // Default sitemap changefreq for articles (e.g. "weekly")
  articleDefaultSitemapPriority  Float?  // Default sitemap priority for articles (e.g. 0.5)
  defaultLicense                 String? // Default license URL for articles (e.g. CC-BY)
  // Image licensing defaults (schema.org ImageObject → Google Licensable badge).
  // Used for Modonty-PRODUCED images (HERO/POST/OGIMAGE/TWITTER_IMAGE/CLIENT_MINI/GENERAL);
  // LOGO/GALLERY are attributed to the owning client at generation time instead.
  imageOwnerName             String? // creator/creditText/copyrightHolder name (e.g. "مدوّنتي")
  imageLicenseUrl            String? // URL to a page describing the licence (e.g. "/legal/copyright-policy")
  imageAcquireLicensePageUrl String? // URL where users can acquire a licence / contact
  defaultIsAccessibleForFree     Boolean  @default(true) // Default for articles: free to access (structured data)
  defaultAlternateLanguages     Json?    // Default for articles: array of {hreflang, url} for hreflang
  defaultContentFormat         String?  // Default for articles: "markdown" | "html" | "rich_text"
  defaultCharset         String?  // Meta charset (e.g. "UTF-8")
  defaultOgImageType     String?  // og:image type (e.g. "image/jpeg")
  defaultOgImageWidth    Int?     // og:image width (e.g. 1200)
  defaultOgImageHeight   Int?     // og:image height (e.g. 630)
  defaultHreflang        String?  // hreflang default (e.g. "x-default")
  defaultPathname        String?  // URL pathname fallback (e.g. "/")
  defaultTruncationSuffix String? // Suffix when truncating title/description (e.g. "...")
  defaultReferrerPolicy  String?  // Referrer policy (e.g. "strict-origin-when-cross-origin")
  defaultNotranslate     Boolean? // Prevent Chrome translate prompt for Arabic
  twitterSite            String?
  twitterCreator      String?
  twitterSiteId       String?
  twitterCreatorId    String?
  orgContactType             String?
  orgContactEmail            String?
  orgContactTelephone        String?
  orgContactAvailableLanguage String?  // ContactPoint.availableLanguage (e.g. "ar"); falls back to inLanguage
  orgContactOption           String?   // ContactPoint.contactOption (e.g. toll-free)
  orgContactHoursAvailable   String?   // ContactPoint.hoursAvailable (e.g. "Mo-Fr 09:00-17:00")
  orgAreaServed              String?
  orgStreetAddress    String?
  orgAddressLocality  String?
  orgAddressRegion    String?
  orgAddressCountry   String?
  orgPostalCode       String?
  orgGeoLatitude      Float?
  orgGeoLongitude     Float?
  orgSearchUrlTemplate String?

  // Media Settings (Cloudinary URLs)
  logoUrl     String? // Wide wordmark logo — desktop navbar
  logoIconUrl String? // Small icon/mark logo — mobile navbar (falls back to logoUrl if empty)
  ogImageUrl  String?
  altImage    String?  // Default alt text for logo/OG image when none set
  certificateImageUrl String? // CR certificate shown on /trust — picked from the Modonty library; static /public file stays as fallback

  // Modonty app defaults (fallback when page has no SEO title/description)
  modontySeoTitle       String?
  modontySeoDescription  String?

  // List pages defaults (fallback when generating meta/JSON-LD)
  clientsSeoTitle       String?
  clientsSeoDescription String?
  categoriesSeoTitle    String?
  categoriesSeoDescription String?
  trendingSeoTitle      String?
  trendingSeoDescription  String?
  tagsSeoTitle          String?
  tagsSeoDescription    String?
  industriesSeoTitle    String?
  industriesSeoDescription String?

  // Cached site-level JSON-LD (optional; same pattern as Client/Modonty)
  jsonLdStructuredData   String?   @db.String // Cached @graph JSON string
  jsonLdLastGenerated   DateTime?
  jsonLdValidationReport Json?     // { adobe, custom, richResults }

  // Home page meta (PRD: generate once, store, read from DB)
  homeMetaTags Json?

  // Clients list page meta + JSON-LD
  clientsPageMetaTags              Json?
  clientsPageJsonLdStructuredData  String?   @db.String
  clientsPageJsonLdLastGenerated   DateTime?
  clientsPageJsonLdValidationReport Json?

  // Categories list page meta + JSON-LD
  categoriesPageMetaTags              Json?
  categoriesPageJsonLdStructuredData  String?   @db.String
  categoriesPageJsonLdLastGenerated   DateTime?
  categoriesPageJsonLdValidationReport Json?

  // Trending list page meta + JSON-LD
  trendingPageMetaTags              Json?
  trendingPageJsonLdStructuredData  String?   @db.String
  trendingPageJsonLdLastGenerated   DateTime?
  trendingPageJsonLdValidationReport Json?

  // Tags list page meta + JSON-LD
  tagsPageMetaTags              Json?
  tagsPageJsonLdStructuredData  String?   @db.String
  tagsPageJsonLdLastGenerated   DateTime?
  tagsPageJsonLdValidationReport Json?

  // Industries list page meta + JSON-LD
  industriesPageMetaTags              Json?
  industriesPageJsonLdStructuredData  String?   @db.String
  industriesPageJsonLdLastGenerated   DateTime?
  industriesPageJsonLdValidationReport Json?

  // Articles list page meta + JSON-LD

  // FAQ page meta + JSON-LD
  faqPageMetaTags              Json?
  faqPageJsonLdStructuredData  String?   @db.String
  faqPageJsonLdLastGenerated   DateTime?
  faqPageJsonLdValidationReport Json?
  faqSeoTitle                  String?
  faqSeoDescription            String?

  // Clients page — Hero B2B panel (CP-1 / JBRSEO-ADMIN-1)
  b2bLabel    String?  // e.g. "لأصحاب الأعمال والشركات"
  b2bHeadline String?  // e.g. "عملاؤك يبحثون عنك على جوجل"
  b2bBullet1  String?
  b2bBullet2  String?
  b2bBullet3  String?
  b2bCtaText  String?  // e.g. "عملاء بلا إعلانات"
  b2bCtaUrl   String?  // e.g. "https://www.jbrseo.com"

  // Homepage feed banner (JBRSEO-ADMIN-2)
  platformTagline     String?  // e.g. "مرحباً بك في مودونتي"
  platformDescription String?  // e.g. "منصة المحتوى العربي — اكتشف مقالات..."

  // Per-listing-page hero image (visible hero background + og:image). Empty → falls back
  // to the global ogImageUrl. Cloudinary URL + alt, mirroring ogImageUrl/altImage.
  categoriesPageImage    String?
  categoriesPageImageAlt String?
  tagsPageImage          String?
  tagsPageImageAlt       String?
  industriesPageImage    String?
  industriesPageImageAlt String?

  // Modonty Core (T2, 2026-07-31): the Client row that IS the platform itself.
  // One key answers "is this Modonty?" everywhere — media ownership, picker scoping,
  // partner-list exclusion, featured article cards. Set from /settings/system, never a script.
  coreClientId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================
// MODONTY PAGE MODELS
// ============================================

model Modonty {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  // Page identification
  slug String @unique // e.g., "about", "terms", "privacy-policy"
  title String // Page title
  
  // Content (TipTap HTML format)
  content String // Rich text content from TipTap editor
  
  // Hero Image (for page display)
  heroImage                String? // Cloudinary URL
  heroImageAlt             String? // Alt text
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  heroImageMediaId String? @db.ObjectId
  heroImageMedia   Media?  @relation("ModontyHeroImageMedia", fields: [heroImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  heroImageCloudinaryPublicId String? // Cloudinary public_id for direct deletion
  
  // ============================================
  // SEO FIELDS (Following codebase pattern)
  // ============================================
  
  // Basic SEO (Category/Tag/Industry/Author pattern)
  seoTitle       String?
  seoDescription String? // 155-160 chars optimal
  metaRobots     String? // index, noindex, follow, nofollow
  
  // Social Images (Category/Tag/Industry pattern)
  socialImage        String? // Cloudinary URL (w_1200,h_630,c_fill,q_auto,f_auto)
  socialImageAlt     String? // Alt text
  // Modonty Core (T2): additive Media relation — the raw string stays (dual-field, zero-loss)
  socialImageMediaId String? @db.ObjectId
  socialImageMedia   Media?  @relation("ModontySocialImageMedia", fields: [socialImageMediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cloudinaryPublicId String? // Cloudinary public_id for direct deletion
  
  // Open Graph (Article pattern)
  ogTitle       String?
  ogDescription String?
  ogType        String?   @default("website")
  ogUrl         String?
  ogSiteName    String?
  ogLocale      String?
  ogImage       String? // Open Graph image URL
  
  // Twitter Cards (Client/Article pattern)
  twitterCard        String? // summary_large_image, summary
  twitterTitle       String?
  twitterDescription String?
  twitterSite        String? // @username
  twitterCreator     String?
  
  // Technical SEO
  canonicalUrl       String?
  alternateLanguages Json? // Array of {hreflang, url} objects
  sitemapPriority    Float?  @default(0.5) // 0.0 to 1.0
  sitemapChangeFreq  String? @default("monthly") // always, hourly, daily, weekly, monthly, yearly, never
  
  // Language
  inLanguage String @default("ar") // For hreflang
  
  // Cached SEO (meta tags + JSON-LD, generated on save)
  metaTags              Json?    // Client-shaped meta object
  jsonLdStructuredData  String?  // WebPage @graph JSON-LD string
  jsonLdLastGenerated   DateTime?
  jsonLdValidationReport Json?   // { adobe, ajv, custom }
  
  // ============================================
  // METADATA
  // ============================================
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastModifiedBy String?  @db.ObjectId // User ID who last edited
  
  @@map("modonty")
}

// ============================================
// CONTACT MODELS
// ============================================

model ContactMessage {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Contact information
  name    String
  email   String
  subject String
  message String

  // Status tracking
  status String @default("new") // new, read, replied, archived

  // Optional client association (if contact form is client-specific)
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Optional user (when contact form submitted by logged-in modonty user)
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Reply from client (console)
  replyBody String?

  // Metadata
  ipAddress String?
  userAgent String?
  referrer  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  readAt    DateTime? // When message was read
  repliedAt DateTime? // When reply was sent

  @@index([email])
  @@index([status])
  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
  @@map("contact_messages")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // Recipient is EITHER a reader (userId) OR a staff member (staffId). Readers
  // keep userId; staff notifications (e.g. booking alerts) use staffId so they
  // survive after staff are moved out of the users collection.
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId   String?  @db.ObjectId
  staff     Staff?   @relation("StaffNotifications", fields: [staffId], references: [id], onDelete: Cascade)
  clientId  String?  @db.ObjectId
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type      String   // e.g. "contact_reply"
  title     String
  body      String
  readAt    DateTime?
  relatedId String?  @db.ObjectId // e.g. ContactMessage id
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([staffId])
  @@index([clientId])
  @@index([readAt])
  @@map("notifications")
}

// ============================================
// FAQ MODELS
// ============================================

model FAQ {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Basic content
  question String // The question text
  answer   String // The answer text (can be HTML/rich text)
  position Int    @default(0) // For ordering
  isActive Boolean @default(true) // To show/hide FAQs

  // SEO Fields (following Schema.org FAQPage best practices)
  seoTitle       String? // SEO-optimized title for the question (for meta tags, 50-60 chars optimal)
  seoDescription String? // SEO description/preview text (155-160 chars optimal)
  lastReviewed   DateTime? // When this FAQ was last reviewed/updated (Schema.org lastReviewed)
  reviewedBy     String? @db.ObjectId // User ID who last reviewed (Schema.org reviewedBy)
  author         String? @db.ObjectId // Author/creator of this FAQ (Schema.org author - Person/Organization)
  upvoteCount    Int? @default(0) // Community upvotes (Schema.org upvoteCount)
  downvoteCount  Int? @default(0) // Track "not helpful" feedback
  answerCount    Int? // Number of alternative answers (if multiple answers supported)
  dateCreated    DateTime? // Original creation date (Schema.org dateCreated)
  datePublished  DateTime? // Publication date (Schema.org datePublished)
  inLanguage     String  @default("ar") // Language code (for hreflang)

  // Structured Data Enhancement
  speakable Json? // Speakable content for voice search (Schema.org SpeakableSpecification)
  // Format: { "@type": "SpeakableSpecification", "cssSelector": ["#question-1", "#answer-1"] }
  mainEntity Json? // Additional structured data context

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.ObjectId // User who created
  updatedBy String?  @db.ObjectId // User who last updated

  // Relations
  feedbacks FAQFeedback[]

  @@index([position])
  @@index([isActive, position])
  @@index([lastReviewed])
  @@index([upvoteCount])
  @@index([downvoteCount])
  @@map("general_faqs")
}

model FAQFeedback {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships
  faqId String @db.ObjectId
  faq   FAQ    @relation(fields: [faqId], references: [id], onDelete: Cascade)

  // User/Session tracking
  userId    String? @db.ObjectId // User ID if logged in
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?  // Browser session ID for anonymous users

  // Feedback data
  isHelpful Boolean // true = helpful, false = not helpful

  // Metadata
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@unique([faqId, sessionId]) // Prevent duplicate feedback from same session
  @@unique([faqId, userId])    // Prevent duplicate feedback from same user
  @@index([faqId, createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([isHelpful])
  @@map("faq_feedback")
}

// ============================================
// CHANGELOG & ADMIN NOTES
// ============================================

model Changelog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  version   String
  title     String
  items     Json     // [{type: "fix"|"feature"|"improve", text: "..."}]
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("changelogs")
}

model AdminNote {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  author       String
  type         String?          // "bug" | "idea" | "other"
  app          String?          // "modonty" | "console" | "admin" | "general"
  whereExactly String?          // human description: "Article edit page", "Comments list", etc.
  message      String           // what happened / the idea / the comment
  steps        String?          // bug-only: reproduction steps
  severity     String?          // bug-only: "critical" | "bug" | "minor"
  benefit      String?          // idea-only: why it would help
  page         String?          // auto-captured URL pathname (technical reference)
  replies      AdminNoteReply[]
  createdAt    DateTime         @default(now())

  @@index([createdAt])
  @@map("admin_notes")
}

model AdminNoteReply {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  noteId    String    @db.ObjectId
  note      AdminNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author    String
  message   String
  createdAt DateTime  @default(now())

  @@index([noteId, createdAt])
  @@map("admin_note_replies")
}

model SlugChangeOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String   @db.ObjectId
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId, expiresAt])
  @@map("slug_change_otps")
}

model ArticleSlugOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  articleId String   @db.ObjectId
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([articleId, expiresAt])
  @@map("article_slug_otps")
}

model SystemError {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  digest     String?
  path       String
  method     String
  routePath  String
  routeType  String
  source     String
  // Tracing enrichment (Khalid 2026-07-22) — turns the log from noise into triage.
  category   String?  // "framework" (Next/React internals, not our bug) | "app" (ours)
  renderType String?  // Next context.renderType: "dynamic" | "dynamic-resume" (PPR resume)
  device     String?  // "mobile" | "tablet" | "desktop" | "bot"
  botName    String?  // e.g. "Googlebot" when the UA is a known crawler
  country    String?  // Vercel geo (x-vercel-ip-country)
  city       String?  // Vercel geo (x-vercel-ip-city)
  userAgent  String?  // raw UA — the ground truth for tracing
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@map("system_errors")
}

/// Who did what, and when — the answer to "مين عمل ده؟" (Khalid 2026-07-14: more than
/// one person now works in the admin, and until today every action was anonymous).
///
/// Written by `logAction()` after an action SUCCEEDS. Append-only: rows are never edited.
///
/// Identity is stored twice on purpose:
///   · userId    — the real key. Never changes, survives a rename, and is what you filter by.
///   · userEmail — a SNAPSHOT of who they were at that moment. It answers "who?" without a
///                 second query, and it still answers it after the person leaves and their
///                 account is deleted. A log that outlives its subject is the whole point.
///
/// A password is NEVER stored here. It is bcrypt-hashed (we cannot read it), logging it
/// would hand every account to anyone who opens this table, and it says nothing about who
/// acted — userId already does. That is not a preference; it is the rule.
model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Who — both, for the reasons above.
  userId    String  @db.ObjectId
  userEmail String
  userName  String? // Snapshot too — nice to read, but email is the one that must be there.
  userRole  String? // ADMIN · EDITOR — their role AT THE TIME, not today's.

  // What — a stable dotted key: "article.publish" · "client.delete" · "settings.update".
  action String

  // On what — entity is always set; entityId is null for global actions (settings, cascade).
  entity   String // Article · Client · Category · Tag · Settings · Database …
  entityId String? @db.ObjectId

  /// Human-readable line for the log screen: "نشر: أفضل واكس شعر للرجال".
  /// A snapshot as well — the title at the time, so a later rename cannot rewrite history.
  summary String?

  /// Anything worth keeping that has no column: { from: "DRAFT", to: "PUBLISHED" }.
  /// Never put personal data or secrets in here.
  metadata Json?

  createdAt DateTime @default(now())

  // The three ways this table gets read: newest-first, per person, per entity.
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
  @@map("audit_logs")
}

// Cache table for Google Search Console URL Inspection results.
// Avoids hitting the 2,000/day API quota — refresh on demand or every 7 days.
model GscUrlInspection {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  url             String   @unique
  verdict         String? // PASS · FAIL · NEUTRAL · PARTIAL
  coverageState   String? // e.g. "Submitted and indexed"
  robotsTxtState  String? // ALLOWED · DISALLOWED
  indexingState   String? // INDEXING_ALLOWED · BLOCKED_BY_META_TAG · etc.
  pageFetchState  String? // SUCCESSFUL · SOFT_404 · BLOCKED_ROBOTS_TXT · etc.
  userCanonical   String? // canonical declared by us
  googleCanonical String? // canonical chosen by Google
  mobileVerdict   String? // PASS · FAIL · NEUTRAL
  mobileIssues    String[] // list of issue types
  lastCrawlTime   DateTime?
  crawledAs       String? // DESKTOP · MOBILE
  sitemap         String[] // sitemap URLs that include this URL
  rawJson         Json?
  inspectedAt     DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
  @@index([verdict])
  @@map("gsc_url_inspections")
}

/// Tracks manual GSC requests (Removal tool + URL Inspection "Request Indexing").
/// Two-step state:
/// `openedAt` = user clicked the deep-link button (intent only — Google may not have received it).
/// `doneAt`   = user explicitly clicked "Mark done" after submitting in GSC (confirmed action).
/// One row per (url, type) — same URL can have both REMOVAL and INDEXING requests at different times.
model GscManualRequest {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  url            String
  type           String    @default("REMOVAL") // "REMOVAL" | "INDEXING"
  openedAt       DateTime  @default(now())
  openedByUserId String?
  doneAt         DateTime?
  doneByUserId   String?

  @@unique([url, type])
  @@index([type, doneAt])
  @@map("gsc_removal_requests")
}

// ============================================
// BILLING — Invoices issued from the Accounts page
// ============================================
model Invoice {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  number            String           @unique // human invoice number e.g. MOD-2026-00042
  clientId          String           @db.ObjectId
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tier              SubscriptionTier
  tierName          String // display-name snapshot at issue time (e.g. "الزخم")
  period            String // "monthly" | "annual"
  currency          String // "SAR" | "EGP"
  amount            Float
  paymentMethod     String? // deprecated — kept for old rows; not captured on new invoices
  paymentStatus     String // "PAID" | "DUE"
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  issuedAt          DateTime         @default(now())
  issuedByUserId    String?          @db.ObjectId
  emailSentAt       DateTime?
  paidAt            DateTime? // settlement date entered by admin at «تحديد مدفوعة»
  paidByUserId      String?          @db.ObjectId
  // Voiding an invoice, never deleting it — the ledger has to stay whole for accounting.
  // Only an UNPAID invoice can be archived; it then leaves every unpaid total, stops
  // blocking the next issuance, and its period stops counting toward the client's end date.
  archivedAt        DateTime?
  archivedReason    String?
  archivedByUserId  String?          @db.ObjectId
  // Marks the invoice that embodies the client's opening balance (see Client.openingBalance).
  // The founding payment is already counted in the sales report as the opening balance, so
  // an invoice generated from it MUST be excluded from report revenue — it is a document,
  // not new money. Default false = a normal renewal invoice that DOES count.
  fromOpeningBalance Boolean         @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clientId, issuedAt])
  @@map("invoices")
}

/// Atomic sequential counters (e.g. gapless invoice numbering per year).
model Counter {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique // e.g. "invoice-2026"
  value Int    @default(0)

  @@map("counters")
}

// ============================================
// INTAKE ENGINE — admin-managed questionnaire
// Questions/options live in DB (admin-editable); client answers stay in
// Client.intake JSON keyed by IntakeQuestion.key, so downstream consumers
// (pre-publish audit, JSON-LD, admin brief) keep reading the same shape.
// ============================================

enum IntakeQuestionType {
  SELECT // single choice, dropdown
  RADIO // single choice, visible list
  MULTI_PILL // multi-select chips
  CHECKBOX // multi-select checkboxes
  TEXT // single-line text
  TEXTAREA // multi-line text
  BOOLEAN // single toggle
  REPEATED_GROUP // repeats a set of sub-fields (e.g. competitors) — shape in `config`
  GROUP // fixed nested sub-fields (e.g. YMYL reviewer) — shape in `config`
}

/// A questionnaire definition. One row today ("intake"); the parent table lets
/// new forms (onboarding, review) be added later with zero schema change.
model IntakeForm {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  key         String          @unique // "intake"
  title       String
  description String?
  version     Int             @default(1)
  enabled     Boolean         @default(true)
  sections    IntakeSection[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("intake_forms")
}

/// A group of questions inside a form (e.g. "نبرة الكتابة", "سياسة المحتوى").
model IntakeSection {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  formId      String           @db.ObjectId
  form        IntakeForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  key         String // stable section key: "voice", "policy", ...
  title       String
  description String?
  icon        String? // lucide icon name (e.g. "Mic2")
  order       Int              @default(0)
  enabled     Boolean          @default(true)
  visibility  Json? // conditional display, e.g. { ymylOnly: true } or { market: ["SA"] }
  questions   IntakeQuestion[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([formId, key])
  @@map("intake_sections")
}

/// A single question. `key` is the STABLE semantic path the answer is stored
/// under in Client.intake (e.g. "policy.forbiddenKeywords") — never changes on
/// edit, so downstream code never breaks. Editing label/options is always safe.
model IntakeQuestion {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  sectionId   String             @db.ObjectId
  section     IntakeSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key         String // stable answer path, e.g. "policy.forbiddenKeywords"
  label       String
  helpText    String?
  placeholder String?
  type        IntakeQuestionType
  required    Boolean            @default(false)
  maxLength   Int?
  order       Int                @default(0)
  enabled     Boolean            @default(true)
  visibility  Json? // per-question conditional + market scope
  config      Json? // type-specific shape (e.g. REPEATED_GROUP/GROUP sub-fields)
  options     IntakeOption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([sectionId, key])
  @@map("intake_questions")
}

/// A predefined choice for SELECT/RADIO/MULTI_PILL/CHECKBOX questions.
model IntakeOption {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  questionId  String         @db.ObjectId
  question    IntakeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value       String // stored value
  label       String // shown label
  order       Int            @default(0)
  enabled     Boolean        @default(true)
  marketScope String? // "SA" | "EG" | null (all markets)

  @@map("intake_options")
}

// ============================================
// REFERENCE DATA — admin-managed foundational lookups
// (Settings → Reference Data). Countries drive the client country picker;
// licensing authorities power YMYL verification. Read by console + SEO,
// written by admin. Replaces the hardcoded matrix in ymyl-config.ts.
// ============================================

/// Fixed YMYL category set. Mirrors Client.ymylCategory string values
/// ("medical" | "legal" | "financial"). Kept an enum here to enforce a valid
/// category on every authority row.
enum YmylCategory {
  medical
  legal
  financial
}

/// A supported country. `code` (ISO 3166-1 alpha-2) is the value stored on
/// Client.addressCountry and used to resolve licensing authorities.
model Country {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  code      String  @unique // ISO 3166-1 alpha-2: SA, EG, AE
  nameAr    String
  nameEn    String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

// REMOVED 2026-07-30 (Khalid): the whole social-publishing feature is gone — the
// /social admin pages, `lib/social/{meta,twitter}.ts`, and the auto-post on first
// publish. `SocialPost` + `SocialPlatform` + `SocialPostStatus` were only ever used
// by that code, so the model went with it.
//
// The `social_posts` MongoDB collection is NOT dropped — Prisma simply stops
// mapping it. Old rows stay readable via mongosh if the history is ever needed;
// drop the collection manually (after a backup) once it is confirmed unwanted.

/// A licensing/regulatory body a YMYL client picks during verification.
/// Linked to a country by ISO `countryCode` (no relation — resolved in queries).
model LicensingAuthority {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  countryCode String // → Country.code (ISO 3166-1 alpha-2)
  category    YmylCategory
  code        String // short identifier shown alongside the name (MOH, SCFHS, CMA…)
  nameAr      String
  nameEn      String
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode, category, code])
  @@index([countryCode, category])
  @@map("licensing_authorities")
}

// Named CTA presets the admin adds WITHOUT a code change (Khalid 2026-07-24).
// A preset is not a new behaviour — picking one fills the three fields that already
// exist on Client (ctaMode / ctaLabel / ctaUrl), so every surface that renders a CTA
// and every segment that counts one keeps working untouched. The two real behaviours
// stay in code and cannot be added from a screen:
//   FORM → internal booking sheet — the lead lands in OUR database
//   LINK → tracked external anchor (https · wa.me · tel:) — we only see the click
// «Unlimited CTAs» therefore means unlimited label + behaviour + destination combos,
// which already covers booking, store, WhatsApp and phone.
// The button text IS the identity here (Khalid 2026-07-24: «أنت بتتكلم مع إنسان»).
// There is deliberately no admin-facing slug — the machine identifier is `id`, and the
// human identifier is what the visitor reads. Uniqueness is enforced on `labelKey`, the
// NORMALISED text: Arabic makes «تسوق» and «تسوّق» two different strings that render
// almost identically, so comparing the raw text would guard nothing. `labelAr` keeps
// exactly what was typed — the normalisation exists only to answer «is this the same
// button?».
model CtaPreset {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  labelAr    String // the Arabic text the visitor actually reads on the button
  labelKey   String        @unique // derived from labelAr: no diacritics, unified alef/yaa, collapsed spaces
  mode       ClientCtaMode // FORM | LINK — NONE is «no button», never a preset
  defaultUrl String? // LINK only: prefilled destination (https · wa.me · tel:)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("cta_presets")
}

// ============================================
// REELS — merged into Media (locked 2026-08-05)
//
// The `Reel` table is gone. A media file IS the reel: the row that holds the image
// or the video carries the reel state itself. What this removes is the copy — two
// rows holding the same URL, kept in sync by hand in two admin actions, where every
// bug in this feature came from.
//
// `Media.type` keeps its old meaning (the file's ROLE) and is NOT touched: 15 queries
// read it and 6 write it. Reel membership rides on top as its own switch instead.
//
// There is no `ReelType` any more — image vs video is already in `mimeType`.
// Study: documents/reels/REELS-ARCHITECTURE-STUDY-v1.html
// ============================================

/// How loud a note to the content team is allowed to be.
///
/// Three levels, deliberately — not two, not five. Two cannot separate "read this" from
/// "work is blocked"; five or more collapse in practice into "urgent" and "ignored",
/// because every sender believes their own note is urgent. Three forces a real choice.
enum NotificationPriority {
  NORMAL /// للعلم — نفّذها لما توصلها
  IMPORTANT /// تحتاج تحرّكاً هذا الأسبوع
  URGENT /// شغل واقف — اليوم
}


/// A note the operations manager sent to the content team's Telegram about one client.
///
/// The row is the record, the Telegram message is just its delivery. Which is why
/// `delivered` and `error` are stored: a log that says "sent" while Telegram was down is
/// worse than no log at all — somebody would rely on it.
///
/// Identity is stored twice on purpose, exactly like [AuditLog]: `sentById` is the key
/// that never changes, and the name/email are a SNAPSHOT of who that person was at that
/// moment — so the history still answers "who told us?" after they leave and their staff
/// record is gone.
model ClientNotification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  message  String
  priority NotificationPriority @default(NORMAL)

  /// Who the note is FOR. EMPTY means everyone in the content group.
  ///
  /// One Telegram group holds the whole team, so the only thing that tells a person a note
  /// is theirs is seeing their name on it. Ids are kept for filtering later; names are
  /// SNAPSHOTTED for the same reason `sentByName` is — a note has to keep saying who it was
  /// addressed to after that person leaves and their staff row is gone.
  recipientIds   String[] @db.ObjectId
  recipientNames String[]

  // Who sent it — the signed-in staff member, never a value the browser supplies.
  sentById    String  @db.ObjectId
  sentByName  String
  sentByEmail String

  // Outcome of the actual Telegram call.
  delivered Boolean
  error     String?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("client_notifications")
}

enum ReelStatus {
  DRAFT
  PENDING_APPROVAL // client upload awaiting admin approval
  APPROVED // approved, not yet live in the feed
  PUBLISHED // live on the public feed + standalone watch page
  REJECTED
  ARCHIVED
}

enum ReelUploader {
  ADMIN
  CLIENT
}

enum ReelTranscriptStatus {
  PENDING // auto transcription runs after approval (Arabic — language pinned manually)
  DONE
  FAILED
  SKIPPED // images / transcription not applicable
}

/// Reaction kinds on a media file. One row per (file, actor, kind).
///
/// `FAVORITE` needs a signed-in user, `LIKE` allows an anonymous visitor. The old
/// two-table split expressed that rule in the database; one table with a nullable
/// `userId` cannot — so the guard moved into the server action that writes the row.
enum MediaReactionKind {
  LIKE
  FAVORITE
}

/// Comments on a media file — same shape as article comments (nesting + moderation).
model MediaComment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  content String

  mediaId String @db.ObjectId
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  parentId String?       @db.ObjectId
  parent   MediaComment? @relation("MediaCommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  replies MediaComment[] @relation("MediaCommentReplies")

  status   CommentStatus @default(PENDING)
  isEdited Boolean       @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  reactions CommentReaction[]

  @@index([mediaId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
  @@map("media_comments")
}

/// A visitor's like or favorite ON THE FILE.
///
/// Two uniqueness rules, not one: a signed-in visitor is identified by `userId`, an
/// anonymous one by `sessionId`. Drop either and the same person can react without
/// limit through the other path.
model MediaReaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  mediaId String @db.ObjectId
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  kind MediaReactionKind

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // anonymous visitors

  createdAt DateTime @default(now())

  @@unique([mediaId, kind, userId])
  @@unique([mediaId, kind, sessionId])
  @@index([mediaId, kind])
  @@index([userId])
  @@map("media_reactions")
}

/// A like or dislike ON A COMMENT — a separate table on purpose.
///
/// It cannot live inside `MediaReaction`: that row points at a file, this one points
/// at a comment. Merging them would force a row that references two different things
/// with one of the two columns always empty.
model CommentReaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  commentId String       @db.ObjectId
  comment   MediaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  isLike Boolean // true = like · false = dislike

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String? // anonymous visitors

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@unique([commentId, sessionId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_reactions")
}

/// One row per backup attempt — success or failure.
///
/// Exists because both earlier backup paths failed silently: the manual script copied
/// modonty_dev while everyone read it as production, and the scheduled .bat never ran
/// once (zero output folders on disk, undetected for months). A backup system without
/// a record of its own runs cannot tell you it has stopped.
///
/// `dbName` is stored and displayed deliberately — it is the single field that would
/// have exposed the original trap at a glance.
/// Decisions: documents/tasks/BACKUP-STRATEGY-v1.html (ق5)
model BackupRun {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  source BackupSource // who produced it — the daily cron, Khalid's machine, or Atlas
  dbName String // "modonty" | "modonty_dev" — shown in the UI, never inferred
  status BackupStatus @default(RUNNING)

  collections Int? // collections written
  documents   Int? // total documents across all collections
  sizeBytes   Int? // compressed size actually stored
  bunnyPath   String? // folder on the private zone, e.g. daily/2026-08-04

  errorText String? // failing collection + message when status = FAILED

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([status, startedAt])
  @@index([source, startedAt])
  @@map("backup_runs")
}

enum BackupSource {
  VERCEL_CRON // daily, the guaranteed layer
  LOCAL_DUMP // mongodump on Khalid's machine — opportunistic, BSON format
  RESTORE_TEST // monthly restore drill, not a backup itself
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ═══════════════════════════════════════════════════════════════════
// جبر سيو — إدارة المحتوى
//
// الجدولان أنشأهما موقع jbrseo.com وهما موجودان في هذه القاعدة نفسها
// (متحقَّق ٨ أغسطس: jbrseo.com/.env.local:1 و dataLayer/.env:4 كلاهما
// يشير إلى modonty_dev على العنقود ذاته). ما يلي وصفٌ لهما لا إنشاء —
// الـ@@map يشير إلى المجموعتين القائمتين، فالأدمن يحرّر نفس الصفوف
// التي يحرّرها أدمن جبر سيو. صفر ترحيل · صفر نسخ · صفر اتصال ثانٍ.
//
// ⚠️ النموذجان مرآة لـ jbrseo.com/prisma/schema.prisma — أي تغيير حقل
//    يُطبَّق في المكانين (نفس قاعدة الصيانة في قرار JBR8).
//
// ⛔ خارج النطاق عمداً: Plan و PriceSectionMeta — الأسعار تبقى بيد خالد
//    من أدمن جبر سيو، ولا يحرّرها طارق (قرار JBR11).
// ═══════════════════════════════════════════════════════════════════

model JbrSiteSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  gtmId          String   @default("")
  whatsappNumber String   @default("")
  updatedAt      DateTime @default(now())

  @@map("SiteSettings")
}

model JbrLandingSection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  @@map("LandingSection")
}
