/// CTA (call-to-action) click tracking: one row per button/link click for CTR and which CTAs perform best.
model CTAClick {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Relationships — from page context or API when recording the click
  articleId String?  @db.ObjectId // Article page where CTA was clicked; from current route or payload
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  clientId String? @db.ObjectId // Client (brand) context; from page or payload
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String? @db.ObjectId // Logged-in user; from auth() when recording (null if anonymous)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // CTA details — from the clicked element or tracking payload
  type     CTAType // Enum: e.g. READ_MORE, SUBSCRIBE, CONTACT; set by frontend when sending click
  label    String? // Visible text of button/link (e.g. "اقرأ المزيد"); from element or payload
  targetUrl String? // href or destination URL; from element.getAttribute("href") or payload

  // Engagement context — calculated on client at click time
  sessionId   String? // Same cookie as view tracking (modonty_view_sid); from API via cookies()
  timeOnPage  Float?  // Seconds from page load to click: (Date.now() - pageLoadedAt) / 1000
  scrollDepth Float?  // Scroll % when clicked: (window.scrollY / (docHeight - viewportHeight)) * 100

  // Campaign tracking — from URL query params at click time (optional)
  campaignId  String? // From ?campaign_id= or payload
  utmSource   String? // From ?utm_source= or new URL(url).searchParams
  utmMedium   String? // From ?utm_medium=
  utmCampaign String? // From ?utm_campaign=

  createdAt DateTime @default(now()) // Server time when row is inserted

  @@index([articleId, createdAt])
  @@index([clientId, createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@map("cta_clicks")
}

