# ما لا يحتاجه بناء الجوّال.
#
# البناء الأول رفع **٢٤٤ ميجا** لأنّ EAS يرفع جذر مساحة العمل كلّها ما لم يُستثنَ شيء —
# فيذهب معها الأدمن والموقع العام والكونسول ووسائطها، وليس في أيٍّ منها سطر يدخل حزمة
# أندرويد. والرفع يُدفع ثمنه وقتاً في كل بناء، لا مرّة واحدة.
#
# القاعدة هنا: يبقى ما يقرؤه Metro أو Gradle، ويخرج ما عداه.

# تطبيقات الويب الثلاثة — لا يدخل منها شيء في حزمة الجوّال.
admin/
modonty/
console/
dataLayer/

# مخرجات بناء ومؤقّتات
**/.next/
**/dist/
**/build/
**/.turbo/
**/coverage/
**/*.tsbuildinfo

# أدلّة وأدوات جلسة — تُقرأ بالعين لا بالبناء
**/documentation/evidence/
**/documentation/html/
**/.playwright-mcp/
**/.agents/
console-mobile/skills-lock.json

# نسخ احتياطية يخلّفها سكربت الأيقونات
**/*.bak

# أسرار — لا ترتفع مع الأرشيف بحال
**/.env
**/.env.*
