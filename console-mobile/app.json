{
  "expo": {
    "name": "بوابة مدونتي",
    "slug": "modonty-console",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "modontyconsole",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.modonty.console",
      "adaptiveIcon": {
        "backgroundColor": "#0E065A",
        "foregroundImage": "./assets/brand/app-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/modonty-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0E065A",
          "dark": {
            "backgroundColor": "#0E065A"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "owner": "modontys-team",
    "extra": {
      "eas": {
        "projectId": "6cc8b8ea-cc0c-46e9-bb4f-56810fed5616"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/6cc8b8ea-cc0c-46e9-bb4f-56810fed5616",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
