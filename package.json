{
  "name": "@modonty/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev:admin": "pnpm --filter @modonty/admin dev",
    "dev:modonty": "pnpm --filter @modonty/modonty dev",
    "dev:console": "pnpm --filter @modonty/console dev",
    "build:admin": "pnpm --filter @modonty/admin build",
    "build:modonty": "pnpm --filter @modonty/modonty build",
    "build:console": "pnpm --filter @modonty/console build",
    "build:all": "pnpm build:admin && pnpm build:modonty && pnpm build:console",
    "lint": "pnpm --filter \"@modonty/*\" lint",
    "format": "prettier --write .",
    "prisma:generate": "pnpm --filter @modonty/shared prisma:generate",
    "prisma:push": "pnpm --filter @modonty/shared prisma:push",
    "prisma:dedupe-push": "pnpm --filter @modonty/shared dedupe-before-push && pnpm prisma:push",
    "prisma:studio": "pnpm --filter @modonty/shared prisma:studio",
    "prisma:format": "pnpm --filter @modonty/shared prisma:format",
    "prisma:validate": "pnpm --filter @modonty/shared prisma:validate",
    "seed": "pnpm --filter @modonty/shared seed",
    "seed:clear": "pnpm --filter @modonty/shared seed:clear"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "autocannon": "^8.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "prettier": "^2.8.0"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "sharp": "0.34.5"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5"
    }
  }
}
