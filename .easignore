# مطابقة .gitignore الجذري؛ EAS يبني من أرشيف المستودع الموحّد.
node_modules/
.pnp
.pnp.js

**/pnpm-lock.yaml
!pnpm-lock.yaml

.next/
out/
dist/
build/
logs/

.env
.env*.local
.env.production
.env.shared
!.env.shared.example

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.vercel/
*.tsbuildinfo
next-env.d.ts
node_modules/.prisma/
coverage/
.nyc_output/
backups/
*.pem
.playwright-mcp/
*.png
!modonty/app/apple-icon.png
!brand/favicon/*.png
!modonty/public/trust/*.png
!console-mobile/assets/**

# أدوات الوكلاء محلية؛ لا تدخل أرشيف EAS ولا تعتمد عليها حزمة الموبايل.
.agents/
.claude/

# هذا الملفّ (جذر المستودع) هو الوحيد الذي يقرؤه eas-cli؛ console-mobile/.easignore لا يُقرأ.
# بدون هذه الأسطر رُفع ~٢٫٢ جيجا (backup وحده ٢ جيجا) فتوقّف البناء عند الضغط.
# تطبيق الجوّال لا يستورد شيئاً من حزم الويب (لا @modonty/* ولا ../shared)،
# وتثبيت pnpm لـ console-mobile لا يحتاج مجلّداتها.
/backup/
/documents/
/scratch/
/payment/
/admin/
/modonty/
/console/
/shared/
/dataLayer/
/creative/
/docs/
/public/
/modonty-mobile/
/.pnpm-store/
/*.jpeg
/*.jpg
/*.svg
console-mobile/documentation/
console-mobile/.playwright-mcp/
console-mobile/skills-lock.json
**/*.bak

# نسخة git المستنسخة داخل الأرشيف = ~١٢٠ ميجا من الـ١٢٣؛ البناء لا يقرأ تاريخ git
# (runtimeVersion = appVersion، لا fingerprint). eas-cli يدعم استثناءها صراحةً (vcs/clients/git.js).
.git
