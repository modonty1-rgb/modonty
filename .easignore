# مطابقة .gitignore الجذري؛ EAS يبني من أرشيف المستودع الموحّد.
node_modules/
.pnp
.pnp.js

**/pnpm-lock.yaml
!pnpm-lock.yaml

.next/
out/
dist/
build/
logs/

.env
.env*.local
.env.production
.env.shared
!.env.shared.example

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.vercel/
*.tsbuildinfo
next-env.d.ts
node_modules/.prisma/
coverage/
.nyc_output/
backups/
*.pem
.playwright-mcp/
*.png
!modonty/app/apple-icon.png
!brand/favicon/*.png
!modonty/public/trust/*.png
!console-mobile/assets/**

# أدوات الوكلاء محلية؛ لا تدخل أرشيف EAS ولا تعتمد عليها حزمة الموبايل.
.agents/
.claude/
